+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef LIBRETRO_FIRERED_DIALOGUE_H
+#define LIBRETRO_FIRERED_DIALOGUE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum FireRedDialogueState {
+	FIRERED_DIALOGUE_BLOCKED,
+	FIRERED_DIALOGUE_PRINTING,
+	FIRERED_DIALOGUE_PAGE_WAIT,
+	FIRERED_DIALOGUE_TERMINAL_PENDING,
+	FIRERED_DIALOGUE_TERMINAL_WAIT,
+};
+
+enum FireRedDialogueProfile {
+	FIRERED_DIALOGUE_PROFILE_UNSUPPORTED,
+	FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+	FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1,
+};
+
+/* The memory pointers are borrowed and must remain valid until the next init.
+ * `profile` and `terminalStage` are internal state kept here so callers can
+ * allocate one independent detector per emulated instance without allocation. */
+struct FireRedDialogueDetector {
+	const uint8_t* ewram;
+	size_t ewramSize;
+	const uint8_t* iwram;
+	size_t iwramSize;
+	const uint8_t* rom;
+	size_t romSize;
+	enum FireRedDialogueProfile profile;
+	unsigned terminalStage;
+	enum FireRedDialogueState lastState;
+	bool sessionArmed;
+};
+
+enum FireRedDialogueProfile fireRedDialogueProfileFromSha1(
+		const uint8_t sha1[20]);
+bool fireRedDialogueProfileSupported(enum FireRedDialogueProfile profile);
+void fireRedDialogueInit(struct FireRedDialogueDetector* detector,
+		enum FireRedDialogueProfile profile,
+		const uint8_t* ewram, size_t ewramSize,
+		const uint8_t* iwram, size_t iwramSize,
+		const uint8_t* rom, size_t romSize);
+void fireRedDialogueReset(struct FireRedDialogueDetector* detector);
+enum FireRedDialogueState fireRedDialogueInspect(
+		struct FireRedDialogueDetector* detector);
+
+/* Consumes a verified terminal wait, if present, and disarms the session. This
+ * makes an injected button a one-shot and prevents it advancing the script
+ * state that follows the dialogue. */
+void fireRedDialogueConsumeTerminal(struct FireRedDialogueDetector* detector);
+
+#endif
diff --git a/src/platform/libretro/libretro_multi.c b/src/platform/libretro/libretro_multi.c
