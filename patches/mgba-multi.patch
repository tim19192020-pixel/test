+		.callback2 = 0x080565C8U,
+		.taskDraw = 0x08069384U,
+		.isHidden = 0x08069530U,
+		.waitAorB = 0x0806B8ACU,
+		.taskBattle = 0x0807F634U,
+		.choices = { 0x0809CCACU, 0x0809CE68U, 0x0809CFF0U },
+		.safeWaits = { 0x081A4EBFU, 0x081A4EC9U, 0x081A4ED2U, 0x081A509DU },
+		.stdScripts = 0x081604C8U,
+		.yesNoCommand = 0x081A4EDAU,
+		.trainerStart = 0x081A4F2CU,
+		.trainerEnd = 0x081A5097U,
+	},
+};
+
+struct Fixture {
+	uint8_t* ewram;
+	uint8_t* iwram;
+	uint8_t* rom;
+	struct FireRedDialogueDetector detector;
+	const struct TestProfile* profile;
+	uint32_t script;
+};
+
+static void write8(uint8_t* memory, uint32_t base, uint32_t address,
+		uint8_t value) {
+	memory[address - base] = value;
+}
+
+static void write32(uint8_t* memory, uint32_t base, uint32_t address,
+		uint32_t value) {
+	size_t offset = address - base;
+	memory[offset] = (uint8_t) value;
+	memory[offset + 1] = (uint8_t) (value >> 8);
+	memory[offset + 2] = (uint8_t) (value >> 16);
+	memory[offset + 3] = (uint8_t) (value >> 24);
+}
+
+static uint32_t taskAddress(unsigned task) {
+	return TASKS + task * TASK_STRIDE;
+}
+
+static void setTask(struct Fixture* fixture, unsigned task, uint32_t function,
+		bool active) {
+	write32(fixture->iwram, IWRAM_BASE, taskAddress(task), function);
+	write8(fixture->iwram, IWRAM_BASE,
+			taskAddress(task) + TASK_ACTIVE_OFFSET, active ? 1 : 0);
+}
+
+static void setOrdinary(struct Fixture* fixture, uint8_t printerState) {
+	memset(fixture->ewram, 0, EWRAM_SIZE);
+	memset(fixture->iwram, 0, IWRAM_SIZE);
+	memset(fixture->rom, 0, ROM_SIZE);
+	write32(fixture->iwram, IWRAM_BASE, MAIN_CALLBACK2,
+			fixture->profile->callback2 | 1U);
+	write8(fixture->iwram, IWRAM_BASE, MAIN_IN_BATTLE, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STATUS, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->isHidden | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, fixture->script);
+	write8(fixture->rom, ROM_BASE, fixture->script, 0x6D);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x02);
+	write8(fixture->ewram, EWRAM_BASE, MESSAGE_BOX_TYPE, 2);
+	write8(fixture->ewram, EWRAM_BASE, PRINTER_ACTIVE, 1);
+	write8(fixture->ewram, EWRAM_BASE, PRINTER_STATE, printerState);
+	setTask(fixture, 0, fixture->profile->taskDraw | 1U, true);
+	fireRedDialogueReset(&fixture->detector);
+}
+
+static void initFixture(struct Fixture* fixture,
+		const struct TestProfile* profile) {
+	memset(fixture, 0, sizeof(*fixture));
+	fixture->ewram = calloc(1, EWRAM_SIZE);
+	fixture->iwram = calloc(1, IWRAM_SIZE);
+	fixture->rom = calloc(1, ROM_SIZE);
+	assert(fixture->ewram && fixture->iwram && fixture->rom);
+	fixture->profile = profile;
+	fixture->script = profile->safeWaits[2];
+	fireRedDialogueInit(&fixture->detector, profile->id,
+			fixture->ewram, EWRAM_SIZE, fixture->iwram, IWRAM_SIZE,
+			fixture->rom, ROM_SIZE);
+	assert(fixture->detector.profile == profile->id);
+	setOrdinary(fixture, 0);
+}
+
+static void deinitFixture(struct Fixture* fixture) {
+	free(fixture->ewram);
+	free(fixture->iwram);
+	free(fixture->rom);
+}
+
+static void assertBlocked(struct Fixture* fixture) {
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_BLOCKED);
+	assert(!fixture->detector.sessionArmed);
+	assert(!fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+	fireRedDialogueConsumeTerminal(&fixture->detector);
+	assert(fixture->detector.lastState == FIRERED_DIALOGUE_BLOCKED);
+}
+
+static void assertSpeedOnly(struct Fixture* fixture) {
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	assert(fixture->detector.sessionArmed);
+	assert(!fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+}
+
+static void testHashesAndBounds(void) {
+	uint8_t* ewram = calloc(1, EWRAM_SIZE);
+	uint8_t* iwram = calloc(1, IWRAM_SIZE);
+	uint8_t* rom = calloc(1, ROM_SIZE);
+	assert(ewram && iwram && rom);
+	struct FireRedDialogueDetector detector;
+	uint8_t unsupported[20] = { 0 };
+
+	assert(fireRedDialogueProfileFromSha1(sha10) ==
+			FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0);
+	assert(fireRedDialogueProfileFromSha1(sha11) ==
+			FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1);
+	assert(fireRedDialogueProfileFromSha1(NULL) ==
+			FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	assert(fireRedDialogueProfileFromSha1(unsupported) ==
+			FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	assert(!fireRedDialogueProfileSupported(FIRERED_DIALOGUE_PROFILE_UNSUPPORTED));
+	assert(fireRedDialogueProfileSupported(FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0));
+	assert(fireRedDialogueProfileSupported(FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1));
+	assert(!fireRedDialogueProfileSupported((enum FireRedDialogueProfile) 99));
+	assert(fireRedDialogueInspect(NULL) == FIRERED_DIALOGUE_BLOCKED);
+	assert(!fireRedDialogueCanAutoAdvanceTerminal(NULL));
+	fireRedDialogueReset(NULL);
+	fireRedDialogueConsumeTerminal(NULL);
+
+	fireRedDialogueInit(NULL, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_UNSUPPORTED,
+			ewram, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			NULL, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, 1, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, EWRAM_SIZE, iwram, 1, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, 1);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+
+	free(ewram);
+	free(iwram);
+	free(rom);
+}
+
+static void testAllPrinterStates(struct Fixture* fixture) {
+	static const uint8_t printing[] = { 0, 4, 5, 6 };
+	static const uint8_t waiting[] = { 1, 2, 3 };
+	for (size_t i = 0; i < sizeof(printing); ++i) {
+		setOrdinary(fixture, printing[i]);
+		assert(fireRedDialogueInspect(&fixture->detector) ==
+				FIRERED_DIALOGUE_PRINTING);
+		assert(fixture->detector.sessionArmed);
+		assert(fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+	}
+	for (size_t i = 0; i < sizeof(waiting); ++i) {
+		setOrdinary(fixture, waiting[i]);
+		assert(fireRedDialogueInspect(&fixture->detector) ==
+				FIRERED_DIALOGUE_PAGE_WAIT);
+		assert(fixture->detector.sessionArmed);
+		assert(fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+	}
+	setOrdinary(fixture, 7);
+	assertBlocked(fixture);
+}
+
+static void testExactMsgboxWaits(struct Fixture* fixture) {
+	for (size_t i = 0;
+			i < sizeof(fixture->profile->safeWaits) /
+				sizeof(*fixture->profile->safeWaits); ++i) {
+		setOrdinary(fixture, 0);
+		write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+				fixture->profile->safeWaits[i]);
+		write8(fixture->rom, ROM_BASE, fixture->profile->safeWaits[i], 0x6D);
+		write8(fixture->rom, ROM_BASE, fixture->profile->safeWaits[i] + 1U,
+				0x02);
+		assert(fireRedDialogueInspect(&fixture->detector) ==
+				FIRERED_DIALOGUE_PRINTING);
+		assert(fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+	}
+}
+
+static void testBenignContinuations(struct Fixture* fixture) {
+	static const struct {
+		uint8_t opcode;
+		uint8_t width;
+	} benign[] = {
+		{ 0x16, 5 }, /* setvar */
+		{ 0x17, 5 }, /* addvar */
+		{ 0x18, 5 }, /* subvar */
+		{ 0x19, 5 }, /* copyvar */
+		{ 0x1A, 5 }, /* setorcopyvar */
+		{ 0x28, 3 }, /* delay */
+		{ 0x29, 3 }, /* setflag */
+		{ 0x2A, 3 }, /* clearflag */
+		{ 0x2F, 3 }, /* playse */
+		{ 0x30, 1 }, /* waitse */
+		{ 0x31, 3 }, /* playfanfare */
+		{ 0x32, 1 }, /* waitfanfare */
+		{ 0x4F, 7 }, /* applymovement */
+		{ 0x51, 3 }, /* waitmovement */
+		{ 0x69, 1 }, /* lockall */
+		{ 0x6A, 1 }, /* lock */
+	};
+	for (size_t i = 0; i < sizeof(benign) / sizeof(*benign); ++i) {
+		setOrdinary(fixture, 0);
+		write8(fixture->rom, ROM_BASE, fixture->script + 1U,
+				benign[i].opcode);
+		write8(fixture->rom, ROM_BASE,
+				fixture->script + 1U + benign[i].width, 0x02);
+		assert(fireRedDialogueInspect(&fixture->detector) ==
+				FIRERED_DIALOGUE_PRINTING);
+		assert(fixture->detector.sessionArmed);
+		assert(!fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+	}
+
+	/* The next known non-choice msgbox is a boundary. Its call is not entered
+	 * automatically, but the current active box remains eligible for speed-up. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x0F);
+	write8(fixture->rom, ROM_BASE, fixture->script + 7U, 0x09);
+	write8(fixture->rom, ROM_BASE, fixture->script + 8U, 0x04);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	assert(!fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x67);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	assert(!fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+
+	/* A choice after an otherwise benign command poisons the entire current
+	 * prompt instead of being hidden behind BENIGN_NO_TERMINAL. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x16);
+	write8(fixture->rom, ROM_BASE, fixture->script + 6U, 0x6F);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x09);
+	write8(fixture->rom, ROM_BASE, fixture->script + 2U, 0x05);
+	assertBlocked(fixture);
+}
+
+static void testControlFlowProof(struct Fixture* fixture) {
+	const uint32_t target = ROM_BASE + 0x10000U;
+	const uint32_t second = ROM_BASE + 0x10100U;
+
+	/* Unconditional branches are followed only when their exact target proves
+	 * safe. They remain speed-only even when the target is a plain end. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x05);
+	write32(fixture->rom, ROM_BASE, fixture->script + 2U, target);
+	write8(fixture->rom, ROM_BASE, target, 0x02);
+	assertSpeedOnly(fixture);
+
+	/* Both successors of a conditional branch must prove safe. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x06);
+	write32(fixture->rom, ROM_BASE, fixture->script + 3U, target);
+	write8(fixture->rom, ROM_BASE, fixture->script + 7U, 0x02);
+	write8(fixture->rom, ROM_BASE, target, 0x02);
+	assertSpeedOnly(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x06);
+	write32(fixture->rom, ROM_BASE, fixture->script + 3U, target);
+	write8(fixture->rom, ROM_BASE, fixture->script + 7U, 0x02);
+	write8(fixture->rom, ROM_BASE, target, 0x6F);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x06);
+	write32(fixture->rom, ROM_BASE, fixture->script + 3U, target);
+	write8(fixture->rom, ROM_BASE, fixture->script + 7U, 0x02);
+	write8(fixture->rom, ROM_BASE, target, 0x5C);
+	assertBlocked(fixture);
+
+	/* Calls use a modeled return stack; conditional calls prove both the taken
+	 * and untaken path. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x04);
+	write32(fixture->rom, ROM_BASE, fixture->script + 2U, target);
+	write8(fixture->rom, ROM_BASE, fixture->script + 6U, 0x02);
+	write8(fixture->rom, ROM_BASE, target, 0x03);
+	assertSpeedOnly(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x07);
+	write32(fixture->rom, ROM_BASE, fixture->script + 3U, target);
+	write8(fixture->rom, ROM_BASE, fixture->script + 7U, 0x02);
+	write8(fixture->rom, ROM_BASE, target, 0x03);
+	assertSpeedOnly(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x04);
+	write32(fixture->rom, ROM_BASE, fixture->script + 2U, target);
+	write8(fixture->rom, ROM_BASE, fixture->script + 6U, 0x02);
+	write8(fixture->rom, ROM_BASE, target, 0x25);
+	assertBlocked(fixture);
+
+	/* Non-message standard scripts are resolved through the revision-specific
+	 * gStdScripts table. Message standards are boundaries; yes/no is forbidden. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x09);
+	write8(fixture->rom, ROM_BASE, fixture->script + 2U, 0x00);
+	write8(fixture->rom, ROM_BASE, fixture->script + 3U, 0x02);
+	write32(fixture->rom, ROM_BASE, fixture->profile->stdScripts, target);
+	write8(fixture->rom, ROM_BASE, target, 0x03);
+	assertSpeedOnly(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x08);
+	write8(fixture->rom, ROM_BASE, fixture->script + 2U, 0x07);
+	write32(fixture->rom, ROM_BASE,
+			fixture->profile->stdScripts + 7U * sizeof(uint32_t), target);
+	write8(fixture->rom, ROM_BASE, target, 0x02);
+	assertSpeedOnly(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x0B);
+	write8(fixture->rom, ROM_BASE, fixture->script + 3U, 0x00);
+	write8(fixture->rom, ROM_BASE, fixture->script + 4U, 0x02);
+	write32(fixture->rom, ROM_BASE, fixture->profile->stdScripts, target);
+	write8(fixture->rom, ROM_BASE, target, 0x03);
+	assertSpeedOnly(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x0A);
+	write8(fixture->rom, ROM_BASE, fixture->script + 3U, 0x05);
+	write8(fixture->rom, ROM_BASE, fixture->script + 4U, 0x02);
+	assertBlocked(fixture);
+
+	/* Back-edges fail closed, even when another branch reaches end. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x05);
+	write32(fixture->rom, ROM_BASE, fixture->script + 2U,
+			fixture->script + 1U);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x06);
+	write32(fixture->rom, ROM_BASE, fixture->script + 3U,
+			fixture->script + 1U);
+	write8(fixture->rom, ROM_BASE, fixture->script + 7U, 0x02);
+	assertBlocked(fixture);
+
+	/* Representative easy-to-mis-size commands prove the checked width table. */
+	static const struct {
+		uint8_t opcode;
+		uint8_t width;
+	} widths[] = {
+		{ 0x2C, 1 }, /* initclock is a one-byte FRLG no-op */
+		{ 0x39, 8 }, /* warp */
+		{ 0x3C, 3 }, /* warphole */
+		{ 0x50, 9 }, /* applymovementat */
+		{ 0x52, 5 }, /* waitmovementat */
+		{ 0x74, 1 }, /* drawboxtext is a one-byte FRLG no-op */
+		{ 0x7D, 4 }, /* bufferspeciesname */
+		{ 0x7E, 2 }, /* bufferleadmonspeciesname */
+		{ 0x85, 6 }, /* bufferstring */
+		{ 0x8A, 1 }, /* setberrytree is a one-byte FRLG no-op */
+		{ 0x94, 1 }, /* hidemoneybox consumes no legacy coordinates */
+		{ 0x96, 1 }, /* getpokenewsactive is a one-byte FRLG no-op */
+		{ 0xBF, 6 }, /* vbufferstring is forbidden despite its fixed width */
+		{ 0xC6, 4 }, /* bufferboxname */
+		{ 0xD4, 6 }, /* bufferitemnameplural */
+	};
+	for (size_t i = 0; i < sizeof(widths) / sizeof(*widths); ++i) {
+		setOrdinary(fixture, 0);
+		write8(fixture->rom, ROM_BASE, fixture->script + 1U,
+				widths[i].opcode);
+		write8(fixture->rom, ROM_BASE,
+				fixture->script + 1U + widths[i].width, 0x02);
+		if (widths[i].opcode == 0xBF) {
+			assertBlocked(fixture);
+		} else {
+			assertSpeedOnly(fixture);
+		}
+	}
+
+	/* A large finite graph just below the bound succeeds; exceeding the bound
+	 * fails closed. */
+	for (unsigned count = 500U; count <= 512U; count += 12U) {
+		setOrdinary(fixture, 0);
+		write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x05);
+		write32(fixture->rom, ROM_BASE, fixture->script + 2U, target);
+		for (unsigned i = 0; i < count; ++i) {
+			uint32_t cursor = target + i * 5U;
+			write8(fixture->rom, ROM_BASE, cursor, 0x05);
+			write32(fixture->rom, ROM_BASE, cursor + 1U, cursor + 5U);
+		}
+		write8(fixture->rom, ROM_BASE, target + count * 5U, 0x02);
+		if (count == 500U) {
+			assertSpeedOnly(fixture);
+		} else {
+			assertBlocked(fixture);
+		}
+	}
+
+	/* Nineteen modeled return addresses are valid; a twentieth prospective
+	 * push reproduces ScriptPush's ambiguous overflow and is rejected. */
+	setOrdinary(fixture, 0);
+	for (unsigned i = 0; i < 19U; ++i) {
+		uint32_t cursor = target + i * 5U;
+		write8(fixture->rom, ROM_BASE, cursor, 0x04);
+		write32(fixture->rom, ROM_BASE, cursor + 1U, cursor + 5U);
+	}
+	write8(fixture->rom, ROM_BASE, target + 19U * 5U, 0x02);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x05);
+	write32(fixture->rom, ROM_BASE, fixture->script + 2U, target);
+	assertSpeedOnly(fixture);
+
+	setOrdinary(fixture, 0);
+	for (unsigned i = 0; i < 20U; ++i) {
+		uint32_t cursor = second + i * 5U;
+		write8(fixture->rom, ROM_BASE, cursor, 0x04);
+		write32(fixture->rom, ROM_BASE, cursor + 1U, cursor + 5U);
+	}
+	write8(fixture->rom, ROM_BASE, second + 20U * 5U, 0x02);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x05);
+	write32(fixture->rom, ROM_BASE, fixture->script + 2U, second);
+	assertBlocked(fixture);
+}
