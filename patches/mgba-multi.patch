+#include <stdint.h>
+
+#define MULTI_MAX_INSTANCES 3
+#define MULTI_VIDEO_WIDTH 240
+#define MULTI_VIDEO_HEIGHT 160
+#define MULTI_COMPOSITE_WIDTH 480
+#define MULTI_COMPOSITE_HEIGHT 320
+#define MULTI_AUDIO_FIFO_FRAMES 8192
+
+#define MULTI_SPEED_MIN_TENTHS 10
