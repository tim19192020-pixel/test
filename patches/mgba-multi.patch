+bool retro_load_game_special(unsigned gameType, const struct retro_game_info* games, size_t count) {
+	if ((gameType == MULTI_SUBSYSTEM_2 && count == 2) || (gameType == MULTI_SUBSYSTEM_3 && count == 3)) {
+		return _loadGames(games, count, false);
+	}
+	return false;
+}
