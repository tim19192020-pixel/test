+static void testTailClassificationCache(struct Fixture* fixture) {
+	/* Forbidden immutable tails are cached independently of the armed terminal
+	 * session, so they are not re-proved on every frontend frame. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x25);
+	assertBlocked(fixture);
+	assert(fixture->detector.cachedTailValid);
+	assert(fixture->detector.cachedTailSafety == 0U);
+
+	/* The production ROM is immutable. Mutating this fixture demonstrates that
+	 * the same wait/stack key reuses even a forbidden verdict. */
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x02);
+	assertBlocked(fixture);
+
+	fireRedDialogueReset(&fixture->detector);
+	assert(!fixture->detector.cachedTailValid);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	assert(fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+}
