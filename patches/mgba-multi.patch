+
+#define RGB565_BLACK 0x0000U
+#define RGB565_PANEL 0x0841U
+#define RGB565_TITLE 0x0018U
+#define RGB565_ROW_A 0x1082U
+#define RGB565_ROW_B 0x18C3U
+#define RGB565_WHITE 0xFFFFU
+#define RGB565_GREY 0xAD55U
+#define RGB565_CYAN 0x07FFU
+#define RGB565_YELLOW 0xFFE0U
+#define RGB565_RED 0xF800U
+
+/* Five columns per printable ASCII glyph, with the low seven bits read from
+ * top to bottom. Keeping the bitmap here avoids fonts, I/O, and allocation. */
+static const uint8_t font5x7[96][5] = {
+	{ 0x00, 0x00, 0x00, 0x00, 0x00 }, /*   */
+	{ 0x00, 0x00, 0x5F, 0x00, 0x00 }, /* ! */
+	{ 0x00, 0x07, 0x00, 0x07, 0x00 }, /* " */
