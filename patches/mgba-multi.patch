+static void _showInactiveSpeedMessage(unsigned player) {
+	if (!environCallback) {
+		return;
+	}
+	char text[112];
+	snprintf(text, sizeof(text),
+			"Player %u speed target is 1.0x; select a faster target in Core Options",
+			player + 1);
+	struct retro_message message = { text, 180 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _showDialogueMessage(unsigned player,
+		enum MultiDialogueToggleResult result) {
+	if (!environCallback || result == MULTI_DIALOGUE_TOGGLE_NONE) {
+		return;
+	}
+	char text[144];
+	switch (result) {
+	case MULTI_DIALOGUE_TOGGLE_ENABLED:
+		snprintf(text, sizeof(text),
+				"Player %u FireRed dialogue assist: %ux, auto-next %s",
+				player + 1, dialogueSpeedTenths / MULTI_SPEED_ONE,
+				dialogueAutoAdvance ? "on" : "off");
+		break;
+	case MULTI_DIALOGUE_TOGGLE_DISABLED:
+		snprintf(text, sizeof(text),
+				"Player %u FireRed dialogue assist: off", player + 1);
+		break;
+	case MULTI_DIALOGUE_TOGGLE_UNAVAILABLE:
+		snprintf(text, sizeof(text),
+				"Player %u dialogue assist unavailable: clean FireRed USA 1.0/1.1 required",
+				player + 1);
+		break;
+	case MULTI_DIALOGUE_TOGGLE_NONE:
+	default:
+		return;
+	}
+	struct retro_message message = { text, 240 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _composeVideo(const struct MultiLayout* layout) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		const struct MultiPlacement* placement = &layout->placement[i];
+		for (unsigned y = 0; y < MULTI_VIDEO_HEIGHT; ++y) {
+			memcpy(&compositeBuffer[(placement->y + y) * layout->width + placement->x],
+					&instances[i].video[y * VIDEO_STRIDE],
+					MULTI_VIDEO_WIDTH * sizeof(*compositeBuffer));
+		}
+	}
+}
+
+static void _drainInstanceAudio(struct MultiInstance* instance) {
+	struct mAudioBuffer* buffer = instance->core->getAudioBuffer(instance->core);
+	for (;;) {
+		size_t read = mAudioBufferRead(buffer, instance->rawAudio, AUDIO_RAW_CHUNK_FRAMES);
+		if (!read) {
+			break;
+		}
+		size_t produced = audioConverterProcess(&instance->converter, instance->rawAudio, read,
+				instance->convertedAudio);
+		if (produced) {
+			multiAudioFifoPush(&instance->audio, instance->convertedAudio, produced);
+		}
+	}
+}
+
+static void _captureOrDiscardInstanceAudio(struct MultiInstance* instance) {
+	if (instance->captureAudio) {
+		_drainInstanceAudio(instance);
+	} else {
+		/* Clearing advances no queue and is constant-time. Emulated audio remains
+		 * enabled because games can depend on its timing and registers. */
+		mAudioBufferClear(instance->core->getAudioBuffer(instance->core));
+	}
+}
+
+static void _submitAudio(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		unsigned rate = instances[i].core->audioSampleRate(instances[i].core);
+		if (rate != instances[i].converter.inputRate) {
+			_instanceAudioRateChanged(&instances[i].stream, rate);
+		}
+		_captureOrDiscardInstanceAudio(&instances[i]);
+	}
+	if (!instanceCount) {
+		return;
+	}
+
+	uint32_t frameCycles = instances[0].core->frameCycles(instances[0].core);
+	uint32_t frequency = instances[0].core->frequency(instances[0].core);
+	size_t frames = multiAudioClockNext(&audioClock, GBA_OUTPUT_RATE, frameCycles, frequency);
+	if (frames > AUDIO_OUTPUT_MAX_FRAMES) {
+		frames = AUDIO_OUTPUT_MAX_FRAMES;
+	}
+	memset(mixedAudio, 0, frames * 2 * sizeof(*mixedAudio));
+	int selected = multiAudioSelectedIndex(audioMode, instanceCount);
+	if (selected >= 0) {
+		struct MultiAudioFifo* fifo = &instances[selected].audio;
+		multiAudioFifoTrim(fifo, frames + AUDIO_FIFO_MAX_LEAD);
+		for (size_t frame = 0; frame < frames; ++frame) {
+			multiAudioFifoPop(fifo, &mixedAudio[frame * 2], &mixedAudio[frame * 2 + 1]);
+		}
+	}
+	if (audioCallback) {
+		size_t accepted = audioCallback(mixedAudio, frames);
+		if (accepted < frames) {
+			rejectedAudioFrames += frames - accepted;
+		}
+	}
+}
+
+static void _syncRtcTrailers(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct GBA* gba = instances[i].core->board;
+		if (!(gba->memory.hw.devices & HW_RTC)) {
+			continue;
+		}
+		GBASavedataRTCWrite(&gba->memory.savedata);
+		size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+		multiSaveMirrorRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+				SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer));
+	}
+}
