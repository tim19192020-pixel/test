+static void _silentLog(struct mLogger* logger, int category, enum mLogLevel level,
+		const char* format, va_list args) {
+	UNUSED(logger);
+	UNUSED(category);
+	UNUSED(level);
+	UNUSED(format);
+	UNUSED(args);
+}
+
+static void _frontendLog(enum retro_log_level level, const char* format, ...) {
+	if (!logCallback) {
+		return;
+	}
+	char message[512];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(message, sizeof(message), format, args);
+	va_end(args);
+	logCallback(level, "mGBA Multi: %s\n", message);
+}
+
+static void _instanceAudioRateChanged(struct mAVStream* stream, unsigned rate) {
+	struct MultiInstance* instance = containerof(stream, struct MultiInstance, stream);
+	/* GBAAudioWriteSOUNDBIAS emits every old-rate sample before this callback.
+	 * Drain those samples with the old converter, then start a clean converter
+	 * at the new hardware rate. Each callback touches only its owning instance. */
+	_captureOrDiscardInstanceAudio(instance);
+	audioConverterResetScaled(&instance->converter, rate, instance->audioSpeedTenths);
+}
+
+static const char* _getVariable(const char* key) {
+	struct retro_variable var = { key, NULL };
+	if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		return var.value;
+	}
+	return NULL;
+}
+
+static unsigned _requestedInstanceCount(void) {
+	const char* value = _getVariable("mgba_multi_instances");
+	long count = value ? strtol(value, NULL, 10) : MULTI_MAX_INSTANCES;
+	if (count < 1) {
+		count = 1;
+	} else if (count > MULTI_MAX_INSTANCES) {
+		count = MULTI_MAX_INSTANCES;
+	}
+	return (unsigned) count;
+}
+
+static bool _parallelRequested(void) {
+	const char* value = _getVariable("mgba_multi_execution");
+	return !value || strcmp(value, "Sequential") != 0;
+}
+
+static unsigned _requestedSpeedTenths(unsigned player) {
+	static const char* keys[MULTI_MAX_INSTANCES] = {
+		"mgba_multi_speed_p1",
+		"mgba_multi_speed_p2",
+		"mgba_multi_speed_p3",
+	};
+	if (player >= MULTI_MAX_INSTANCES) {
+		return MULTI_SPEED_ONE;
+	}
+	const char* value = _getVariable(keys[player]);
+	return value ? multiSpeedParseTarget(value) : MULTI_SPEED_DEFAULT;
+}
+
+static enum MultiAudioMode _requestedAudioMode(void) {
+	return multiAudioParseMode(_getVariable("mgba_multi_audio"));
+}
+
