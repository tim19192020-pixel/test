@@ -0,0 +1,1340 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/*
+ * Minimal, linkless multi-instance libretro frontend.
+ *
+ * There is deliberately no link emulation, run-ahead queue, wall-clock pacing,
+ * per-frame allocation, or file I/O here. Player 1 runs on the libretro caller.
+ * Players 2 and 3 each keep one persistent owner pthread. Every retro_run uses
+ * one bounded generation and one barrier, including per-instance acceleration.
+ */
+
+#include "libretro.h"
+
+#include <mgba-util/audio-buffer.h>
+#include <mgba-util/common.h>
+#include <mgba-util/memory.h>
+#include <mgba-util/sha1.h>
+#include <mgba-util/vfs.h>
+
+#include <mgba/core/config.h>
+#include <mgba/core/core.h>
+#include <mgba/core/log.h>
+#include <mgba/core/version.h>
+#include <mgba/internal/gba/gba.h>
+#include <mgba/internal/gba/input.h>
+#include <mgba/internal/gba/memory.h>
+#include <mgba/internal/gba/savedata.h>
+
+#include "libretro-audio.h"
+#include "libretro_firered_dialogue.h"
+#include "libretro-vfs.h"
+#include "libretro_multi_support.h"
+
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef __LIBRETRO__
+#error "This frontend can only be built as a libretro core"
+#endif
+
+#ifndef M_CORE_GBA
+#error "The barebones multi-instance core requires the GBA core"
