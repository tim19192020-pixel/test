+static void testIvCheckerToggleAndRefresh(void) {
+	struct MultiIvCheckerState state;
+	multiIvCheckerInit(&state);
+	assert(!state.visible);
+	assert(!state.buttonDown);
+	assert(state.refreshCountdown == 0);
+	assert(!multiIvCheckerShouldRefresh(&state));
+	assert(state.refreshCountdown == 0);
+
+	/* X toggles only on a rising edge. Showing schedules an immediate read. */
+	assert(multiIvCheckerHandleX(&state, true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_SHOWN);
+	assert(state.visible && state.buttonDown);
+	assert(state.refreshCountdown == 0);
+	assert(multiIvCheckerShouldRefresh(&state));
+	assert(state.refreshCountdown == MULTI_IV_CHECKER_REFRESH_FRAMES);
+	assert(multiIvCheckerHandleX(&state, true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+	assert(state.visible);
+
+	/* The next refresh is exactly 15 frontend frames after the immediate one. */
+	for (unsigned frame = 1; frame < MULTI_IV_CHECKER_REFRESH_FRAMES; ++frame) {
+		assert(!multiIvCheckerShouldRefresh(&state));
+		assert(state.refreshCountdown == MULTI_IV_CHECKER_REFRESH_FRAMES - frame);
+	}
+	assert(multiIvCheckerShouldRefresh(&state));
+	assert(state.refreshCountdown == MULTI_IV_CHECKER_REFRESH_FRAMES);
+
+	/* Release does not toggle; the following rising edge hides the checker. */
+	assert(multiIvCheckerHandleX(&state, false, true) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+	assert(state.visible && !state.buttonDown);
+	assert(multiIvCheckerHandleX(&state, true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_HIDDEN);
+	assert(!state.visible && state.buttonDown);
+	assert(state.refreshCountdown == 0);
+	for (unsigned frame = 0; frame < MULTI_IV_CHECKER_REFRESH_FRAMES * 2; ++frame) {
+		assert(!multiIvCheckerShouldRefresh(&state));
+		assert(state.refreshCountdown == 0);
+	}
+}
