+static void _destroyContent(void) {
+	_stopWorkers();
+	for (unsigned i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		struct MultiInstance* instance = &instances[i];
+		if (instance->initialized && instance->core) {
+			struct GBA* gba = instance->core->board;
+			if (gba->memory.hw.devices & HW_RTC) {
+				GBASavedataRTCWrite(&gba->memory.savedata);
+				size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+				multiSaveMirrorRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+						SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer));
+			}
+			instance->core->setAVStream(instance->core, NULL);
+			mCoreConfigDeinit(&instance->core->config);
+			instance->core->deinit(instance->core);
+		}
+		memset(instance, 0, sizeof(*instance));
+	}
+	if (romData) {
+		mappedMemoryFree(romData, romSize);
+		romData = NULL;
+	}
+	romSize = 0;
+	instanceCount = 0;
+	deferredSetup = false;
+	fatalLoadError = false;
+	multiAudioClockReset(&audioClock);
+}
+
+static void _runInstanceFrames(unsigned index, uint16_t keys, unsigned frameSteps) {
+	struct MultiInstance* instance = &instances[index];
+	struct GBA* gba = instance->core->board;
+	if (frameSteps < 1) {
+		frameSteps = 1;
+	} else if (frameSteps > MULTI_SPEED_MAX_FRAMES) {
+		frameSteps = MULTI_SPEED_MAX_FRAMES;
+	}
+	instance->core->setKeys(instance->core, keys);
+	for (unsigned step = 0; step < frameSteps; ++step) {
+		/* Emulation, DMA, timers, and audio always run. Only software rendering
+		 * is skipped for intermediate accelerated frames. */
+		if (frameSteps > 1) {
+			gba->video.frameskipCounter = step + 1 < frameSteps ? 1 : 0;
+		}
+		instance->core->runFrame(instance->core);
+		if (step + 1 < frameSteps) {
+			/* At 262144 Hz one frame can contain about 4389 samples. Drain or
+			 * discard between subframes so the fixed raw ring can never backlog. */
+			_captureOrDiscardInstanceAudio(instance);
+		}
+	}
+	if (frameSteps > 1) {
+		gba->video.frameskipCounter = 0;
+	}
+}
+
+static void* _workerMain(void* context) {
+	struct MultiWorker* worker = context;
+	uint64_t observedGeneration = 0;
+	pthread_mutex_lock(&workerMutex);
+	while (!workerStop) {
+		while (!workerStop && workerGeneration == observedGeneration) {
+			pthread_cond_wait(&workerWake, &workerMutex);
+		}
+		if (workerStop) {
+			break;
+		}
+
+		uint64_t generation = workerGeneration;
+		enum MultiWorkerCommand command = workerCommand;
+		uint16_t keys = workerKeys[worker->instance];
+		unsigned frameSteps = workerFrameSteps[worker->instance];
+		pthread_mutex_unlock(&workerMutex);
+
+		struct mCore* core = instances[worker->instance].core;
+		if (command == WORKER_COMMAND_FRAME) {
+			_runInstanceFrames(worker->instance, keys, frameSteps);
+		} else if (command == WORKER_COMMAND_RESET) {
+			core->reset(core);
+		}
+
+		pthread_mutex_lock(&workerMutex);
+		observedGeneration = generation;
+		worker->completedGeneration = generation;
+		if (workerPending) {
+			--workerPending;
+			if (!workerPending) {
+				pthread_cond_signal(&workerDone);
+			}
+		}
+	}
+	pthread_mutex_unlock(&workerMutex);
+	return NULL;
+}
+
+static bool _startWorkers(void) {
+	if (instanceCount < 2 || !_parallelRequested()) {
+		parallelActive = false;
+		return true;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerStop = false;
+	workerPending = 0;
+	workerCommand = WORKER_COMMAND_NONE;
+	workerGeneration = 0;
+	pthread_mutex_unlock(&workerMutex);
+
+	for (unsigned i = 1; i < instanceCount; ++i) {
+		workers[i].instance = i;
+		workers[i].completedGeneration = 0;
+		int error = pthread_create(&workers[i].thread, NULL, _workerMain, &workers[i]);
+		if (error) {
+			_frontendLog(RETRO_LOG_WARN,
+					"could not create Player %u worker (%d); using sequential execution", i + 1, error);
+			pthread_mutex_lock(&workerMutex);
+			workerStop = true;
+			pthread_cond_broadcast(&workerWake);
+			pthread_mutex_unlock(&workerMutex);
+			for (unsigned j = 1; j < i; ++j) {
+				if (workers[j].started) {
+					pthread_join(workers[j].thread, NULL);
+					workers[j].started = false;
+				}
+			}
+			pthread_mutex_lock(&workerMutex);
+			workerStop = false;
+			pthread_mutex_unlock(&workerMutex);
+			parallelActive = false;
+			return true;
+		}
+		workers[i].started = true;
+	}
+	parallelActive = true;
+	return true;
+}
+
+static void _stopWorkers(void) {
+	bool anyStarted = false;
+	for (unsigned i = 1; i < MULTI_MAX_INSTANCES; ++i) {
+		anyStarted |= workers[i].started;
+	}
+	if (!anyStarted) {
+		parallelActive = false;
+		return;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerStop = true;
+	pthread_cond_broadcast(&workerWake);
+	pthread_mutex_unlock(&workerMutex);
+	for (unsigned i = 1; i < MULTI_MAX_INSTANCES; ++i) {
+		if (workers[i].started) {
+			pthread_join(workers[i].thread, NULL);
+			workers[i].started = false;
+		}
+	}
+	pthread_mutex_lock(&workerMutex);
+	workerPending = 0;
+	workerCommand = WORKER_COMMAND_NONE;
+	workerStop = false;
+	pthread_mutex_unlock(&workerMutex);
+	parallelActive = false;
+}
+
+static void _executeBatch(enum MultiWorkerCommand command, const uint16_t* keys,
+		const unsigned* frameSteps) {
+	if (!parallelActive) {
+		for (unsigned i = 0; i < instanceCount; ++i) {
+			if (command == WORKER_COMMAND_FRAME) {
+				_runInstanceFrames(i, keys[i], frameSteps[i]);
+			} else if (command == WORKER_COMMAND_RESET) {
+				instances[i].core->reset(instances[i].core);
+			}
+		}
+		return;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerCommand = command;
+	if (keys) {
+		memcpy(workerKeys, keys, instanceCount * sizeof(*keys));
+	}
+	if (frameSteps) {
+		memcpy(workerFrameSteps, frameSteps, instanceCount * sizeof(*frameSteps));
+	}
+	workerPending = instanceCount - 1;
+	++workerGeneration;
+	pthread_cond_broadcast(&workerWake);
+	pthread_mutex_unlock(&workerMutex);
+
+	if (command == WORKER_COMMAND_FRAME) {
+		_runInstanceFrames(0, keys[0], frameSteps[0]);
+	} else if (command == WORKER_COMMAND_RESET) {
+		instances[0].core->reset(instances[0].core);
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	while (workerPending) {
+		pthread_cond_wait(&workerDone, &workerMutex);
+	}
+	pthread_mutex_unlock(&workerMutex);
+}
+
+static void _resetInstanceAudioPipeline(unsigned index, bool capture, unsigned speedTenths) {
+	struct MultiInstance* instance = &instances[index];
+	instance->captureAudio = capture;
+	instance->audioSpeedTenths = speedTenths;
+	mAudioBufferClear(instance->core->getAudioBuffer(instance->core));
+	audioConverterResetScaled(&instance->converter,
+			instance->core->audioSampleRate(instance->core), speedTenths);
+	multiAudioFifoReset(&instance->audio);
+}
+
+static void _prepareAudioPipelines(void) {
+	int selected = multiAudioSelectedIndex(audioMode, instanceCount);
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		bool capture = selected >= 0 && i == (unsigned) selected;
+		unsigned speedTenths = _effectiveAudioSpeed(i);
+		if (instances[i].captureAudio != capture ||
+				instances[i].audioSpeedTenths != speedTenths) {
+			_resetInstanceAudioPipeline(i, capture, speedTenths);
+		}
+	}
+}
+
+static void _resetAudioPipeline(bool resetClock) {
+	if (resetClock) {
+		multiAudioClockReset(&audioClock);
+	}
+	int selected = multiAudioSelectedIndex(audioMode, instanceCount);
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		_resetInstanceAudioPipeline(i, selected >= 0 && i == (unsigned) selected,
+				_effectiveAudioSpeed(i));
+	}
+}
+
+static bool _finishDeferredSetup(void) {
+	if (!deferredSetup) {
+		return !fatalLoadError;
+	}
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct mCore* core = instances[i].core;
+		core->reset(core);
+		struct VFile* save = VFileFromMemory(saveData[i], SAVE_SLOT_SIZE);
+		if (!save || !core->loadSave(core, save)) {
+			if (save) {
+				save->close(save);
+			}
+			_frontendLog(RETRO_LOG_ERROR, "could not attach Player %u save slice", i + 1);
+			fatalLoadError = true;
+			deferredSetup = false;
+			return false;
+		}
+		struct GBA* gba = core->board;
+		if (gba->memory.hw.devices & HW_RTC) {
+			size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+			if (multiSaveRestoreRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+						SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer))) {
+				GBASavedataRTCRead(&gba->memory.savedata);
+			}
+		}
+	}
+	_resetAudioPipeline(true);
+	_startWorkers();
+	deferredSetup = false;
+
+	char text[128];
+	snprintf(text, sizeof(text), "mGBA Multi %s: %u instance%s, %s execution",
+			MULTI_FRONTEND_VERSION, instanceCount, instanceCount == 1 ? "" : "s",
+			parallelActive ? "parallel" : "direct");
+	struct retro_message message = { text, 240 };
+	if (environCallback) {
+		environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	}
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+	return true;
+}
+
+static uint16_t _readKeys(unsigned port, bool* speedToggle) {
+	if (speedToggle) {
+		*speedToggle = false;
+	}
+	if (!inputCallback) {
+		return 0;
+	}
+	uint16_t keys = 0;
+	if (useBitmasks) {
+		uint16_t mask = (uint16_t) inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+				RETRO_DEVICE_ID_JOYPAD_MASK);
+		for (unsigned i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= ((mask >> keymap[i]) & 1U) << i;
+		}
+		if (speedToggle) {
+			*speedToggle = (mask >> RETRO_DEVICE_ID_JOYPAD_R2) & 1U;
+		}
+	} else {
+		for (unsigned i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= (!!inputCallback(port, RETRO_DEVICE_JOYPAD, 0, keymap[i])) << i;
+		}
+		if (speedToggle) {
+			*speedToggle = !!inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+					RETRO_DEVICE_ID_JOYPAD_R2);
+		}
+	}
+	return keys;
+}
+
+static void _showSpeedMessage(unsigned player) {
+	if (!environCallback) {
+		return;
+	}
+	char text[96];
+	if (!speedState[player].enabled) {
+		snprintf(text, sizeof(text), "Player %u speed: 1.0x", player + 1);
+	} else {
+		unsigned speed = speedState[player].targetTenths;
+		snprintf(text, sizeof(text), "Player %u speed: %u.%ux", player + 1,
+				speed / 10, speed % 10);
+	}
+	struct retro_message message = { text, 180 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _showInactiveSpeedMessage(unsigned player) {
+	if (!environCallback) {
+		return;
+	}
+	char text[112];
+	snprintf(text, sizeof(text),
+			"Player %u speed target is 1.0x; select a faster target in Core Options",
+			player + 1);
+	struct retro_message message = { text, 180 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _composeVideo(const struct MultiLayout* layout) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		const struct MultiPlacement* placement = &layout->placement[i];
+		for (unsigned y = 0; y < MULTI_VIDEO_HEIGHT; ++y) {
+			memcpy(&compositeBuffer[(placement->y + y) * layout->width + placement->x],
+					&instances[i].video[y * VIDEO_STRIDE],
+					MULTI_VIDEO_WIDTH * sizeof(*compositeBuffer));
+		}
+	}
+}
+
+static void _drainInstanceAudio(struct MultiInstance* instance) {
+	struct mAudioBuffer* buffer = instance->core->getAudioBuffer(instance->core);
+	for (;;) {
+		size_t read = mAudioBufferRead(buffer, instance->rawAudio, AUDIO_RAW_CHUNK_FRAMES);
+		if (!read) {
+			break;
+		}
+		size_t produced = audioConverterProcess(&instance->converter, instance->rawAudio, read,
+				instance->convertedAudio);
+		if (produced) {
+			multiAudioFifoPush(&instance->audio, instance->convertedAudio, produced);
+		}
+	}
+}
+
+static void _captureOrDiscardInstanceAudio(struct MultiInstance* instance) {
+	if (instance->captureAudio) {
+		_drainInstanceAudio(instance);
+	} else {
+		/* Clearing advances no queue and is constant-time. Emulated audio remains
+		 * enabled because games can depend on its timing and registers. */
+		mAudioBufferClear(instance->core->getAudioBuffer(instance->core));
+	}
+}
+
+static void _submitAudio(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		unsigned rate = instances[i].core->audioSampleRate(instances[i].core);
+		if (rate != instances[i].converter.inputRate) {
+			_instanceAudioRateChanged(&instances[i].stream, rate);
+		}
+		_captureOrDiscardInstanceAudio(&instances[i]);
+	}
+	if (!instanceCount) {
+		return;
+	}
+
+	uint32_t frameCycles = instances[0].core->frameCycles(instances[0].core);
+	uint32_t frequency = instances[0].core->frequency(instances[0].core);
+	size_t frames = multiAudioClockNext(&audioClock, GBA_OUTPUT_RATE, frameCycles, frequency);
+	if (frames > AUDIO_OUTPUT_MAX_FRAMES) {
+		frames = AUDIO_OUTPUT_MAX_FRAMES;
+	}
+	memset(mixedAudio, 0, frames * 2 * sizeof(*mixedAudio));
+	int selected = multiAudioSelectedIndex(audioMode, instanceCount);
+	if (selected >= 0) {
+		struct MultiAudioFifo* fifo = &instances[selected].audio;
+		multiAudioFifoTrim(fifo, frames + AUDIO_FIFO_MAX_LEAD);
+		for (size_t frame = 0; frame < frames; ++frame) {
+			multiAudioFifoPop(fifo, &mixedAudio[frame * 2], &mixedAudio[frame * 2 + 1]);
+		}
+	}
+	if (audioCallback) {
+		size_t accepted = audioCallback(mixedAudio, frames);
+		if (accepted < frames) {
+			rejectedAudioFrames += frames - accepted;
+		}
+	}
+}
+
+static void _syncRtcTrailers(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct GBA* gba = instances[i].core->board;
+		if (!(gba->memory.hw.devices & HW_RTC)) {
+			continue;
+		}
+		GBASavedataRTCWrite(&gba->memory.savedata);
+		size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+		multiSaveMirrorRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+				SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer));
+	}
+}
+
+unsigned retro_api_version(void) {
+	return RETRO_API_VERSION;
+}
+
+void retro_set_environment(retro_environment_t callback) {
+	environCallback = callback;
+	libretroVFSInit(callback);
+	callback(RETRO_ENVIRONMENT_SET_VARIABLES, (void*) coreVariables);
+	callback(RETRO_ENVIRONMENT_SET_CONTROLLER_INFO, (void*) controllerInfo);
+}
+
+void retro_set_video_refresh(retro_video_refresh_t callback) {
+	videoCallback = callback;
+}
+
+void retro_set_audio_sample(retro_audio_sample_t callback) {
+	UNUSED(callback);
+}
+
+void retro_set_audio_sample_batch(retro_audio_sample_batch_t callback) {
+	audioCallback = callback;
+}
+
+void retro_set_input_poll(retro_input_poll_t callback) {
+	inputPollCallback = callback;
+}
+
+void retro_set_input_state(retro_input_state_t callback) {
+	inputCallback = callback;
+}
+
+void retro_get_system_info(struct retro_system_info* info) {
+	memset(info, 0, sizeof(*info));
+	snprintf(libraryVersion, sizeof(libraryVersion), "%s-multi.%s", projectVersion,
+			MULTI_FRONTEND_VERSION);
+	info->library_name = "mGBA Multi";
+	info->library_version = libraryVersion;
+	info->valid_extensions = "gba";
+	info->need_fullpath = false;
+	info->block_extract = false;
+}
+
+void retro_get_system_av_info(struct retro_system_av_info* info) {
+	memset(info, 0, sizeof(*info));
+	struct MultiLayout layout = { 0 };
+	unsigned count = instanceCount ? instanceCount : _requestedInstanceCount();
+	if (!multiLayoutForCount(count, &layout)) {
+		multiLayoutForCount(1, &layout);
+	}
+	info->geometry.base_width = layout.width;
+	info->geometry.base_height = layout.height;
+	info->geometry.max_width = MULTI_COMPOSITE_WIDTH;
+	info->geometry.max_height = MULTI_COMPOSITE_HEIGHT;
+	info->geometry.aspect_ratio = (float) layout.width / (float) layout.height;
+	if (instanceCount && instances[0].core) {
+		info->timing.fps = instances[0].core->frequency(instances[0].core) /
+				(double) instances[0].core->frameCycles(instances[0].core);
+	} else {
+		info->timing.fps = 16777216.0 / 280896.0;
+	}
+	info->timing.sample_rate = GBA_OUTPUT_RATE;
+}
+
+void retro_init(void) {
+	enum retro_pixel_format format = RETRO_PIXEL_FORMAT_RGB565;
+	environCallback(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &format);
+	useBitmasks = environCallback(RETRO_ENVIRONMENT_GET_INPUT_BITMASKS, NULL);
+
+	static struct retro_input_descriptor descriptors[
+			MULTI_MAX_INSTANCES * ((sizeof(keymap) / sizeof(*keymap)) + 1) + 1];
+	static const char* names[] = {
+		"A", "B", "Select", "Start", "Right", "Left", "Up", "Down", "R", "L",
+	};
+	memset(descriptors, 0, sizeof(descriptors));
+	for (unsigned port = 0; port < MULTI_MAX_INSTANCES; ++port) {
+		size_t base = port * ((sizeof(keymap) / sizeof(*keymap)) + 1);
+		for (unsigned key = 0; key < sizeof(keymap) / sizeof(*keymap); ++key) {
+			struct retro_input_descriptor* descriptor = &descriptors[base + key];
+			descriptor->port = port;
+			descriptor->device = RETRO_DEVICE_JOYPAD;
+			descriptor->id = keymap[key];
+			descriptor->description = names[key];
+		}
+		struct retro_input_descriptor* speed =
+				&descriptors[base + sizeof(keymap) / sizeof(*keymap)];
+		speed->port = port;
+		speed->device = RETRO_DEVICE_JOYPAD;
+		speed->id = RETRO_DEVICE_ID_JOYPAD_R2;
+		speed->description = "Toggle Speed";
+	}
+	environCallback(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, descriptors);
+
+	struct retro_log_callback log;
+	if (environCallback(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log)) {
+		logCallback = log.log;
+	} else {
+		logCallback = NULL;
+	}
+	silentLogger.log = _silentLog;
+	silentLogger.filter = NULL;
+	mLogSetDefaultLogger(&silentLogger);
+	memset(compositeBuffer, 0, sizeof(compositeBuffer));
+	multiAudioClockReset(&audioClock);
+	rejectedAudioFrames = 0;
+}
+
+void retro_deinit(void) {
+	_destroyContent();
+	useBitmasks = false;
+	logCallback = NULL;
+}
+
+bool retro_load_game(const struct retro_game_info* game) {
+	_destroyContent();
+	memset(saveData, 0xFF, sizeof(saveData));
+	memset(compositeBuffer, 0, sizeof(compositeBuffer));
+	_initializeRuntimeSettings();
+	if (!_copyRom(game)) {
+		_frontendLog(RETRO_LOG_ERROR, "could not copy content into immutable ROM memory");
+		return false;
+	}
+
+	instanceCount = _requestedInstanceCount();
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		if (!_initializeInstance(i)) {
+			_frontendLog(RETRO_LOG_ERROR, "could not initialize Player %u", i + 1);
+			_destroyContent();
+			return false;
+		}
+	}
+	deferredSetup = true;
+	fatalLoadError = false;
+	return true;
+}
+
+bool retro_load_game_special(unsigned gameType, const struct retro_game_info* games, size_t count) {
+	UNUSED(gameType);
+	UNUSED(games);
+	UNUSED(count);
+	return false;
+}
+
+void retro_unload_game(void) {
+	_destroyContent();
+}
+
+void retro_run(void) {
+	if (!instanceCount || fatalLoadError || !_finishDeferredSetup()) {
+		if (videoCallback) {
+			videoCallback(NULL, 0, 0, 0);
+		}
+		return;
+	}
+	bool variablesUpdated = false;
+	if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE,
+			&variablesUpdated) && variablesUpdated) {
+		_updateRuntimeSettings();
+	}
+
+	if (inputPollCallback) {
+		inputPollCallback();
+	}
+	uint16_t keys[MULTI_MAX_INSTANCES] = { 0, 0, 0 };
+	unsigned frameSteps[MULTI_MAX_INSTANCES] = { 1, 1, 1 };
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		bool speedToggle = false;
+		keys[i] = _readKeys(i, &speedToggle);
+		bool wasDown = speedState[i].buttonDown;
+		if (multiSpeedHandleR2(&speedState[i], speedToggle)) {
+			_showSpeedMessage(i);
+		} else if (speedToggle && !wasDown &&
+				speedState[i].targetTenths == MULTI_SPEED_ONE) {
+			_showInactiveSpeedMessage(i);
+		}
+		frameSteps[i] = multiSpeedNextFrames(&speedState[i]);
+	}
+	_prepareAudioPipelines();
+	_executeBatch(WORKER_COMMAND_FRAME, keys, frameSteps);
+	_syncRtcTrailers();
+
+	struct MultiLayout layout;
+	if (videoCallback && multiLayoutForCount(instanceCount, &layout)) {
+		_composeVideo(&layout);
+		videoCallback(compositeBuffer, layout.width, layout.height,
+				layout.width * sizeof(*compositeBuffer));
+	}
+	_submitAudio();
+}
+
+void retro_reset(void) {
+	if (!instanceCount || !_finishDeferredSetup()) {
+		return;
+	}
+	_executeBatch(WORKER_COMMAND_RESET, NULL, NULL);
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		multiSpeedResetPhase(&speedState[i]);
+	}
+	_resetAudioPipeline(true);
+}
+
+size_t retro_serialize_size(void) {
+	return 0;
+}
+
+bool retro_serialize(void* data, size_t size) {
+	UNUSED(data);
+	UNUSED(size);
+	return false;
+}
+
+bool retro_unserialize(const void* data, size_t size) {
+	UNUSED(data);
+	UNUSED(size);
+	return false;
+}
+
+void retro_cheat_reset(void) {
+}
+
+void retro_cheat_set(unsigned index, bool enabled, const char* code) {
+	UNUSED(index);
+	UNUSED(enabled);
+	UNUSED(code);
+}
+
+unsigned retro_get_region(void) {
+	return RETRO_REGION_NTSC;
+}
+
+void retro_set_controller_port_device(unsigned port, unsigned device) {
+	UNUSED(port);
+	UNUSED(device);
+}
+
+void* retro_get_memory_data(unsigned id) {
+	if (id == RETRO_MEMORY_SAVE_RAM && instanceCount) {
+		return saveData;
+	}
+	return NULL;
+}
+
+size_t retro_get_memory_size(unsigned id) {
+	if (id == RETRO_MEMORY_SAVE_RAM && instanceCount) {
+		return sizeof(saveData);
+	}
+	return 0;
+}
diff --git a/src/platform/libretro/libretro_multi_support.c b/src/platform/libretro/libretro_multi_support.c
new file mode 100644
index 0000000000000000000000000000000000000000..db6e9d33c684d6528c20ff55d4cc1550a5a44e73
--- /dev/null
+++ b/src/platform/libretro/libretro_multi_support.c
@@ -0,0 +1,274 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "libretro_multi_support.h"
+
+#include <string.h>
+
+bool multiLayoutForCount(unsigned count, struct MultiLayout* layout) {
+	if (!layout || count < 1 || count > MULTI_MAX_INSTANCES) {
+		return false;
+	}
+
+	memset(layout, 0, sizeof(*layout));
+	switch (count) {
+	case 1:
+		layout->width = MULTI_VIDEO_WIDTH;
+		layout->height = MULTI_VIDEO_HEIGHT;
+		break;
+	case 2:
+		layout->width = MULTI_COMPOSITE_WIDTH;
+		layout->height = MULTI_VIDEO_HEIGHT;
+		layout->placement[1].x = MULTI_VIDEO_WIDTH;
+		break;
+	case 3:
+		layout->width = MULTI_COMPOSITE_WIDTH;
+		layout->height = MULTI_COMPOSITE_HEIGHT;
+		layout->placement[1].x = MULTI_VIDEO_WIDTH;
+		layout->placement[2].x = MULTI_VIDEO_WIDTH / 2;
+		layout->placement[2].y = MULTI_VIDEO_HEIGHT;
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
+
+unsigned multiSpeedParseTarget(const char* value) {
+	if (!value || value[0] < '1' || value[0] > '4' || value[1] != '.' ||
+			value[2] < '0' || value[2] > '9' || value[3] != 'x' || value[4] != '\0') {
+		return MULTI_SPEED_MIN_TENTHS;
+	}
+
+	unsigned targetTenths = (unsigned) (value[0] - '0') * 10U +
+			(unsigned) (value[2] - '0');
+	if (targetTenths < MULTI_SPEED_MIN_TENTHS || targetTenths > MULTI_SPEED_MAX_TENTHS) {
+		return MULTI_SPEED_MIN_TENTHS;
+	}
+	return targetTenths;
+}
+
+void multiSpeedInit(struct MultiSpeedState* speed) {
+	if (!speed) {
+		return;
+	}
+	speed->targetTenths = MULTI_SPEED_DEFAULT_TENTHS;
+	speed->phase = 0;
+	speed->enabled = false;
+	speed->buttonDown = false;
+}
+
+void multiSpeedSetTarget(struct MultiSpeedState* speed, unsigned targetTenths) {
+	if (!speed) {
+		return;
+	}
+	if (targetTenths < MULTI_SPEED_MIN_TENTHS || targetTenths > MULTI_SPEED_MAX_TENTHS) {
+		targetTenths = MULTI_SPEED_MIN_TENTHS;
+	}
+	if (speed->targetTenths == targetTenths) {
+		return;
+	}
+	speed->targetTenths = targetTenths;
+	if (targetTenths == MULTI_SPEED_MIN_TENTHS) {
+		speed->enabled = false;
+	}
+	speed->phase = speed->enabled ? MULTI_SPEED_MIN_TENTHS - 1 : 0;
+}
+
+void multiSpeedResetPhase(struct MultiSpeedState* speed) {
+	if (speed) {
+		speed->phase = speed->enabled ? MULTI_SPEED_MIN_TENTHS - 1 : 0;
+	}
+}
+
+bool multiSpeedHandleR2(struct MultiSpeedState* speed, bool pressed) {
+	if (!speed) {
+		return false;
+	}
+
+	bool rising = pressed && !speed->buttonDown;
+	speed->buttonDown = pressed;
+	if (!rising || speed->targetTenths == MULTI_SPEED_MIN_TENTHS) {
+		return false;
+	}
+	speed->enabled = !speed->enabled;
+	speed->phase = speed->enabled ? MULTI_SPEED_MIN_TENTHS - 1 : 0;
+	return true;
+}
+
+unsigned multiSpeedEffectiveTenths(const struct MultiSpeedState* speed) {
+	if (!speed || !speed->enabled || speed->targetTenths < MULTI_SPEED_MIN_TENTHS ||
+			speed->targetTenths > MULTI_SPEED_MAX_TENTHS) {
+		return MULTI_SPEED_MIN_TENTHS;
+	}
+	return speed->targetTenths;
+}
+
+unsigned multiSpeedNextFrames(struct MultiSpeedState* speed) {
+	if (!speed) {
+		return 1;
+	}
+	speed->phase += multiSpeedEffectiveTenths(speed);
+	unsigned frames = speed->phase / MULTI_SPEED_MIN_TENTHS;
+	speed->phase %= MULTI_SPEED_MIN_TENTHS;
+	return frames;
+}
+
+enum MultiAudioMode multiAudioParseMode(const char* value) {
+	if (!value || !strcmp(value, "Player 1") || !strcmp(value, "player 1")) {
+		return MULTI_AUDIO_PLAYER_1;
+	}
+	if (!strcmp(value, "Player 2") || !strcmp(value, "player 2")) {
+		return MULTI_AUDIO_PLAYER_2;
+	}
+	if (!strcmp(value, "Player 3") || !strcmp(value, "player 3")) {
+		return MULTI_AUDIO_PLAYER_3;
+	}
+	if (!strcmp(value, "Disabled") || !strcmp(value, "disabled")) {
+		return MULTI_AUDIO_DISABLED;
+	}
+	return MULTI_AUDIO_PLAYER_1;
+}
+
+int multiAudioSelectedIndex(enum MultiAudioMode mode, unsigned activeCount) {
+	unsigned index;
+	switch (mode) {
+	case MULTI_AUDIO_PLAYER_1:
+		index = 0;
+		break;
+	case MULTI_AUDIO_PLAYER_2:
+		index = 1;
+		break;
+	case MULTI_AUDIO_PLAYER_3:
+		index = 2;
+		break;
+	case MULTI_AUDIO_DISABLED:
+	default:
+		return -1;
+	}
+	return index < activeCount && index < MULTI_MAX_INSTANCES ? (int) index : -1;
+}
+
+void multiAudioClockReset(struct MultiAudioClock* clock) {
+	if (clock) {
+		clock->remainder = 0;
+	}
+}
+
+size_t multiAudioClockNext(struct MultiAudioClock* clock, unsigned sampleRate,
+		uint32_t frameCycles, uint32_t frequency) {
+	if (!clock || !sampleRate || !frameCycles || !frequency) {
+		return 0;
+	}
+	clock->remainder += (uint64_t) sampleRate * frameCycles;
+	size_t frames = (size_t) (clock->remainder / frequency);
+	clock->remainder %= frequency;
+	return frames;
+}
+
+void multiAudioFifoReset(struct MultiAudioFifo* fifo) {
+	if (!fifo) {
+		return;
+	}
+	fifo->read = 0;
+	fifo->size = 0;
+	fifo->dropped = 0;
+}
+
+void multiAudioFifoPush(struct MultiAudioFifo* fifo, const int16_t* samples, size_t frames) {
+	if (!fifo || !samples || !frames) {
+		return;
+	}
+
+	if (frames >= MULTI_AUDIO_FIFO_FRAMES) {
+		fifo->dropped += fifo->size + frames - MULTI_AUDIO_FIFO_FRAMES;
+		samples += (frames - MULTI_AUDIO_FIFO_FRAMES) * 2;
+		frames = MULTI_AUDIO_FIFO_FRAMES;
+		fifo->read = 0;
+		fifo->size = 0;
+	} else if (fifo->size + frames > MULTI_AUDIO_FIFO_FRAMES) {
+		size_t discard = fifo->size + frames - MULTI_AUDIO_FIFO_FRAMES;
+		fifo->read = (fifo->read + discard) % MULTI_AUDIO_FIFO_FRAMES;
+		fifo->size -= discard;
+		fifo->dropped += discard;
+	}
+
+	size_t write = (fifo->read + fifo->size) % MULTI_AUDIO_FIFO_FRAMES;
+	size_t first = MULTI_AUDIO_FIFO_FRAMES - write;
+	if (first > frames) {
+		first = frames;
+	}
+	memcpy(&fifo->samples[write * 2], samples, first * 2 * sizeof(*samples));
+	if (frames > first) {
+		memcpy(fifo->samples, &samples[first * 2], (frames - first) * 2 * sizeof(*samples));
+	}
+	fifo->size += frames;
+}
+
+bool multiAudioFifoPop(struct MultiAudioFifo* fifo, int16_t* left, int16_t* right) {
+	if (!fifo || !fifo->size || !left || !right) {
+		return false;
+	}
+	*left = fifo->samples[fifo->read * 2];
+	*right = fifo->samples[fifo->read * 2 + 1];
+	fifo->read = (fifo->read + 1) % MULTI_AUDIO_FIFO_FRAMES;
+	--fifo->size;
+	return true;
+}
+
+void multiAudioFifoTrim(struct MultiAudioFifo* fifo, size_t maximumFrames) {
+	if (!fifo || fifo->size <= maximumFrames) {
+		return;
+	}
+	size_t discard = fifo->size - maximumFrames;
+	fifo->read = (fifo->read + discard) % MULTI_AUDIO_FIFO_FRAMES;
+	fifo->size = maximumFrames;
+	fifo->dropped += discard;
+}
+
+static bool _allBytesAre(const uint8_t* data, size_t size, uint8_t value) {
+	for (size_t i = 0; i < size; ++i) {
+		if (data[i] != value) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool multiSaveRestoreRtc(uint8_t* slot, size_t slotSize, size_t actualOffset,
+		size_t canonicalOffset, size_t rtcSize) {
+	if (!slot || !rtcSize || actualOffset > slotSize || canonicalOffset > slotSize ||
+			rtcSize > slotSize - actualOffset || rtcSize > slotSize - canonicalOffset) {
+		return false;
+	}
+
+	uint8_t* actual = &slot[actualOffset];
+	uint8_t* canonical = &slot[canonicalOffset];
+	if (!_allBytesAre(canonical, rtcSize, 0xFF)) {
+		if (actual != canonical) {
+			memcpy(actual, canonical, rtcSize);
+		}
+		return true;
+	}
+	if (_allBytesAre(actual, rtcSize, 0xFF)) {
+		return false;
+	}
+	if (actual != canonical) {
+		memcpy(canonical, actual, rtcSize);
+	}
+	return true;
+}
+
+bool multiSaveMirrorRtc(uint8_t* slot, size_t slotSize, size_t actualOffset,
+		size_t canonicalOffset, size_t rtcSize) {
+	if (!slot || !rtcSize || actualOffset > slotSize || canonicalOffset > slotSize ||
+			rtcSize > slotSize - actualOffset || rtcSize > slotSize - canonicalOffset) {
+		return false;
+	}
+	if (actualOffset != canonicalOffset) {
+		memcpy(&slot[canonicalOffset], &slot[actualOffset], rtcSize);
+	}
+	return true;
+}
