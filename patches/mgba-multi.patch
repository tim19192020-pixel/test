+#define MULTI_SPEED_DEFAULT_TENTHS 20
+#define MULTI_SPEED_ONE MULTI_SPEED_MIN_TENTHS
+#define MULTI_SPEED_DEFAULT MULTI_SPEED_DEFAULT_TENTHS
+#define MULTI_SPEED_MAX_FRAMES (MULTI_SPEED_MAX_TENTHS / MULTI_SPEED_MIN_TENTHS)
+
+#define MULTI_DIALOGUE_MIN_TENTHS 50
+#define MULTI_DIALOGUE_MAX_TENTHS 200
+#define MULTI_DIALOGUE_DEFAULT_TENTHS 100
+#define MULTI_DIALOGUE_MAX_FRAMES (MULTI_DIALOGUE_MAX_TENTHS / MULTI_SPEED_MIN_TENTHS)
+
+struct MultiPlacement {
