+			fixture->profile->isHidden + 4U);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, ROM_BASE - 1U);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			ROM_BASE + ROM_SIZE);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script, 0x6C);
+	assertBlocked(fixture);
+
+	/* Only exact waits in the four non-choice standard msgbox scripts qualify.
+	 * An arbitrary byte-identical wait and the standard yes/no command fail closed. */
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			ROM_BASE + 0x10000U);
+	write8(fixture->rom, ROM_BASE, ROM_BASE + 0x10000U, 0x6D);
+	write8(fixture->rom, ROM_BASE, ROM_BASE + 0x10001U, 0x02);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->yesNoCommand);
+	write8(fixture->rom, ROM_BASE, fixture->profile->yesNoCommand, 0x6E);
+	write8(fixture->rom, ROM_BASE, fixture->profile->yesNoCommand + 1U, 0x02);
+	assertBlocked(fixture);
+
+	/* Text directly preceding a choice, battle, native/special call, scripted
+	 * encounter, or unknown continuation is never armed. */
+	static const uint8_t unsafeContinuations[] = {
+		0x00, /* nop/unknown continuation */
+		0x04, /* call */
+		0x05, /* goto */
+		0x06, /* conditional goto */
+		0x07, /* conditional call */
+		0x08, /* gotostd */
+		0x0A, /* conditional gotostd */
+		0x0B, /* conditional callstd */
+		0x0C, /* returnram */
+		0x23, /* callnative */
+		0x24, /* gotonative */
+		0x25, /* special (including scripted legendary starts) */
+		0x26, /* specialvar */
+		0x27, /* waitstate */
+		0x5C, /* trainerbattle */
+		0x5D, /* dotrainerbattle */
+		0x5E, /* gotopostbattlescript */
+		0x5F, /* gotobeatenscript */
+		0x6E, /* yesnobox */
+		0x6F, /* multichoice */
+		0x70, /* multichoicedefault */
+		0x71, /* multichoicegrid */
+		0x86, /* pokemart */
+		0x87, /* pokemartdecoration */
+		0x88, /* pokemartdecoration2 */
+		0x89, /* playslotmachine */
+		0x8B, /* choosecontestmon */
+		0x8C, /* startcontest */
+		0x8D, /* showcontestresults */
+		0x8E, /* contestlinktransfer */
+		0xB1, /* addelevmenuitem */
+		0xB2, /* showelevmenu */
+		0xB6, /* setwildbattle */
+		0xB7, /* dowildbattle */
+		0xB8, /* setvaddress */
+		0xB9, /* vgoto */
+		0xBA, /* vcall */
+		0xBB, /* vgoto_if */
+		0xBC, /* vcall_if */
+		0xBD, /* vmessage */
+		0xBE, /* vbuffermessage */
+		0xBF, /* vbufferstring */
+		0xCF, /* trywondercardscript / RAM-script control */
+	};
+	for (size_t i = 0;
+			i < sizeof(unsafeContinuations) / sizeof(*unsafeContinuations); ++i) {
+		setOrdinary(fixture, 0);
+		write8(fixture->rom, ROM_BASE, fixture->script + 1U,
+				unsafeContinuations[i]);
+		assertBlocked(fixture);
+	}
+
+	/* A callstd message is accepted only if every nested return path closes and
+	 * terminates. A dangerous caller continuation fails closed. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK + 4U,
+			fixture->script + 0x20U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->script + 0x40U);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x20U, 0x6C);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x21U, 0x03);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x40U, 0x02);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	assert(fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 1);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->script + 0x20U);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x20U, 0x5C);
+	assertBlocked(fixture);
+
+	/* A standard msgbox nested under the fixed trainer-script range is blocked
+	 * even if its immediate continuation looks cosmetic. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 1);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->profile->trainerStart);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerStart, 0x02);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 19);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 20);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 1);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK, ROM_BASE - 1U);
+	assertBlocked(fixture);
+
+	/* The message-tail cache is tied to the actual return stack, not only its
+	 * depth. A changed continuation is reclassified before another fast frame. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 1);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->script + 0x20U);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x20U, 0x02);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->script + 0x40U);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x40U, 0x6F);
+	assertBlocked(fixture);
+
+	/* Exact stack snapshots, rather than a 32-bit fingerprint, prevent a cached
+	 * terminal verdict from crossing even a deliberately colliding stack pair. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK, 0x08010000U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK + 4U, 0x08010100U);
+	write8(fixture->rom, ROM_BASE, 0x08010100U, 0x03);
+	write8(fixture->rom, ROM_BASE, 0x08010000U, 0x02);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	assert(fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK, 0x08034004U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK + 4U, 0x08B44ACCU);
+	write8(fixture->rom, ROM_BASE, 0x08B44ACCU, 0x6F);
+	assertBlocked(fixture);
+	assert(fixture->detector.cachedTailValid);
+	/* The preserved immutable-tail cache must also reject the colliding key. */
+	assertBlocked(fixture);
+
+	/* Even a syntactically harmless but corrupt non-terminating continuation is
+	 * bounded and rejected instead of being followed indefinitely. */
+	setOrdinary(fixture, 0);
+	for (unsigned offset = 1; offset < 64; ++offset) {
+		write8(fixture->rom, ROM_BASE, fixture->script + offset, 0x6C);
+	}
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->ewram, EWRAM_BASE, MESSAGE_BOX_TYPE, 3);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->ewram, EWRAM_BASE, PRINTER_ACTIVE, 0);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	setTask(fixture, 0, fixture->profile->taskDraw, false);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->trainerStart);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerStart, 0x6D);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->trainerEnd - 1U);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerEnd - 1U, 0x6D);
+	assertBlocked(fixture);
+
+	/* The exclusive end of the trainer range is not itself blocked when it is
+	 * reached through the return stack of an exact standard msgbox. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 1);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->profile->trainerEnd);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerEnd, 0x02);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+
+	setOrdinary(fixture, 0);
+	setTask(fixture, 1, fixture->profile->taskBattle | 1U, true);
+	assertBlocked(fixture);
+
+	for (unsigned choice = 0; choice < 3; ++choice) {
+		setOrdinary(fixture, 0);
+		setTask(fixture, choice + 1, fixture->profile->choices[choice] | 1U,
+				true);
+		assertBlocked(fixture);
+	}
+
+	/* Inactive task slots do not inherit stale function pointers. */
+	setOrdinary(fixture, 0);
+	setTask(fixture, 1, fixture->profile->taskBattle | 1U, false);
+	setTask(fixture, 2, fixture->profile->choices[0] | 1U, false);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+}
