+static void testExactAudioClock(void) {
+	struct MultiAudioClock clock;
+	multiAudioClockReset(&clock);
+	const size_t expected[] = { 1097, 1097, 1097, 1098 };
+	size_t total = 0;
+	for (size_t i = 0; i < 4; ++i) {
+		size_t frames = multiAudioClockNext(&clock, 65536, 280896, 16777216);
+		assert(frames == expected[i]);
+		total += frames;
+	}
+	assert(total == 4389);
+
+	multiAudioClockReset(&clock);
+	total = 0;
+	for (unsigned i = 0; i < 6000; ++i) {
+		total += multiAudioClockNext(&clock, 65536, 280896, 16777216);
+	}
+	uint64_t exact = (uint64_t) 65536 * 280896 * 6000 / 16777216;
+	assert(total == exact);
+	assert(clock.remainder < 16777216);
+}
