+
+void* retro_get_memory_data(unsigned id) {
+	if (!instanceCount || !instances[0].core) {
+		return NULL;
+	}
+	if (id == RETRO_MEMORY_SAVE_RAM) {
+		return instances[0].saveData;
+	}
+	if (id == RETRO_MEMORY_RTC && _rtcSize(&instances[0])) {
+		return &instances[0].saveData[_saveRamSize(&instances[0])];
+	}
+	return NULL;
+}
+
+size_t retro_get_memory_size(unsigned id) {
+	if (!instanceCount || !instances[0].core) {
