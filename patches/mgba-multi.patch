+static void testIvCheckerUnsupportedAndReset(void) {
+	struct MultiIvCheckerState state;
+	multiIvCheckerInit(&state);
+
+	/* Unsupported content always hides and clears pending work. It also tracks
+	 * the physical button, so support appearing under a held X cannot toggle. */
+	state.visible = true;
+	state.refreshCountdown = 7;
+	assert(multiIvCheckerHandleX(&state, true, false) ==
+			MULTI_IV_CHECKER_TOGGLE_UNAVAILABLE);
+	assert(!state.visible && state.buttonDown && state.refreshCountdown == 0);
+	assert(multiIvCheckerHandleX(&state, true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+	assert(!state.visible);
+	assert(multiIvCheckerHandleX(&state, false, true) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+	assert(multiIvCheckerHandleX(&state, true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_SHOWN);
+	assert(multiIvCheckerShouldRefresh(&state));
+
+	/* A core reset invalidates cached values and requests an immediate refresh
+	 * without changing visibility or the X-edge latch. */
+	for (unsigned frame = 1; frame < 5; ++frame) {
+		assert(!multiIvCheckerShouldRefresh(&state));
+	}
+	unsigned previousCountdown = state.refreshCountdown;
+	assert(previousCountdown > 0);
+	multiIvCheckerRequestRefresh(&state);
+	assert(state.visible && state.buttonDown && state.refreshCountdown == 0);
+	assert(multiIvCheckerShouldRefresh(&state));
+
+	/* A reset request while hidden remains dormant until a later show edge. */
+	assert(multiIvCheckerHandleX(&state, false, true) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+	assert(multiIvCheckerHandleX(&state, true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_HIDDEN);
+	state.refreshCountdown = 9;
+	multiIvCheckerRequestRefresh(&state);
+	assert(state.refreshCountdown == 0);
+	assert(!multiIvCheckerShouldRefresh(&state));
+
+	/* Loss of support hides without spamming an unavailable message. A later
+	 * unsupported rising edge reports the error exactly once. */
+	assert(multiIvCheckerHandleX(&state, false, false) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+	assert(!state.visible && !state.buttonDown && state.refreshCountdown == 0);
+	assert(multiIvCheckerHandleX(&state, true, false) ==
+			MULTI_IV_CHECKER_TOGGLE_UNAVAILABLE);
+	assert(multiIvCheckerHandleX(&state, true, false) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+
+	/* Defensive null handling is inert and deterministic. */
+	multiIvCheckerInit(NULL);
+	multiIvCheckerRequestRefresh(NULL);
+	assert(!multiIvCheckerShouldRefresh(NULL));
+	assert(multiIvCheckerHandleX(NULL, true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_NONE);
+}
