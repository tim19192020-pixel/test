+static void speedTargetString(unsigned targetTenths, char value[5]) {
+	value[0] = (char) ('0' + targetTenths / 10);
+	value[1] = '.';
+	value[2] = (char) ('0' + targetTenths % 10);
+	value[3] = 'x';
+	value[4] = '\0';
+}
+
+static void testLayouts(void) {
+	struct MultiLayout layout;
+	assert(!multiLayoutForCount(0, &layout));
+	assert(!multiLayoutForCount(4, &layout));
+
+	assert(multiLayoutForCount(1, &layout));
+	assert(layout.width == 240 && layout.height == 160);
+	assert(layout.placement[0].x == 0 && layout.placement[0].y == 0);
+
+	assert(multiLayoutForCount(2, &layout));
+	assert(layout.width == 480 && layout.height == 160);
+	assert(layout.placement[0].x == 0 && layout.placement[0].y == 0);
+	assert(layout.placement[1].x == 240 && layout.placement[1].y == 0);
+
+	assert(multiLayoutForCount(3, &layout));
+	assert(layout.width == 480 && layout.height == 320);
+	assert(layout.placement[0].x == 0 && layout.placement[0].y == 0);
+	assert(layout.placement[1].x == 240 && layout.placement[1].y == 0);
+	assert(layout.placement[2].x == 120 && layout.placement[2].y == 160);
+}
+
+static void testSpeedTargetParsing(void) {
+	char value[5];
+	for (unsigned target = MULTI_SPEED_MIN_TENTHS;
+			target <= MULTI_SPEED_MAX_TENTHS; ++target) {
+		speedTargetString(target, value);
+		assert(multiSpeedParseTarget(value) == target);
+	}
+
+	static const char* invalid[] = {
+		"", "1", "1x", "1.0", "1.00x", "0.9x", "4.1x", "10.0x",
+		"1.0X", " 1.0x", "1.0x ", "fast", "Player 1",
+	};
+	assert(multiSpeedParseTarget(NULL) == MULTI_SPEED_MIN_TENTHS);
+	for (size_t i = 0; i < sizeof(invalid) / sizeof(*invalid); ++i) {
+		assert(multiSpeedParseTarget(invalid[i]) == MULTI_SPEED_MIN_TENTHS);
+	}
+}
+
+static void enableSpeed(struct MultiSpeedState* speed, unsigned targetTenths) {
+	multiSpeedInit(speed);
+	multiSpeedSetTarget(speed, targetTenths);
+	if (targetTenths > MULTI_SPEED_MIN_TENTHS) {
+		assert(multiSpeedHandleR2(speed, true));
+		assert(!multiSpeedHandleR2(speed, false));
+	}
+}
+
+static void testEverySpeedSchedule(void) {
+	for (unsigned target = MULTI_SPEED_MIN_TENTHS;
+			target <= MULTI_SPEED_MAX_TENTHS; ++target) {
+		struct MultiSpeedState speed;
+		enableSpeed(&speed, target);
+		assert(multiSpeedEffectiveTenths(&speed) == target);
+
+		unsigned total = 0;
+		for (unsigned tick = 0; tick < 1000; ++tick) {
+			unsigned frames = multiSpeedNextFrames(&speed);
+			assert(frames >= 1 && frames <= 4);
+			total += frames;
+		}
+		assert(total == target * 100);
+		assert(speed.phase == (target > MULTI_SPEED_MIN_TENTHS ? 9U : 0U));
+	}
+
+	struct MultiSpeedState speed;
+	enableSpeed(&speed, 11);
+	assert(multiSpeedNextFrames(&speed) == 2);
+	for (unsigned tick = 0; tick < 9; ++tick) {
+		assert(multiSpeedNextFrames(&speed) == 1);
+	}
+
+	enableSpeed(&speed, 40);
+	for (unsigned tick = 0; tick < 100; ++tick) {
+		assert(multiSpeedNextFrames(&speed) == 4);
+	}
+}
+
+static void testSpeedStateAndR2Edges(void) {
+	struct MultiSpeedState speed;
+	multiSpeedInit(&speed);
+	assert(speed.targetTenths == MULTI_SPEED_DEFAULT_TENTHS);
+	assert(speed.phase == 0);
+	assert(!speed.enabled);
+	assert(!speed.buttonDown);
+	assert(multiSpeedEffectiveTenths(&speed) == MULTI_SPEED_MIN_TENTHS);
+	assert(multiSpeedNextFrames(&speed) == 1);
+
+	multiSpeedSetTarget(&speed, 27);
+	assert(speed.targetTenths == 27);
+	assert(!speed.enabled);
+	assert(multiSpeedHandleR2(&speed, true));
+	assert(speed.enabled);
+	assert(multiSpeedEffectiveTenths(&speed) == 27);
+	assert(!multiSpeedHandleR2(&speed, true));
+	assert(speed.enabled);
+	assert(!multiSpeedHandleR2(&speed, false));
+	assert(multiSpeedHandleR2(&speed, true));
+	assert(!speed.enabled);
+	assert(speed.phase == 0);
+	assert(!multiSpeedHandleR2(&speed, true));
+	assert(!multiSpeedHandleR2(&speed, false));
+
+	/* A 1.0x target cannot be armed and changing to it disarms speed-up. */
+	multiSpeedSetTarget(&speed, 27);
+	assert(multiSpeedHandleR2(&speed, true));
+	assert(!multiSpeedHandleR2(&speed, false));
+	assert(speed.enabled);
+	(void) multiSpeedNextFrames(&speed);
+	assert(speed.phase != 0);
+	multiSpeedSetTarget(&speed, 10);
+	assert(!speed.enabled);
+	assert(speed.phase == 0);
+	assert(!multiSpeedHandleR2(&speed, true));
+	assert(!multiSpeedHandleR2(&speed, false));
+	assert(multiSpeedEffectiveTenths(&speed) == 10);
+
+	/* Invalid programmatic values are made safe in the same way. */
+	multiSpeedSetTarget(&speed, 9);
+	assert(speed.targetTenths == 10);
+	multiSpeedSetTarget(&speed, 41);
+	assert(speed.targetTenths == 10);
+
+	/* Setting the same target preserves fractional progress; a change resets it. */
+	enableSpeed(&speed, 13);
+	assert(multiSpeedNextFrames(&speed) == 2);
+	assert(speed.phase == 2);
+	multiSpeedSetTarget(&speed, 13);
+	assert(speed.phase == 2);
+	multiSpeedSetTarget(&speed, 14);
+	assert(speed.phase == 9);
+	multiSpeedResetPhase(&speed);
+	assert(speed.phase == 9);
+}
+
+static void testIndependentSpeedStates(void) {
+	struct MultiSpeedState speed[MULTI_MAX_INSTANCES];
+	for (unsigned i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		multiSpeedInit(&speed[i]);
+		multiSpeedSetTarget(&speed[i], 15 + i * 10);
+	}
+
+	assert(multiSpeedHandleR2(&speed[1], true));
+	assert(!multiSpeedHandleR2(&speed[1], true));
+	assert(!speed[0].enabled && speed[1].enabled && !speed[2].enabled);
+	assert(multiSpeedEffectiveTenths(&speed[0]) == 10);
+	assert(multiSpeedEffectiveTenths(&speed[1]) == 25);
+	assert(multiSpeedEffectiveTenths(&speed[2]) == 10);
+
+	assert(multiSpeedHandleR2(&speed[2], true));
+	assert(!multiSpeedHandleR2(&speed[2], false));
+	assert(!speed[0].enabled && speed[1].enabled && speed[2].enabled);
+	assert(multiSpeedEffectiveTenths(&speed[2]) == 35);
+
+	assert(!multiSpeedHandleR2(&speed[1], false));
+	assert(multiSpeedHandleR2(&speed[1], true));
+	assert(!speed[1].enabled && speed[2].enabled);
+}
+
+static void testDialogueOptionsAndL2Edges(void) {
+	for (unsigned multiplier = 5; multiplier <= 20; ++multiplier) {
+		char value[4];
+		if (multiplier < 10) {
+			value[0] = (char) ('0' + multiplier);
+			value[1] = 'x';
+			value[2] = '\0';
+		} else {
+			value[0] = (char) ('0' + multiplier / 10);
+			value[1] = (char) ('0' + multiplier % 10);
+			value[2] = 'x';
+			value[3] = '\0';
+		}
+		assert(multiDialogueParseTarget(value) == multiplier * 10);
+	}
+	static const char* invalid[] = {
+		"", "4x", "21x", "10", "10.0x", "010x", "10X", " 10x", "10x ", "fast",
+	};
+	assert(multiDialogueParseTarget(NULL) == MULTI_DIALOGUE_DEFAULT_TENTHS);
+	for (size_t i = 0; i < sizeof(invalid) / sizeof(*invalid); ++i) {
+		assert(multiDialogueParseTarget(invalid[i]) == MULTI_DIALOGUE_DEFAULT_TENTHS);
+	}
+
+	struct MultiDialogueToggleState state;
+	multiDialogueToggleInit(&state);
+	assert(!state.enabled && !state.buttonDown);
+	assert(multiDialogueHandleL2(&state, true, true) == MULTI_DIALOGUE_TOGGLE_ENABLED);
+	assert(state.enabled && state.buttonDown);
+	assert(multiDialogueHandleL2(&state, true, true) == MULTI_DIALOGUE_TOGGLE_NONE);
+	assert(multiDialogueHandleL2(&state, false, true) == MULTI_DIALOGUE_TOGGLE_NONE);
+	assert(multiDialogueHandleL2(&state, true, true) == MULTI_DIALOGUE_TOGGLE_DISABLED);
+	assert(!state.enabled);
+	assert(multiDialogueHandleL2(&state, false, true) == MULTI_DIALOGUE_TOGGLE_NONE);
+	assert(multiDialogueHandleL2(&state, true, false) == MULTI_DIALOGUE_TOGGLE_UNAVAILABLE);
+	assert(!state.enabled);
+	assert(multiDialogueHandleL2(&state, true, true) == MULTI_DIALOGUE_TOGGLE_NONE);
+	assert(multiDialogueHandleL2(&state, false, true) == MULTI_DIALOGUE_TOGGLE_NONE);
+	assert(multiDialogueHandleL2(&state, true, true) == MULTI_DIALOGUE_TOGGLE_ENABLED);
+}
+
+static void testAudioRoutes(void) {
+	assert(multiAudioParseMode(NULL) == MULTI_AUDIO_PLAYER_1);
+	assert(multiAudioParseMode("Player 1") == MULTI_AUDIO_PLAYER_1);
+	assert(multiAudioParseMode("Player 2") == MULTI_AUDIO_PLAYER_2);
+	assert(multiAudioParseMode("Player 3") == MULTI_AUDIO_PLAYER_3);
+	assert(multiAudioParseMode("Disabled") == MULTI_AUDIO_DISABLED);
+	assert(multiAudioParseMode("player 2") == MULTI_AUDIO_PLAYER_2);
+	assert(multiAudioParseMode("player 3") == MULTI_AUDIO_PLAYER_3);
+	assert(multiAudioParseMode("disabled") == MULTI_AUDIO_DISABLED);
+	assert(multiAudioParseMode("") == MULTI_AUDIO_PLAYER_1);
+	assert(multiAudioParseMode("Mix") == MULTI_AUDIO_PLAYER_1);
+	assert(multiAudioParseMode("player 1") == MULTI_AUDIO_PLAYER_1);
+
+	static const enum MultiAudioMode modes[] = {
+		MULTI_AUDIO_PLAYER_1,
+		MULTI_AUDIO_PLAYER_2,
+		MULTI_AUDIO_PLAYER_3,
+	};
+	for (unsigned count = 0; count <= MULTI_MAX_INSTANCES + 1; ++count) {
+		for (unsigned player = 0; player < MULTI_MAX_INSTANCES; ++player) {
+			int expected = player < count && player < MULTI_MAX_INSTANCES ?
+					(int) player : -1;
+			assert(multiAudioSelectedIndex(modes[player], count) == expected);
+		}
+		assert(multiAudioSelectedIndex(MULTI_AUDIO_DISABLED, count) == -1);
+		assert(multiAudioSelectedIndex((enum MultiAudioMode) 99, count) == -1);
+	}
+}
+
+static void testExactAudioClock(void) {
+	struct MultiAudioClock clock;
+	multiAudioClockReset(&clock);
+	const size_t expected[] = { 1097, 1097, 1097, 1098 };
+	size_t total = 0;
+	for (size_t i = 0; i < 4; ++i) {
+		size_t frames = multiAudioClockNext(&clock, 65536, 280896, 16777216);
+		assert(frames == expected[i]);
+		total += frames;
+	}
+	assert(total == 4389);
+
+	multiAudioClockReset(&clock);
+	total = 0;
+	for (unsigned i = 0; i < 6000; ++i) {
+		total += multiAudioClockNext(&clock, 65536, 280896, 16777216);
+	}
+	uint64_t exact = (uint64_t) 65536 * 280896 * 6000 / 16777216;
+	assert(total == exact);
+	assert(clock.remainder < 16777216);
+}
+
+static void testBoundedAudioFifo(void) {
+	struct MultiAudioFifo fifo;
+	multiAudioFifoReset(&fifo);
+	int16_t first[] = { 1, -1, 2, -2, 3, -3 };
+	multiAudioFifoPush(&fifo, first, 3);
+	for (int16_t i = 1; i <= 3; ++i) {
+		int16_t left;
+		int16_t right;
+		assert(multiAudioFifoPop(&fifo, &left, &right));
+		assert(left == i && right == -i);
+	}
+	int16_t left;
+	int16_t right;
+	assert(!multiAudioFifoPop(&fifo, &left, &right));
+
+	const size_t frames = MULTI_AUDIO_FIFO_FRAMES + 7;
+	int16_t* samples = malloc(frames * 2 * sizeof(*samples));
+	assert(samples);
+	for (size_t i = 0; i < frames; ++i) {
+		samples[i * 2] = (int16_t) i;
+		samples[i * 2 + 1] = (int16_t) ~i;
+	}
+	multiAudioFifoPush(&fifo, samples, frames);
+	assert(fifo.size == MULTI_AUDIO_FIFO_FRAMES);
+	assert(fifo.dropped == 7);
+	assert(multiAudioFifoPop(&fifo, &left, &right));
+	assert(left == 7 && right == (int16_t) ~7);
+	multiAudioFifoTrim(&fifo, 32);
+	assert(fifo.size == 32);
+	assert(fifo.dropped == 7 + MULTI_AUDIO_FIFO_FRAMES - 1 - 32);
+	assert(multiAudioFifoPop(&fifo, &left, &right));
+	assert(left == (int16_t) (frames - 32));
+	assert(right == (int16_t) ~(frames - 32));
+	free(samples);
+}
+
+static void testRtcCanonicalization(void) {
+	enum { SLOT_SIZE = 80, RTC_SIZE = 16, ACTUAL_OFFSET = 24, CANONICAL_OFFSET = 64 };
+	uint8_t slot[SLOT_SIZE];
+	memset(slot, 0xFF, sizeof(slot));
+	assert(!multiSaveRestoreRtc(slot, sizeof(slot), ACTUAL_OFFSET,
+			CANONICAL_OFFSET, RTC_SIZE));
+
+	for (unsigned i = 0; i < RTC_SIZE; ++i) {
+		slot[ACTUAL_OFFSET + i] = (uint8_t) i;
+	}
+	assert(multiSaveRestoreRtc(slot, sizeof(slot), ACTUAL_OFFSET,
+			CANONICAL_OFFSET, RTC_SIZE));
+	assert(memcmp(&slot[ACTUAL_OFFSET], &slot[CANONICAL_OFFSET], RTC_SIZE) == 0);
+
+	for (unsigned i = 0; i < RTC_SIZE; ++i) {
+		slot[CANONICAL_OFFSET + i] = (uint8_t) (0x80 + i);
+		slot[ACTUAL_OFFSET + i] = 0;
+	}
+	assert(multiSaveRestoreRtc(slot, sizeof(slot), ACTUAL_OFFSET,
+			CANONICAL_OFFSET, RTC_SIZE));
+	assert(memcmp(&slot[ACTUAL_OFFSET], &slot[CANONICAL_OFFSET], RTC_SIZE) == 0);
+
+	memset(&slot[ACTUAL_OFFSET], 0x5A, RTC_SIZE);
+	assert(multiSaveMirrorRtc(slot, sizeof(slot), ACTUAL_OFFSET,
+			CANONICAL_OFFSET, RTC_SIZE));
+	assert(memcmp(&slot[ACTUAL_OFFSET], &slot[CANONICAL_OFFSET], RTC_SIZE) == 0);
+	assert(!multiSaveMirrorRtc(slot, sizeof(slot), SLOT_SIZE - 4,
+			CANONICAL_OFFSET, RTC_SIZE));
+}
