+	info->library_name = "mGBA Multi";
+	info->library_version = libraryVersion;
+#if defined(M_CORE_GBA) && defined(M_CORE_GB)
+	info->valid_extensions = "gba|gb|gbc|sgb";
+#elif defined(M_CORE_GB)
