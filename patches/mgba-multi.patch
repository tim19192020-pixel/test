+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "libretro_firered_dialogue.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define EWRAM_BASE 0x02000000U
+#define EWRAM_SIZE 0x00040000U
+#define IWRAM_BASE 0x03000000U
+#define IWRAM_SIZE 0x00008000U
+#define ROM_BASE 0x08000000U
+#define ROM_SIZE 0x01000000U
+
+#define TEXT_PRINTER_0 0x02020034U
+#define PRINTER_ACTIVE (TEXT_PRINTER_0 + 0x1BU)
+#define PRINTER_STATE (TEXT_PRINTER_0 + 0x1CU)
+#define MESSAGE_BOX_TYPE 0x0203709CU
+#define CONTEXT_STATUS 0x03000EA8U
+#define CONTEXT 0x03000EB0U
+#define CONTEXT_STACK_DEPTH (CONTEXT + 0U)
+#define CONTEXT_MODE (CONTEXT + 1U)
+#define CONTEXT_NATIVE (CONTEXT + 4U)
+#define CONTEXT_SCRIPT (CONTEXT + 8U)
+#define CONTEXT_STACK (CONTEXT + 12U)
+#define MAIN 0x030030F0U
+#define MAIN_CALLBACK2 (MAIN + 4U)
+#define MAIN_IN_BATTLE (MAIN + 0x439U)
+#define TASKS 0x03005090U
+#define TASK_STRIDE 0x28U
+#define TASK_ACTIVE_OFFSET 4U
+
+static const uint8_t sha10[20] = {
+	0x41, 0xCB, 0x23, 0xD8, 0xDC, 0xCC, 0x8E, 0xBD, 0x7C, 0x64,
+	0x9C, 0xD8, 0xFB, 0xB5, 0x8E, 0xEA, 0xCE, 0x6E, 0x2F, 0xDC,
+};
+
+static const uint8_t sha11[20] = {
+	0xDD, 0x59, 0x45, 0xDB, 0x9B, 0x93, 0x07, 0x50, 0xCB, 0x39,
+	0xD0, 0x0C, 0x84, 0xDA, 0x85, 0x71, 0xFE, 0xEB, 0xF4, 0x17,
+};
+
+struct TestProfile {
+	const uint8_t* sha1;
+	enum FireRedDialogueProfile id;
+	uint32_t callback2;
+	uint32_t taskDraw;
+	uint32_t isHidden;
+	uint32_t waitAorB;
+	uint32_t taskBattle;
+	uint32_t choices[3];
+	uint32_t trainerStart;
+	uint32_t trainerEnd;
+};
+
+static const struct TestProfile profiles[] = {
+	{
+		.sha1 = sha10,
+		.id = FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+		.callback2 = 0x080565B4U,
+		.taskDraw = 0x08069370U,
+		.isHidden = 0x0806951CU,
+		.waitAorB = 0x0806B898U,
+		.taskBattle = 0x0807F620U,
+		.choices = { 0x0809CC98U, 0x0809CE54U, 0x0809CFDCU },
+		.trainerStart = 0x081A4EB4U,
+		.trainerEnd = 0x081A501FU,
+	},
+	{
+		.sha1 = sha11,
+		.id = FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1,
+		.callback2 = 0x080565C8U,
+		.taskDraw = 0x08069384U,
+		.isHidden = 0x08069530U,
+		.waitAorB = 0x0806B8ACU,
+		.taskBattle = 0x0807F634U,
+		.choices = { 0x0809CCACU, 0x0809CE68U, 0x0809CFF0U },
+		.trainerStart = 0x081A4F2CU,
+		.trainerEnd = 0x081A5097U,
+	},
+};
+
+struct Fixture {
+	uint8_t* ewram;
+	uint8_t* iwram;
+	uint8_t* rom;
+	struct FireRedDialogueDetector detector;
+	const struct TestProfile* profile;
+	uint32_t script;
+};
+
+static void write8(uint8_t* memory, uint32_t base, uint32_t address,
+		uint8_t value) {
+	memory[address - base] = value;
+}
+
+static void write32(uint8_t* memory, uint32_t base, uint32_t address,
+		uint32_t value) {
+	size_t offset = address - base;
+	memory[offset] = (uint8_t) value;
+	memory[offset + 1] = (uint8_t) (value >> 8);
+	memory[offset + 2] = (uint8_t) (value >> 16);
+	memory[offset + 3] = (uint8_t) (value >> 24);
+}
+
+static uint32_t taskAddress(unsigned task) {
+	return TASKS + task * TASK_STRIDE;
+}
+
+static void setTask(struct Fixture* fixture, unsigned task, uint32_t function,
+		bool active) {
+	write32(fixture->iwram, IWRAM_BASE, taskAddress(task), function);
+	write8(fixture->iwram, IWRAM_BASE,
+			taskAddress(task) + TASK_ACTIVE_OFFSET, active ? 1 : 0);
+}
+
+static void setOrdinary(struct Fixture* fixture, uint8_t printerState) {
+	memset(fixture->ewram, 0, EWRAM_SIZE);
+	memset(fixture->iwram, 0, IWRAM_SIZE);
+	memset(fixture->rom, 0, ROM_SIZE);
+	write32(fixture->iwram, IWRAM_BASE, MAIN_CALLBACK2,
+			fixture->profile->callback2 | 1U);
+	write8(fixture->iwram, IWRAM_BASE, MAIN_IN_BATTLE, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STATUS, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->isHidden | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, fixture->script);
+	write8(fixture->rom, ROM_BASE, fixture->script, 0x6D);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x02);
+	write8(fixture->ewram, EWRAM_BASE, MESSAGE_BOX_TYPE, 2);
+	write8(fixture->ewram, EWRAM_BASE, PRINTER_ACTIVE, 1);
+	write8(fixture->ewram, EWRAM_BASE, PRINTER_STATE, printerState);
+	setTask(fixture, 0, fixture->profile->taskDraw | 1U, true);
+	fireRedDialogueReset(&fixture->detector);
+}
+
+static void initFixture(struct Fixture* fixture,
+		const struct TestProfile* profile) {
+	memset(fixture, 0, sizeof(*fixture));
+	fixture->ewram = calloc(1, EWRAM_SIZE);
+	fixture->iwram = calloc(1, IWRAM_SIZE);
+	fixture->rom = calloc(1, ROM_SIZE);
+	assert(fixture->ewram && fixture->iwram && fixture->rom);
+	fixture->profile = profile;
+	fixture->script = ROM_BASE + 0x10000U;
+	fireRedDialogueInit(&fixture->detector, profile->id,
+			fixture->ewram, EWRAM_SIZE, fixture->iwram, IWRAM_SIZE,
+			fixture->rom, ROM_SIZE);
+	assert(fixture->detector.profile == profile->id);
+	setOrdinary(fixture, 0);
+}
+
+static void deinitFixture(struct Fixture* fixture) {
+	free(fixture->ewram);
+	free(fixture->iwram);
+	free(fixture->rom);
+}
+
+static void assertBlocked(struct Fixture* fixture) {
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_BLOCKED);
+	assert(!fixture->detector.sessionArmed);
+	fireRedDialogueConsumeTerminal(&fixture->detector);
+	assert(fixture->detector.lastState == FIRERED_DIALOGUE_BLOCKED);
+}
+
+static void testHashesAndBounds(void) {
+	uint8_t* ewram = calloc(1, EWRAM_SIZE);
+	uint8_t* iwram = calloc(1, IWRAM_SIZE);
+	uint8_t* rom = calloc(1, ROM_SIZE);
+	assert(ewram && iwram && rom);
+	struct FireRedDialogueDetector detector;
+	uint8_t unsupported[20] = { 0 };
+
+	assert(fireRedDialogueProfileFromSha1(sha10) ==
+			FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0);
+	assert(fireRedDialogueProfileFromSha1(sha11) ==
+			FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1);
+	assert(fireRedDialogueProfileFromSha1(NULL) ==
+			FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	assert(fireRedDialogueProfileFromSha1(unsupported) ==
+			FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	assert(!fireRedDialogueProfileSupported(FIRERED_DIALOGUE_PROFILE_UNSUPPORTED));
+	assert(fireRedDialogueProfileSupported(FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0));
+	assert(fireRedDialogueProfileSupported(FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1));
+	assert(!fireRedDialogueProfileSupported((enum FireRedDialogueProfile) 99));
+	assert(fireRedDialogueInspect(NULL) == FIRERED_DIALOGUE_BLOCKED);
+	fireRedDialogueReset(NULL);
+	fireRedDialogueConsumeTerminal(NULL);
+
+	fireRedDialogueInit(NULL, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_UNSUPPORTED,
+			ewram, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			NULL, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, 1, iwram, IWRAM_SIZE, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, EWRAM_SIZE, iwram, 1, rom, ROM_SIZE);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+	fireRedDialogueInit(&detector, FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+			ewram, EWRAM_SIZE, iwram, IWRAM_SIZE, rom, 1);
+	assert(detector.profile == FIRERED_DIALOGUE_PROFILE_UNSUPPORTED);
+
+	free(ewram);
+	free(iwram);
+	free(rom);
+}
+
+static void testAllPrinterStates(struct Fixture* fixture) {
+	static const uint8_t printing[] = { 0, 4, 5, 6 };
+	static const uint8_t waiting[] = { 1, 2, 3 };
+	for (size_t i = 0; i < sizeof(printing); ++i) {
+		setOrdinary(fixture, printing[i]);
+		assert(fireRedDialogueInspect(&fixture->detector) ==
+				FIRERED_DIALOGUE_PRINTING);
+		assert(fixture->detector.sessionArmed);
+	}
+	for (size_t i = 0; i < sizeof(waiting); ++i) {
+		setOrdinary(fixture, waiting[i]);
+		assert(fireRedDialogueInspect(&fixture->detector) ==
+				FIRERED_DIALOGUE_PAGE_WAIT);
+		assert(fixture->detector.sessionArmed);
+	}
+	setOrdinary(fixture, 7);
+	assertBlocked(fixture);
+}
+
+static void testEveryOrdinaryGuard(struct Fixture* fixture) {
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, MAIN_CALLBACK2,
+			fixture->profile->callback2 + 4U);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->iwram, IWRAM_BASE, MAIN_IN_BATTLE, 0x02);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STATUS, 1);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->isHidden + 4U);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, ROM_BASE - 1U);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			ROM_BASE + ROM_SIZE);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script, 0x6C);
+	assertBlocked(fixture);
+
+	/* Text directly preceding gameplay, a choice, or an unknown continuation
+	 * is never armed even before the forbidden task/battle itself exists. */
+	static const uint8_t unsafeContinuations[] = {
+		0x00, /* nop/unknown continuation */
+		0x16, /* setvar */
+		0x25, /* special (including scripted legendary starts) */
+		0x29, /* setflag */
+		0x5C, /* trainerbattle */
+		0x5D, /* dotrainerbattle */
+		0x6E, /* yesnobox */
+		0x6F, /* multichoice */
+		0x70, /* multichoicedefault */
+		0x71, /* multichoicegrid */
+	};
+	for (size_t i = 0;
+			i < sizeof(unsafeContinuations) / sizeof(*unsafeContinuations); ++i) {
+		setOrdinary(fixture, 0);
+		write8(fixture->rom, ROM_BASE, fixture->script + 1U,
+				unsafeContinuations[i]);
+		assertBlocked(fixture);
+	}
+
+	/* A callstd message is accepted only if every nested return path closes and
+	 * terminates. A dangerous caller continuation fails closed. */
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK + 4U,
+			fixture->script + 0x20U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->script + 0x40U);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x20U, 0x6C);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x21U, 0x03);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x40U, 0x02);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 1);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK,
+			fixture->script + 0x20U);
+	write8(fixture->rom, ROM_BASE, fixture->script + 0x20U, 0x5C);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 20);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x03);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_STACK_DEPTH, 1);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_STACK, ROM_BASE - 1U);
+	assertBlocked(fixture);
+
+	/* Even a syntactically harmless but corrupt non-terminating continuation is
+	 * bounded and rejected instead of being followed indefinitely. */
+	setOrdinary(fixture, 0);
+	for (unsigned offset = 1; offset < 64; ++offset) {
+		write8(fixture->rom, ROM_BASE, fixture->script + offset, 0x6C);
+	}
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->ewram, EWRAM_BASE, MESSAGE_BOX_TYPE, 3);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write8(fixture->ewram, EWRAM_BASE, PRINTER_ACTIVE, 0);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	setTask(fixture, 0, fixture->profile->taskDraw, false);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->trainerStart);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerStart, 0x6D);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->trainerEnd - 1U);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerEnd - 1U, 0x6D);
+	assertBlocked(fixture);
+
+	/* The exclusive end of the trainer range is not itself blocked. */
+	setOrdinary(fixture, 0);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->trainerEnd);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerEnd, 0x6D);
+	write8(fixture->rom, ROM_BASE, fixture->profile->trainerEnd + 1U, 0x02);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+
+	setOrdinary(fixture, 0);
+	setTask(fixture, 1, fixture->profile->taskBattle | 1U, true);
+	assertBlocked(fixture);
+
+	for (unsigned choice = 0; choice < 3; ++choice) {
+		setOrdinary(fixture, 0);
+		setTask(fixture, choice + 1, fixture->profile->choices[choice] | 1U,
+				true);
+		assertBlocked(fixture);
+	}
+
+	/* Inactive task slots do not inherit stale function pointers. */
+	setOrdinary(fixture, 0);
+	setTask(fixture, 1, fixture->profile->taskBattle | 1U, false);
+	setTask(fixture, 2, fixture->profile->choices[0] | 1U, false);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+}
+
+static void setHiddenTerminal(struct Fixture* fixture) {
+	write8(fixture->ewram, EWRAM_BASE, MESSAGE_BOX_TYPE, 0);
+	write8(fixture->ewram, EWRAM_BASE, PRINTER_ACTIVE, 0);
+	setTask(fixture, 0, fixture->profile->taskDraw | 1U, false);
+}
+
+static void testTerminalSequence(struct Fixture* fixture) {
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setHiddenTerminal(fixture);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	/* Re-reading within one emulated frame is stable. */
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, fixture->script + 1U);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_WAIT);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_WAIT);
+	fireRedDialogueConsumeTerminal(&fixture->detector);
+	assert(!fixture->detector.sessionArmed);
+	fireRedDialogueConsumeTerminal(&fixture->detector);
+	assert(!fixture->detector.sessionArmed);
+	assertBlocked(fixture);
+
+	/* Reset preserves the selected profile and cached memory pointers. */
+	setOrdinary(fixture, 2);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PAGE_WAIT);
+}
+
+static void testTerminalFailClosed(struct Fixture* fixture) {
+	/* None of the three terminal shapes are accepted without an armed message. */
+	setOrdinary(fixture, 0);
+	setHiddenTerminal(fixture);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	setHiddenTerminal(fixture);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	setHiddenTerminal(fixture);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	assertBlocked(fixture);
+
+	/* Skipping a required progression stage disarms the detector. */
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setHiddenTerminal(fixture);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, fixture->script + 1U);
+	assertBlocked(fixture);
+
+	/* Even an otherwise verified terminal wait needs a bounded ROM pointer. */
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setHiddenTerminal(fixture);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			ROM_BASE + ROM_SIZE);
+	assertBlocked(fixture);
+
+	/* A choice or battle transition appearing after arming also disarms it. */
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setTask(fixture, 1, fixture->profile->choices[1] | 1U, true);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setTask(fixture, 1, fixture->profile->taskBattle | 1U, true);
+	assertBlocked(fixture);
+}
+
+int main(void) {
+	testHashesAndBounds();
+	for (size_t revision = 0;
+			revision < sizeof(profiles) / sizeof(*profiles); ++revision) {
+		struct Fixture fixture;
+		initFixture(&fixture, &profiles[revision]);
+		testAllPrinterStates(&fixture);
+		testEveryOrdinaryGuard(&fixture);
+		testTerminalSequence(&fixture);
+		testTerminalFailClosed(&fixture);
+		deinitFixture(&fixture);
+	}
+	return 0;
+}
