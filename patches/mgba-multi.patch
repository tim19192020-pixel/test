+/* 262144 Hz is the highest GBA SOUNDBIAS rate. One native frame contains
+ * about 4389 samples at that rate, so 8192 leaves bounded headroom without
+ * ever requiring a producer/consumer wait. */
+#define AUDIO_CORE_CAPACITY 8192
