+#define FIRERED_MAIN_IN_BATTLE_MASK 0x02U
+#define FIRERED_TASKS 0x03005090U
+#define FIRERED_TASK_COUNT 16U
+#define FIRERED_TASK_STRIDE 0x28U
+#define FIRERED_TASK_FUNC_OFFSET 0U
+#define FIRERED_TASK_ACTIVE_OFFSET 4U
+
+#define FIRERED_CONTEXT_RUNNING 0U
+#define FIRERED_SCRIPT_MODE_BYTECODE 1U
+#define FIRERED_SCRIPT_MODE_NATIVE 2U
+#define FIRERED_MESSAGE_BOX_HIDDEN 0U
+#define FIRERED_MESSAGE_BOX_NORMAL 2U
+#define FIRERED_CMD_END 0x02U
+#define FIRERED_CMD_RETURN 0x03U
+#define FIRERED_CMD_CLOSE_MESSAGE 0x68U
+#define FIRERED_CMD_RELEASE_ALL 0x6BU
+#define FIRERED_CMD_RELEASE 0x6CU
+#define FIRERED_CMD_WAIT_BUTTON_PRESS 0x6DU
+
+enum FireRedTerminalStage {
+	FIRERED_TERMINAL_NONE,
+	FIRERED_TERMINAL_MESSAGE,
+	FIRERED_TERMINAL_HIDDEN_NATIVE,
+	FIRERED_TERMINAL_BYTECODE,
+	FIRERED_TERMINAL_WAIT,
+};
+
+struct FireRedDialogueProfileData {
+	uint32_t callback2Overworld;
+	uint32_t taskDrawFieldMessageBox;
+	uint32_t isFieldMessageBoxHidden;
+	uint32_t waitForAorBPress;
+	uint32_t taskBattleStart;
+	uint32_t choiceTasks[3];
+	uint32_t trainerScriptStart;
+	uint32_t trainerScriptEnd;
+};
+
+static const uint8_t sFireRed10Sha1[20] = {
+	0x41, 0xCB, 0x23, 0xD8, 0xDC, 0xCC, 0x8E, 0xBD, 0x7C, 0x64,
+	0x9C, 0xD8, 0xFB, 0xB5, 0x8E, 0xEA, 0xCE, 0x6E, 0x2F, 0xDC,
+};
+
+static const uint8_t sFireRed11Sha1[20] = {
+	0xDD, 0x59, 0x45, 0xDB, 0x9B, 0x93, 0x07, 0x50, 0xCB, 0x39,
+	0xD0, 0x0C, 0x84, 0xDA, 0x85, 0x71, 0xFE, 0xEB, 0xF4, 0x17,
+};
+
+static const struct FireRedDialogueProfileData sProfiles[] = {
+	{
+		.callback2Overworld = 0x080565B4U,
+		.taskDrawFieldMessageBox = 0x08069370U,
+		.isFieldMessageBoxHidden = 0x0806951CU,
+		.waitForAorBPress = 0x0806B898U,
+		.taskBattleStart = 0x0807F620U,
+		.choiceTasks = { 0x0809CC98U, 0x0809CE54U, 0x0809CFDCU },
+		.trainerScriptStart = 0x081A4EB4U,
+		.trainerScriptEnd = 0x081A501FU,
+	},
+	{
+		.callback2Overworld = 0x080565C8U,
+		.taskDrawFieldMessageBox = 0x08069384U,
+		.isFieldMessageBoxHidden = 0x08069530U,
+		.waitForAorBPress = 0x0806B8ACU,
+		.taskBattleStart = 0x0807F634U,
+		.choiceTasks = { 0x0809CCACU, 0x0809CE68U, 0x0809CFF0U },
+		.trainerScriptStart = 0x081A4F2CU,
+		.trainerScriptEnd = 0x081A5097U,
+	},
+};
+
+static bool _addressOffset(uint32_t address, uint32_t base, size_t size,
+		size_t width, size_t* offset) {
+	if (!offset || address < base) {
+		return false;
+	}
+	uint32_t rawOffset = address - base;
+	if ((size_t) rawOffset > size || width > size - (size_t) rawOffset) {
+		return false;
+	}
+	*offset = (size_t) rawOffset;
+	return true;
+}
+
+static bool _readU8(const uint8_t* memory, size_t size, uint32_t base,
+		uint32_t address, uint8_t* value) {
+	size_t offset;
+	if (!memory || !value || !_addressOffset(address, base, size, 1, &offset)) {
+		return false;
+	}
+	*value = memory[offset];
+	return true;
+}
+
+static bool _readU32(const uint8_t* memory, size_t size, uint32_t base,
+		uint32_t address, uint32_t* value) {
+	size_t offset;
+	if (!memory || !value || !_addressOffset(address, base, size, 4, &offset)) {
+		return false;
+	}
+	*value = (uint32_t) memory[offset]
+			| (uint32_t) memory[offset + 1] << 8
+			| (uint32_t) memory[offset + 2] << 16
+			| (uint32_t) memory[offset + 3] << 24;
+	return true;
+}
+
+static bool _readEwram8(const struct FireRedDialogueDetector* detector,
+		uint32_t address, uint8_t* value) {
+	return _readU8(detector->ewram, detector->ewramSize,
+			FIRERED_EWRAM_BASE, address, value);
+}
+
+static bool _readIwram8(const struct FireRedDialogueDetector* detector,
+		uint32_t address, uint8_t* value) {
+	return _readU8(detector->iwram, detector->iwramSize,
+			FIRERED_IWRAM_BASE, address, value);
+}
+
+static bool _readIwram32(const struct FireRedDialogueDetector* detector,
+		uint32_t address, uint32_t* value) {
+	return _readU32(detector->iwram, detector->iwramSize,
+			FIRERED_IWRAM_BASE, address, value);
+}
+
+static bool _readRom8(const struct FireRedDialogueDetector* detector,
+		uint32_t address, uint8_t* value) {
+	return _readU8(detector->rom, detector->romSize,
+			FIRERED_ROM_BASE, address, value);
+}
+
+static uint32_t _codeAddress(uint32_t pointer) {
+	return pointer & ~1U;
+}
+
+static const struct FireRedDialogueProfileData* _profile(
+		const struct FireRedDialogueDetector* detector) {
+	if (!detector || !fireRedDialogueProfileSupported(detector->profile)) {
+		return NULL;
+	}
+	return &sProfiles[(unsigned) detector->profile - 1];
+}
+
+static bool _isTrainerScript(const struct FireRedDialogueProfileData* profile,
+		uint32_t scriptPointer) {
+	return scriptPointer >= profile->trainerScriptStart &&
+			scriptPointer < profile->trainerScriptEnd;
+}
+
+/* Prove that advancing this message cannot immediately run gameplay script.
+ * A normal msgbox can be nested through callstd/call, so follow only returns
+ * already present on the interpreter stack. The only accepted operations are
+ * cosmetic close/release commands and a terminating end/return. Any flag,
+ * branch, special, choice, trainerbattle, malformed pointer, or unknown opcode
+ * fails closed. This deliberately leaves some ordinary scripted messages at
+ * 1x rather than accelerating a trainer/legendary encounter lead-in. */
+static bool _hasSafeClosure(const struct FireRedDialogueDetector* detector,
+		uint32_t scriptPointer, uint8_t stackDepth) {
+	/* ScriptPush rejects depth 20, so accepting it would trust corrupt state. */
+	if (stackDepth >= FIRERED_CONTEXT_STACK_COUNT || scriptPointer == UINT32_MAX) {
+		return false;
+	}
+
+	uint32_t cursor = scriptPointer + 1U;
+	for (unsigned step = 0; step < FIRERED_CONTEXT_STACK_COUNT * 2U + 4U;
+			++step) {
+		uint8_t opcode;
+		if (!_readRom8(detector, cursor, &opcode)) {
+			return false;
+		}
+		switch (opcode) {
+		case FIRERED_CMD_END:
+			return true;
+		case FIRERED_CMD_RETURN:
+			if (!stackDepth) {
+				return true;
+			}
+			--stackDepth;
+			if (!_readIwram32(detector,
+					FIRERED_GLOBAL_CONTEXT + FIRERED_CONTEXT_STACK_OFFSET +
+					stackDepth * sizeof(uint32_t), &cursor)) {
+				return false;
+			}
+			break;
+		case FIRERED_CMD_CLOSE_MESSAGE:
+		case FIRERED_CMD_RELEASE_ALL:
+		case FIRERED_CMD_RELEASE:
+			if (cursor == UINT32_MAX) {
+				return false;
+			}
+			++cursor;
+			break;
+		default:
+			return false;
+		}
+	}
+	return false;
+}
+
+static void _block(struct FireRedDialogueDetector* detector) {
+	detector->sessionArmed = false;
+	detector->terminalStage = FIRERED_TERMINAL_NONE;
+	detector->lastState = FIRERED_DIALOGUE_BLOCKED;
+}
+
+static bool _taskState(const struct FireRedDialogueDetector* detector,
+		const struct FireRedDialogueProfileData* profile, bool* drawTaskActive,
+		bool* forbiddenTaskActive) {
+	*drawTaskActive = false;
+	*forbiddenTaskActive = false;
+	for (unsigned i = 0; i < FIRERED_TASK_COUNT; ++i) {
+		uint32_t task = FIRERED_TASKS + i * FIRERED_TASK_STRIDE;
+		uint8_t active;
+		uint32_t function;
+		if (!_readIwram8(detector, task + FIRERED_TASK_ACTIVE_OFFSET, &active) ||
+				!_readIwram32(detector, task + FIRERED_TASK_FUNC_OFFSET, &function)) {
+			return false;
+		}
+		if (!active) {
+			continue;
+		}
+
+		function = _codeAddress(function);
+		if (function == profile->taskDrawFieldMessageBox) {
+			*drawTaskActive = true;
+		}
+		if (function == profile->taskBattleStart ||
+				function == profile->choiceTasks[0] ||
+				function == profile->choiceTasks[1] ||
+				function == profile->choiceTasks[2]) {
+			*forbiddenTaskActive = true;
+		}
+	}
+	return true;
+}
+
+enum FireRedDialogueProfile fireRedDialogueProfileFromSha1(
+		const uint8_t sha1[20]) {
+	if (!sha1) {
+		return FIRERED_DIALOGUE_PROFILE_UNSUPPORTED;
+	}
+	if (!memcmp(sha1, sFireRed10Sha1, sizeof(sFireRed10Sha1))) {
+		return FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0;
+	}
+	if (!memcmp(sha1, sFireRed11Sha1, sizeof(sFireRed11Sha1))) {
+		return FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1;
+	}
+	return FIRERED_DIALOGUE_PROFILE_UNSUPPORTED;
+}
+
+bool fireRedDialogueProfileSupported(enum FireRedDialogueProfile profile) {
+	return profile == FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0 ||
+			profile == FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1;
+}
+
+void fireRedDialogueInit(struct FireRedDialogueDetector* detector,
+		enum FireRedDialogueProfile profile,
+		const uint8_t* ewram, size_t ewramSize,
+		const uint8_t* iwram, size_t iwramSize,
+		const uint8_t* rom, size_t romSize) {
+	if (!detector) {
+		return;
+	}
+	memset(detector, 0, sizeof(*detector));
+	if (!fireRedDialogueProfileSupported(profile) ||
+			!ewram || !iwram || !rom) {
+		return;
+	}
+
+	detector->profile = profile;
+	detector->ewram = ewram;
+	detector->ewramSize = ewramSize;
+	detector->iwram = iwram;
+	detector->iwramSize = iwramSize;
+	detector->rom = rom;
+	detector->romSize = romSize;
+	detector->lastState = FIRERED_DIALOGUE_BLOCKED;
+
+	/* Validate every fixed span once. Dynamic script pointers are checked on
+	 * every classification before the ROM is dereferenced. */
+	size_t unused;
+	const struct FireRedDialogueProfileData* profileData = _profile(detector);
+	if (!_addressOffset(FIRERED_TEXT_PRINTER_0 + FIRERED_TEXT_PRINTER_STATE_OFFSET,
+			FIRERED_EWRAM_BASE, ewramSize, 1, &unused) ||
+			!_addressOffset(FIRERED_MESSAGE_BOX_TYPE, FIRERED_EWRAM_BASE,
+				ewramSize, 1, &unused) ||
+			!_addressOffset(FIRERED_GLOBAL_CONTEXT + FIRERED_CONTEXT_SCRIPT_PTR_OFFSET,
+				FIRERED_IWRAM_BASE, iwramSize, 4, &unused) ||
+			!_addressOffset(FIRERED_MAIN + FIRERED_MAIN_IN_BATTLE_OFFSET,
+				FIRERED_IWRAM_BASE, iwramSize, 1, &unused) ||
+			!_addressOffset(FIRERED_TASKS +
+					(FIRERED_TASK_COUNT - 1) * FIRERED_TASK_STRIDE +
+					FIRERED_TASK_ACTIVE_OFFSET,
+				FIRERED_IWRAM_BASE, iwramSize, 1, &unused) ||
+			!_addressOffset(profileData->trainerScriptEnd - 1,
+				FIRERED_ROM_BASE, romSize, 1, &unused)) {
+		memset(detector, 0, sizeof(*detector));
+		return;
+	}
+}
+
+void fireRedDialogueReset(struct FireRedDialogueDetector* detector) {
+	if (detector) {
+		_block(detector);
+	}
+}
+
+enum FireRedDialogueState fireRedDialogueInspect(
+		struct FireRedDialogueDetector* detector) {
+	const struct FireRedDialogueProfileData* profile = _profile(detector);
+	if (!profile) {
+		return FIRERED_DIALOGUE_BLOCKED;
+	}
+
+	uint8_t inBattle;
+	uint8_t status;
+	uint8_t stackDepth;
+	uint8_t mode;
+	uint8_t messageBoxType;
+	uint8_t printerActive;
+	uint8_t printerState;
+	uint32_t callback2;
+	uint32_t nativePointer;
+	uint32_t scriptPointer;
+	bool drawTaskActive;
+	bool forbiddenTaskActive;
+	if (!_readIwram32(detector, FIRERED_MAIN + FIRERED_MAIN_CALLBACK2_OFFSET,
+			&callback2) ||
+			!_readIwram8(detector, FIRERED_MAIN + FIRERED_MAIN_IN_BATTLE_OFFSET,
+				&inBattle) ||
+			!_readIwram8(detector, FIRERED_GLOBAL_CONTEXT_STATUS, &status) ||
+			!_readIwram8(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_STACK_DEPTH_OFFSET, &stackDepth) ||
+			!_readIwram8(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_MODE_OFFSET, &mode) ||
+			!_readIwram32(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_NATIVE_PTR_OFFSET, &nativePointer) ||
+			!_readIwram32(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_SCRIPT_PTR_OFFSET, &scriptPointer) ||
+			!_readEwram8(detector, FIRERED_MESSAGE_BOX_TYPE, &messageBoxType) ||
+			!_readEwram8(detector, FIRERED_TEXT_PRINTER_0 +
+				FIRERED_TEXT_PRINTER_ACTIVE_OFFSET, &printerActive) ||
+			!_readEwram8(detector, FIRERED_TEXT_PRINTER_0 +
+				FIRERED_TEXT_PRINTER_STATE_OFFSET, &printerState) ||
+			!_taskState(detector, profile, &drawTaskActive,
+				&forbiddenTaskActive)) {
+		_block(detector);
+		return detector->lastState;
+	}
+
+	callback2 = _codeAddress(callback2);
+	nativePointer = _codeAddress(nativePointer);
+	if (callback2 != profile->callback2Overworld ||
+			(inBattle & FIRERED_MAIN_IN_BATTLE_MASK) ||
+			status != FIRERED_CONTEXT_RUNNING || forbiddenTaskActive ||
+			_isTrainerScript(profile, scriptPointer)) {
+		_block(detector);
+		return detector->lastState;
+	}
+
+	uint8_t nextCommand = 0;
+	bool hasNextCommand = _readRom8(detector, scriptPointer, &nextCommand);
+	if (!hasNextCommand) {
+		_block(detector);
+		return detector->lastState;
+	}
+	bool scriptAtWaitButton = nextCommand == FIRERED_CMD_WAIT_BUTTON_PRESS;
+	bool hiddenTerminal = messageBoxType == FIRERED_MESSAGE_BOX_HIDDEN &&
+			!printerActive && !drawTaskActive;
+
+	/* A session can only be armed by an ordinary field message whose script is
+	 * waiting for that box and whose next exact opcode is waitbuttonpress. */
+	if (mode == FIRERED_SCRIPT_MODE_NATIVE &&
+			nativePointer == profile->isFieldMessageBoxHidden &&
+			scriptAtWaitButton &&
+			_hasSafeClosure(detector, scriptPointer, stackDepth) &&
+			messageBoxType == FIRERED_MESSAGE_BOX_NORMAL &&
+			printerActive && drawTaskActive) {
+		detector->sessionArmed = true;
+		detector->terminalStage = FIRERED_TERMINAL_MESSAGE;
+		if (printerState == 0 || printerState == 4 ||
+				printerState == 5 || printerState == 6) {
+			detector->lastState = FIRERED_DIALOGUE_PRINTING;
+			return detector->lastState;
+		}
+		if (printerState == 1 || printerState == 2 || printerState == 3) {
+			detector->lastState = FIRERED_DIALOGUE_PAGE_WAIT;
+			return detector->lastState;
+		}
+		_block(detector);
+		return detector->lastState;
+	}
+
+	if (!detector->sessionArmed || !hiddenTerminal) {
+		_block(detector);
+		return detector->lastState;
+	}
+
+	if (mode == FIRERED_SCRIPT_MODE_NATIVE &&
+			nativePointer == profile->isFieldMessageBoxHidden &&
+			scriptAtWaitButton &&
+			(detector->terminalStage == FIRERED_TERMINAL_MESSAGE ||
+			 detector->terminalStage == FIRERED_TERMINAL_HIDDEN_NATIVE)) {
+		detector->terminalStage = FIRERED_TERMINAL_HIDDEN_NATIVE;
+		detector->lastState = FIRERED_DIALOGUE_TERMINAL_PENDING;
+		return detector->lastState;
+	}
+
+	if (mode == FIRERED_SCRIPT_MODE_BYTECODE && scriptAtWaitButton &&
+			(detector->terminalStage == FIRERED_TERMINAL_HIDDEN_NATIVE ||
+			 detector->terminalStage == FIRERED_TERMINAL_BYTECODE)) {
+		detector->terminalStage = FIRERED_TERMINAL_BYTECODE;
+		detector->lastState = FIRERED_DIALOGUE_TERMINAL_PENDING;
+		return detector->lastState;
+	}
+
+	if (mode == FIRERED_SCRIPT_MODE_NATIVE &&
+			nativePointer == profile->waitForAorBPress &&
+			(detector->terminalStage == FIRERED_TERMINAL_BYTECODE ||
+			 detector->terminalStage == FIRERED_TERMINAL_WAIT)) {
+		detector->terminalStage = FIRERED_TERMINAL_WAIT;
+		detector->lastState = FIRERED_DIALOGUE_TERMINAL_WAIT;
+		return detector->lastState;
+	}
+
+	_block(detector);
+	return detector->lastState;
+}
+
+void fireRedDialogueConsumeTerminal(struct FireRedDialogueDetector* detector) {
+	if (!detector || !detector->sessionArmed ||
+			detector->terminalStage != FIRERED_TERMINAL_WAIT ||
+			detector->lastState != FIRERED_DIALOGUE_TERMINAL_WAIT) {
+		return;
+	}
+	_block(detector);
+}
