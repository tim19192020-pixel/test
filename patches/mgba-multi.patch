+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/*
+ * Minimal, linkless multi-instance libretro frontend.
+ *
+ * There is deliberately no link emulation, fast-forward, run-ahead queue,
+ * wall-clock pacing, per-frame allocation, or file I/O here. Player 1 runs
+ * on the libretro caller. Players 2 and 3 each keep one persistent owner
+ * pthread. Every retro_run dispatches at most one frame generation and waits
+ * for all instances before touching their audio/video buffers or returning.
+ */
+
+#include "libretro.h"
+
+#include <mgba-util/audio-buffer.h>
+#include <mgba-util/common.h>
+#include <mgba-util/memory.h>
+#include <mgba-util/vfs.h>
+
+#include <mgba/core/config.h>
+#include <mgba/core/core.h>
+#include <mgba/core/log.h>
+#include <mgba/core/version.h>
+#include <mgba/internal/gba/gba.h>
+#include <mgba/internal/gba/savedata.h>
+
+#include "libretro-audio.h"
+#include "libretro-vfs.h"
+#include "libretro_multi_support.h"
+
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef __LIBRETRO__
+#error "This frontend can only be built as a libretro core"
+#endif
+
+#ifndef M_CORE_GBA
+#error "The barebones multi-instance core requires the GBA core"
+#endif
+
+#define MULTI_FRONTEND_VERSION "0.1.0"
+#define VIDEO_STRIDE 256
+#define VIDEO_HEIGHT_MAX 224
+#define VIDEO_BUFFER_PIXELS (VIDEO_STRIDE * VIDEO_HEIGHT_MAX)
+#define COMPOSITE_BUFFER_PIXELS (MULTI_COMPOSITE_WIDTH * MULTI_COMPOSITE_HEIGHT)
+
+/* 262144 Hz is the highest GBA SOUNDBIAS rate. One native frame contains
+ * about 4389 samples at that rate, so 8192 leaves bounded headroom without
+ * ever requiring a producer/consumer wait. */
+#define AUDIO_CORE_CAPACITY 8192
+#define AUDIO_RAW_CHUNK_FRAMES 1024
+#define AUDIO_CONVERTED_CHUNK_FRAMES (AUDIO_RAW_CHUNK_FRAMES * 2)
+#define AUDIO_OUTPUT_MAX_FRAMES 2048
+#define AUDIO_FIFO_MAX_LEAD 32
+
+/* mGBA places its RTC trailer immediately after the game's actual save type,
+ * which may be 8 KiB, 64 KiB, or 128 KiB. We mirror it into the final 16 bytes
+ * as a stable canonical location. Keeping three permanent slices means player
+ * save identity never moves when the visible instance count changes. */
+#define SAVE_CANONICAL_RTC_OFFSET GBA_SIZE_FLASH1M
+#define SAVE_SLOT_SIZE (GBA_SIZE_FLASH1M + sizeof(struct GBASavedataRTCBuffer))
+
+enum MultiWorkerCommand {
+	WORKER_COMMAND_NONE = 0,
+	WORKER_COMMAND_FRAME,
+	WORKER_COMMAND_RESET,
+};
+
+struct MultiInstance {
+	struct mCore* core;
+	bool initialized;
+	mColor video[VIDEO_BUFFER_PIXELS];
+	struct mAVStream stream;
+	struct LibretroAudioConverter converter;
+	struct MultiAudioFifo audio;
+	int16_t rawAudio[AUDIO_RAW_CHUNK_FRAMES * 2];
+	int16_t convertedAudio[AUDIO_CONVERTED_CHUNK_FRAMES * 2];
+};
+
+struct MultiWorker {
+	pthread_t thread;
+	bool started;
+	unsigned instance;
+	uint64_t completedGeneration;
+};
+
+static retro_environment_t environCallback;
+static retro_video_refresh_t videoCallback;
+static retro_audio_sample_batch_t audioCallback;
+static retro_input_poll_t inputPollCallback;
+static retro_input_state_t inputCallback;
+static retro_log_printf_t logCallback;
+
+static struct MultiInstance instances[MULTI_MAX_INSTANCES];
+static struct MultiWorker workers[MULTI_MAX_INSTANCES];
+static unsigned instanceCount;
+static bool deferredSetup;
+static bool fatalLoadError;
+static bool useBitmasks;
+
+static void* romData;
+static size_t romSize;
+static uint8_t saveData[MULTI_MAX_INSTANCES][SAVE_SLOT_SIZE];
+static mColor compositeBuffer[COMPOSITE_BUFFER_PIXELS];
+static int16_t mixedAudio[AUDIO_OUTPUT_MAX_FRAMES * 2];
+static struct MultiAudioClock audioClock;
+static uint64_t rejectedAudioFrames;
+static char libraryVersion[64];
+
+static pthread_mutex_t workerMutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t workerWake = PTHREAD_COND_INITIALIZER;
+static pthread_cond_t workerDone = PTHREAD_COND_INITIALIZER;
+static enum MultiWorkerCommand workerCommand;
+static uint16_t workerKeys[MULTI_MAX_INSTANCES];
+static uint64_t workerGeneration;
+static unsigned workerPending;
+static bool workerStop;
+static bool parallelActive;
+
+static struct mLogger silentLogger;
+
+static void _drainInstanceAudio(struct MultiInstance* instance);
+
+static const int keymap[] = {
+	RETRO_DEVICE_ID_JOYPAD_A,
+	RETRO_DEVICE_ID_JOYPAD_B,
+	RETRO_DEVICE_ID_JOYPAD_SELECT,
+	RETRO_DEVICE_ID_JOYPAD_START,
+	RETRO_DEVICE_ID_JOYPAD_RIGHT,
+	RETRO_DEVICE_ID_JOYPAD_LEFT,
+	RETRO_DEVICE_ID_JOYPAD_UP,
+	RETRO_DEVICE_ID_JOYPAD_DOWN,
+	RETRO_DEVICE_ID_JOYPAD_R,
+	RETRO_DEVICE_ID_JOYPAD_L,
+};
+
+static const struct retro_variable coreVariables[] = {
+	{ "mgba_multi_instances", "Instances (restart content); 3|2|1" },
+	{ "mgba_multi_execution", "Execution (restart content); Parallel|Sequential" },
+	{ NULL, NULL },
+};
+
+static const struct retro_controller_description controllerTypes[] = {
+	{ "GBA Joypad", RETRO_DEVICE_JOYPAD },
+};
+
+static const struct retro_controller_info controllerInfo[] = {
+	{ controllerTypes, 1 },
+	{ controllerTypes, 1 },
+	{ controllerTypes, 1 },
+	{ NULL, 0 },
+};
+
+static void _silentLog(struct mLogger* logger, int category, enum mLogLevel level,
+		const char* format, va_list args) {
+	UNUSED(logger);
+	UNUSED(category);
+	UNUSED(level);
+	UNUSED(format);
+	UNUSED(args);
+}
+
+static void _frontendLog(enum retro_log_level level, const char* format, ...) {
+	if (!logCallback) {
+		return;
+	}
+	char message[512];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(message, sizeof(message), format, args);
+	va_end(args);
+	logCallback(level, "mGBA Multi: %s\n", message);
+}
+
+static void _instanceAudioRateChanged(struct mAVStream* stream, unsigned rate) {
+	struct MultiInstance* instance = containerof(stream, struct MultiInstance, stream);
+	/* GBAAudioWriteSOUNDBIAS emits every old-rate sample before this callback.
+	 * Drain those samples with the old converter, then start a clean converter
+	 * at the new hardware rate. Each callback touches only its owning instance. */
+	_drainInstanceAudio(instance);
+	audioConverterReset(&instance->converter, rate);
+}
+
+static const char* _getVariable(const char* key) {
+	struct retro_variable var = { key, NULL };
+	if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		return var.value;
+	}
+	return NULL;
+}
+
+static unsigned _requestedInstanceCount(void) {
+	const char* value = _getVariable("mgba_multi_instances");
+	long count = value ? strtol(value, NULL, 10) : MULTI_MAX_INSTANCES;
+	if (count < 1) {
+		count = 1;
+	} else if (count > MULTI_MAX_INSTANCES) {
+		count = MULTI_MAX_INSTANCES;
+	}
+	return (unsigned) count;
+}
+
+static bool _parallelRequested(void) {
+	const char* value = _getVariable("mgba_multi_execution");
+	return !value || strcmp(value, "Sequential") != 0;
+}
+
+static void _configureCore(struct mCore* core) {
+	struct mCoreOptions options;
+	memset(&options, 0, sizeof(options));
+	options.useBios = true;
+	options.volume = 0x100;
+	options.frameskip = 0;
+	options.audioBuffers = AUDIO_CORE_CAPACITY;
+
+	mCoreConfigSetDefaultValue(&core->config, "idleOptimization", "remove");
+	mCoreConfigSetDefaultIntValue(&core->config, "frameskip", 0);
+	mCoreConfigLoadDefaults(&core->config, &options);
+	/* Do not read the standalone mGBA configuration file. This frontend has a
+	 * sealed baseline, so unrelated desktop settings cannot enable frameskip,
+	 * mute audio, or change synchronization behind RetroArch's back. */
+	mCoreLoadForeignConfig(core, &core->config);
+	core->setSync(core, NULL);
+	core->setAudioBufferSize(core, AUDIO_CORE_CAPACITY);
+}
+
+static void _loadBios(struct mCore* core) {
+#ifdef ENABLE_VFS
+	if (!core->opts.useBios || !environCallback) {
+		core->opts.useBios = false;
+		return;
+	}
+	const char* systemDirectory = NULL;
+	if (!environCallback(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &systemDirectory) ||
+			!systemDirectory || !systemDirectory[0]) {
+		core->opts.useBios = false;
+		return;
+	}
+	char path[PATH_MAX];
+	int length = snprintf(path, sizeof(path), "%s%s%s", systemDirectory, PATH_SEP, "gba_bios.bin");
+	if (length < 0 || (size_t) length >= sizeof(path)) {
+		core->opts.useBios = false;
+		return;
+	}
+	struct VFile* bios = VFileOpen(path, O_RDONLY);
+	if (bios) {
+		core->loadBIOS(core, bios, 0);
+		if (((struct GBA*) core->board)->biosVf != bios) {
+			bios->close(bios);
+		}
+	}
+	/* Resets may run on worker lanes. Finalize BIOS discovery here on the
+	 * libretro caller so mGBA never retries VFS access from a worker. */
+	core->opts.useBios = ((struct GBA*) core->board)->biosVf != NULL;
+#else
+	core->opts.useBios = false;
+	UNUSED(core);
+#endif
+}
+
+static bool _copyRom(const struct retro_game_info* game) {
+	if (!game) {
+		return false;
+	}
+	struct VFile* file = NULL;
+	const void* source = game->data;
+	size_t size = game->size;
+	if (!source || !size) {
+		/* Treat data and size as one validity pair. Some frontends provide a
+		 * non-NULL placeholder with size zero while also supplying a path. */
+		source = NULL;
+		if (!game->path || !game->path[0]) {
+			return false;
+		}
+		file = VFileOpen(game->path, O_RDONLY);
+		if (!file) {
+			return false;
+		}
+		off_t fileSize = file->size(file);
+		if (fileSize <= 0 || (uint64_t) fileSize > SIZE_MAX) {
+			file->close(file);
+			return false;
+		}
+		size = (size_t) fileSize;
+	}
+
+	romData = anonymousMemoryMap(size);
+	if (!romData) {
+		if (file) {
+			file->close(file);
+		}
+		return false;
+	}
+	romSize = size;
+	if (source) {
+		memcpy(romData, source, size);
+	} else {
+		file->seek(file, 0, SEEK_SET);
+		size_t offset = 0;
+		while (offset < size) {
+			ssize_t read = file->read(file, (uint8_t*) romData + offset, size - offset);
+			if (read <= 0) {
+				file->close(file);
+				mappedMemoryFree(romData, romSize);
+				romData = NULL;
+				romSize = 0;
+				return false;
+			}
+			offset += (size_t) read;
+		}
+		file->close(file);
+	}
+	return true;
+}
+
+static bool _initializeInstance(unsigned index) {
+	struct MultiInstance* instance = &instances[index];
+	memset(instance, 0, sizeof(*instance));
+	/* Each core needs an independent VFile cursor, but the pristine ROM bytes
+	 * are immutable and may be shared. mGBA's _pristineCow() creates private
+	 * storage before any GPIO, patch, or emulated cartridge-memory write. */
+	struct VFile* rom = VFileFromConstMemory(romData, romSize);
+	if (!rom) {
+		return false;
+	}
+	instance->core = mCoreFindVF(rom);
+	if (!instance->core) {
+		rom->close(rom);
+		return false;
+	}
+	mCoreInitConfig(instance->core, NULL);
+	if (!instance->core->init(instance->core)) {
+		mCoreConfigDeinit(&instance->core->config);
+		free(instance->core);
+		instance->core = NULL;
+		rom->close(rom);
+		return false;
+	}
+	instance->initialized = true;
+	_configureCore(instance->core);
+
+	memset(instance->video, 0, sizeof(instance->video));
+	instance->core->setVideoBuffer(instance->core, instance->video, VIDEO_STRIDE);
+	if (!instance->core->loadROM(instance->core, rom)) {
+		rom->close(rom);
+		return false;
+	}
+	_loadBios(instance->core);
+	audioConverterReset(&instance->converter, instance->core->audioSampleRate(instance->core));
+	multiAudioFifoReset(&instance->audio);
+	memset(&instance->stream, 0, sizeof(instance->stream));
+	instance->stream.audioRateChanged = _instanceAudioRateChanged;
+	instance->core->setAVStream(instance->core, &instance->stream);
+	return true;
+}
+
+static void _stopWorkers(void);
+
+static void _destroyContent(void) {
+	_stopWorkers();
+	for (unsigned i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		struct MultiInstance* instance = &instances[i];
+		if (instance->initialized && instance->core) {
+			struct GBA* gba = instance->core->board;
+			if (gba->memory.hw.devices & HW_RTC) {
+				GBASavedataRTCWrite(&gba->memory.savedata);
+				size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+				multiSaveMirrorRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+						SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer));
+			}
+			instance->core->setAVStream(instance->core, NULL);
+			mCoreConfigDeinit(&instance->core->config);
+			instance->core->deinit(instance->core);
+		}
+		memset(instance, 0, sizeof(*instance));
+	}
+	if (romData) {
+		mappedMemoryFree(romData, romSize);
+		romData = NULL;
+	}
+	romSize = 0;
+	instanceCount = 0;
+	deferredSetup = false;
+	fatalLoadError = false;
+	multiAudioClockReset(&audioClock);
+}
+
+static void* _workerMain(void* context) {
+	struct MultiWorker* worker = context;
+	uint64_t observedGeneration = 0;
+	pthread_mutex_lock(&workerMutex);
+	while (!workerStop) {
+		while (!workerStop && workerGeneration == observedGeneration) {
+			pthread_cond_wait(&workerWake, &workerMutex);
+		}
+		if (workerStop) {
+			break;
+		}
+
+		uint64_t generation = workerGeneration;
+		enum MultiWorkerCommand command = workerCommand;
+		uint16_t keys = workerKeys[worker->instance];
+		pthread_mutex_unlock(&workerMutex);
+
+		struct mCore* core = instances[worker->instance].core;
+		if (command == WORKER_COMMAND_FRAME) {
+			core->setKeys(core, keys);
+			core->runFrame(core);
+		} else if (command == WORKER_COMMAND_RESET) {
+			core->reset(core);
+		}
+
+		pthread_mutex_lock(&workerMutex);
+		observedGeneration = generation;
+		worker->completedGeneration = generation;
+		if (workerPending) {
+			--workerPending;
+			if (!workerPending) {
+				pthread_cond_signal(&workerDone);
+			}
+		}
+	}
+	pthread_mutex_unlock(&workerMutex);
+	return NULL;
+}
+
+static bool _startWorkers(void) {
+	if (instanceCount < 2 || !_parallelRequested()) {
+		parallelActive = false;
+		return true;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerStop = false;
+	workerPending = 0;
+	workerCommand = WORKER_COMMAND_NONE;
+	workerGeneration = 0;
+	pthread_mutex_unlock(&workerMutex);
+
+	for (unsigned i = 1; i < instanceCount; ++i) {
+		workers[i].instance = i;
+		workers[i].completedGeneration = 0;
+		int error = pthread_create(&workers[i].thread, NULL, _workerMain, &workers[i]);
+		if (error) {
+			_frontendLog(RETRO_LOG_WARN,
+					"could not create Player %u worker (%d); using sequential execution", i + 1, error);
+			pthread_mutex_lock(&workerMutex);
+			workerStop = true;
+			pthread_cond_broadcast(&workerWake);
+			pthread_mutex_unlock(&workerMutex);
+			for (unsigned j = 1; j < i; ++j) {
+				if (workers[j].started) {
+					pthread_join(workers[j].thread, NULL);
+					workers[j].started = false;
+				}
+			}
+			pthread_mutex_lock(&workerMutex);
+			workerStop = false;
+			pthread_mutex_unlock(&workerMutex);
+			parallelActive = false;
+			return true;
+		}
+		workers[i].started = true;
+	}
+	parallelActive = true;
+	return true;
+}
+
+static void _stopWorkers(void) {
+	bool anyStarted = false;
+	for (unsigned i = 1; i < MULTI_MAX_INSTANCES; ++i) {
+		anyStarted |= workers[i].started;
+	}
+	if (!anyStarted) {
+		parallelActive = false;
+		return;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerStop = true;
+	pthread_cond_broadcast(&workerWake);
+	pthread_mutex_unlock(&workerMutex);
+	for (unsigned i = 1; i < MULTI_MAX_INSTANCES; ++i) {
+		if (workers[i].started) {
+			pthread_join(workers[i].thread, NULL);
+			workers[i].started = false;
+		}
+	}
+	pthread_mutex_lock(&workerMutex);
+	workerPending = 0;
+	workerCommand = WORKER_COMMAND_NONE;
+	workerStop = false;
+	pthread_mutex_unlock(&workerMutex);
+	parallelActive = false;
+}
+
+static void _executeBatch(enum MultiWorkerCommand command, const uint16_t* keys) {
+	if (!parallelActive) {
+		for (unsigned i = 0; i < instanceCount; ++i) {
+			if (command == WORKER_COMMAND_FRAME) {
+				instances[i].core->setKeys(instances[i].core, keys[i]);
+				instances[i].core->runFrame(instances[i].core);
+			} else if (command == WORKER_COMMAND_RESET) {
+				instances[i].core->reset(instances[i].core);
+			}
+		}
+		return;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerCommand = command;
+	if (keys) {
+		memcpy(workerKeys, keys, instanceCount * sizeof(*keys));
+	}
+	workerPending = instanceCount - 1;
+	++workerGeneration;
+	pthread_cond_broadcast(&workerWake);
+	pthread_mutex_unlock(&workerMutex);
+
+	if (command == WORKER_COMMAND_FRAME) {
+		instances[0].core->setKeys(instances[0].core, keys[0]);
+		instances[0].core->runFrame(instances[0].core);
+	} else if (command == WORKER_COMMAND_RESET) {
+		instances[0].core->reset(instances[0].core);
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	while (workerPending) {
+		pthread_cond_wait(&workerDone, &workerMutex);
+	}
+	pthread_mutex_unlock(&workerMutex);
+}
+
+static void _resetAudioPipeline(void) {
+	multiAudioClockReset(&audioClock);
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct MultiInstance* instance = &instances[i];
+		mAudioBufferClear(instance->core->getAudioBuffer(instance->core));
+		audioConverterReset(&instance->converter, instance->core->audioSampleRate(instance->core));
+		multiAudioFifoReset(&instance->audio);
+	}
+}
+
+static bool _finishDeferredSetup(void) {
+	if (!deferredSetup) {
+		return !fatalLoadError;
+	}
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct mCore* core = instances[i].core;
+		core->reset(core);
+		struct VFile* save = VFileFromMemory(saveData[i], SAVE_SLOT_SIZE);
+		if (!save || !core->loadSave(core, save)) {
+			if (save) {
+				save->close(save);
+			}
+			_frontendLog(RETRO_LOG_ERROR, "could not attach Player %u save slice", i + 1);
+			fatalLoadError = true;
+			deferredSetup = false;
+			return false;
+		}
+		struct GBA* gba = core->board;
+		if (gba->memory.hw.devices & HW_RTC) {
+			size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+			if (multiSaveRestoreRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+						SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer))) {
+				GBASavedataRTCRead(&gba->memory.savedata);
+			}
+		}
+	}
+	_resetAudioPipeline();
+	_startWorkers();
+	deferredSetup = false;
+
+	char text[128];
+	snprintf(text, sizeof(text), "mGBA Multi %s: %u instance%s, %s execution",
+			MULTI_FRONTEND_VERSION, instanceCount, instanceCount == 1 ? "" : "s",
+			parallelActive ? "parallel" : "direct");
+	struct retro_message message = { text, 240 };
+	if (environCallback) {
+		environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	}
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+	return true;
+}
+
+static uint16_t _readKeys(unsigned port) {
+	if (!inputCallback) {
+		return 0;
+	}
+	uint16_t keys = 0;
+	if (useBitmasks) {
+		uint16_t mask = (uint16_t) inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+				RETRO_DEVICE_ID_JOYPAD_MASK);
+		for (unsigned i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= ((mask >> keymap[i]) & 1U) << i;
+		}
+	} else {
+		for (unsigned i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= (!!inputCallback(port, RETRO_DEVICE_JOYPAD, 0, keymap[i])) << i;
+		}
+	}
+	return keys;
+}
+
+static void _composeVideo(const struct MultiLayout* layout) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		const struct MultiPlacement* placement = &layout->placement[i];
+		for (unsigned y = 0; y < MULTI_VIDEO_HEIGHT; ++y) {
+			memcpy(&compositeBuffer[(placement->y + y) * layout->width + placement->x],
+					&instances[i].video[y * VIDEO_STRIDE],
+					MULTI_VIDEO_WIDTH * sizeof(*compositeBuffer));
+		}
+	}
+}
+
+static void _drainInstanceAudio(struct MultiInstance* instance) {
+	struct mAudioBuffer* buffer = instance->core->getAudioBuffer(instance->core);
+	for (;;) {
+		size_t read = mAudioBufferRead(buffer, instance->rawAudio, AUDIO_RAW_CHUNK_FRAMES);
+		if (!read) {
+			break;
+		}
+		size_t produced = audioConverterProcess(&instance->converter, instance->rawAudio, read,
+				instance->convertedAudio);
+		if (produced) {
+			multiAudioFifoPush(&instance->audio, instance->convertedAudio, produced);
+		}
+	}
+}
+
+static void _mixAndSubmitAudio(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		unsigned rate = instances[i].core->audioSampleRate(instances[i].core);
+		if (rate != instances[i].converter.inputRate) {
+			_instanceAudioRateChanged(&instances[i].stream, rate);
+		}
+		_drainInstanceAudio(&instances[i]);
+	}
+	if (!instanceCount) {
+		return;
+	}
+
+	uint32_t frameCycles = instances[0].core->frameCycles(instances[0].core);
+	uint32_t frequency = instances[0].core->frequency(instances[0].core);
+	size_t frames = multiAudioClockNext(&audioClock, GBA_OUTPUT_RATE, frameCycles, frequency);
+	if (frames > AUDIO_OUTPUT_MAX_FRAMES) {
+		frames = AUDIO_OUTPUT_MAX_FRAMES;
+	}
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		multiAudioFifoTrim(&instances[i].audio, frames + AUDIO_FIFO_MAX_LEAD);
+	}
+	for (size_t frame = 0; frame < frames; ++frame) {
+		int32_t left = 0;
+		int32_t right = 0;
+		for (unsigned i = 0; i < instanceCount; ++i) {
+			int16_t instanceLeft = 0;
+			int16_t instanceRight = 0;
+			multiAudioFifoPop(&instances[i].audio, &instanceLeft, &instanceRight);
+			left += instanceLeft;
+			right += instanceRight;
+		}
+		mixedAudio[frame * 2] = (int16_t) (left / (int32_t) instanceCount);
+		mixedAudio[frame * 2 + 1] = (int16_t) (right / (int32_t) instanceCount);
+	}
+	if (audioCallback) {
+		size_t accepted = audioCallback(mixedAudio, frames);
+		if (accepted < frames) {
+			rejectedAudioFrames += frames - accepted;
+		}
+	}
+}
+
+static void _syncRtcTrailers(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct GBA* gba = instances[i].core->board;
+		if (!(gba->memory.hw.devices & HW_RTC)) {
+			continue;
+		}
+		GBASavedataRTCWrite(&gba->memory.savedata);
+		size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+		multiSaveMirrorRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+				SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer));
+	}
+}
