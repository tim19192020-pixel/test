diff --git a/src/platform/libretro/libretro_multi_support.c b/src/platform/libretro/libretro_multi_support.c
new file mode 100644
index 0000000..1dab9a8
--- /dev/null
+++ b/src/platform/libretro/libretro_multi_support.c
@@ -0,0 +1,504 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "libretro_multi_support.h"
+
+#include <string.h>
+
+bool multiLayoutForCount(unsigned count, struct MultiLayout* layout) {
+	if (!layout || count < 1 || count > MULTI_MAX_INSTANCES) {
+		return false;
+	}
+
+	memset(layout, 0, sizeof(*layout));
+	switch (count) {
+	case 1:
+		layout->width = MULTI_VIDEO_WIDTH;
+		layout->height = MULTI_VIDEO_HEIGHT;
+		break;
+	case 2:
+		layout->width = MULTI_COMPOSITE_WIDTH;
+		layout->height = MULTI_VIDEO_HEIGHT;
+		layout->placement[1].x = MULTI_VIDEO_WIDTH;
+		break;
+	case 3:
+		layout->width = MULTI_COMPOSITE_WIDTH;
+		layout->height = MULTI_COMPOSITE_HEIGHT;
+		layout->placement[1].x = MULTI_VIDEO_WIDTH;
+		layout->placement[2].x = MULTI_VIDEO_WIDTH / 2;
+		layout->placement[2].y = MULTI_VIDEO_HEIGHT;
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
+
+enum MultiScreenOrder multiScreenOrderParse(const char* value) {
+	static const char* const values[MULTI_SCREEN_ORDER_COUNT] = {
+		"P1-P2-P3",
+		"P1-P3-P2",
+		"P2-P1-P3",
+		"P2-P3-P1",
+		"P3-P1-P2",
+		"P3-P2-P1",
+	};
+
+	if (value) {
+		for (unsigned order = 0; order < MULTI_SCREEN_ORDER_COUNT; ++order) {
+			if (!strcmp(value, values[order])) {
+				return (enum MultiScreenOrder) order;
+			}
+		}
+	}
+	return MULTI_SCREEN_ORDER_DEFAULT;
+}
+
+bool multiScreenOrderResolve(enum MultiScreenOrder order, unsigned activeCount,
+		unsigned playerAtSlot[MULTI_MAX_INSTANCES]) {
+	static const unsigned players[MULTI_SCREEN_ORDER_COUNT][MULTI_MAX_INSTANCES] = {
+		{ 0, 1, 2 },
+		{ 0, 2, 1 },
+		{ 1, 0, 2 },
+		{ 1, 2, 0 },
+		{ 2, 0, 1 },
+		{ 2, 1, 0 },
+	};
+
+	if (!playerAtSlot || activeCount < 1 || activeCount > MULTI_MAX_INSTANCES ||
+			(unsigned) order >= MULTI_SCREEN_ORDER_COUNT) {
+		return false;
+	}
+
+	unsigned slot = 0;
+	for (unsigned position = 0; position < MULTI_MAX_INSTANCES; ++position) {
+		unsigned player = players[order][position];
+		if (player < activeCount) {
+			playerAtSlot[slot++] = player;
+		}
+	}
+	return slot == activeCount;
+}
+
+bool multiComposeFrames(void* destination, size_t destinationPixels,
+		size_t pixelSize, const void* const sources[MULTI_MAX_INSTANCES],
+		size_t sourceStridePixels, unsigned activeCount,
+		const struct MultiLayout* layout,
+		const unsigned playerAtSlot[MULTI_MAX_INSTANCES]) {
+	if (!destination || !pixelSize || !sources || !layout || !playerAtSlot ||
+			activeCount < 1 || activeCount > MULTI_MAX_INSTANCES ||
+			sourceStridePixels < MULTI_VIDEO_WIDTH || !layout->width ||
+			layout->height > destinationPixels / layout->width) {
+		return false;
+	}
+
+	for (unsigned slot = 0; slot < activeCount; ++slot) {
+		unsigned player = playerAtSlot[slot];
+		const struct MultiPlacement* placement = &layout->placement[slot];
+		if (player >= activeCount || !sources[player] ||
+				placement->x > layout->width ||
+				MULTI_VIDEO_WIDTH > layout->width - placement->x ||
+				placement->y > layout->height ||
+				MULTI_VIDEO_HEIGHT > layout->height - placement->y) {
+			return false;
+		}
+	}
+
+	uint8_t* output = destination;
+	for (unsigned slot = 0; slot < activeCount; ++slot) {
+		unsigned player = playerAtSlot[slot];
+		const struct MultiPlacement* placement = &layout->placement[slot];
+		const uint8_t* source = sources[player];
+		for (unsigned y = 0; y < MULTI_VIDEO_HEIGHT; ++y) {
+			size_t destinationOffset =
+					((size_t) placement->y + y) * layout->width + placement->x;
+			memcpy(output + destinationOffset * pixelSize,
+					source + y * sourceStridePixels * pixelSize,
+					MULTI_VIDEO_WIDTH * pixelSize);
+		}
+	}
+	return true;
+}
+
+unsigned multiSpeedParseTarget(const char* value) {
+	if (!value || value[0] < '1' || value[0] > '4' || value[1] != '.' ||
+			value[2] < '0' || value[2] > '9' || value[3] != 'x' || value[4] != '\0') {
+		return MULTI_SPEED_MIN_TENTHS;
+	}
+
+	unsigned targetTenths = (unsigned) (value[0] - '0') * 10U +
+			(unsigned) (value[2] - '0');
+	if (targetTenths < MULTI_SPEED_MIN_TENTHS || targetTenths > MULTI_SPEED_MAX_TENTHS) {
+		return MULTI_SPEED_MIN_TENTHS;
+	}
+	return targetTenths;
+}
+
+void multiSpeedInit(struct MultiSpeedState* speed) {
+	if (!speed) {
+		return;
+	}
+	speed->targetTenths = MULTI_SPEED_DEFAULT_TENTHS;
+	speed->phase = 0;
+	speed->enabled = false;
+	speed->buttonDown = false;
+}
+
+void multiSpeedSetTarget(struct MultiSpeedState* speed, unsigned targetTenths) {
+	if (!speed) {
+		return;
+	}
+	if (targetTenths < MULTI_SPEED_MIN_TENTHS || targetTenths > MULTI_SPEED_MAX_TENTHS) {
+		targetTenths = MULTI_SPEED_MIN_TENTHS;
+	}
+	if (speed->targetTenths == targetTenths) {
+		return;
+	}
+	speed->targetTenths = targetTenths;
+	if (targetTenths == MULTI_SPEED_MIN_TENTHS) {
+		speed->enabled = false;
+	}
+	speed->phase = speed->enabled ? MULTI_SPEED_MIN_TENTHS - 1 : 0;
+}
+
+void multiSpeedResetPhase(struct MultiSpeedState* speed) {
+	if (speed) {
+		speed->phase = speed->enabled ? MULTI_SPEED_MIN_TENTHS - 1 : 0;
+	}
+}
+
+bool multiSpeedHandleR2(struct MultiSpeedState* speed, bool pressed) {
+	if (!speed) {
+		return false;
+	}
+
+	bool rising = pressed && !speed->buttonDown;
+	speed->buttonDown = pressed;
+	if (!rising || speed->targetTenths == MULTI_SPEED_MIN_TENTHS) {
+		return false;
+	}
+	speed->enabled = !speed->enabled;
+	speed->phase = speed->enabled ? MULTI_SPEED_MIN_TENTHS - 1 : 0;
+	return true;
+}
+
+unsigned multiSpeedEffectiveTenths(const struct MultiSpeedState* speed) {
+	if (!speed || !speed->enabled || speed->targetTenths < MULTI_SPEED_MIN_TENTHS ||
+			speed->targetTenths > MULTI_SPEED_MAX_TENTHS) {
+		return MULTI_SPEED_MIN_TENTHS;
+	}
+	return speed->targetTenths;
+}
+
+unsigned multiSpeedNextFrames(struct MultiSpeedState* speed) {
+	if (!speed) {
+		return 1;
+	}
+	speed->phase += multiSpeedEffectiveTenths(speed);
+	unsigned frames = speed->phase / MULTI_SPEED_MIN_TENTHS;
+	speed->phase %= MULTI_SPEED_MIN_TENTHS;
+	return frames;
+}
+
+unsigned multiDialogueParseTarget(const char* value) {
+	if (!value) {
+		return MULTI_DIALOGUE_DEFAULT_TENTHS;
+	}
+
+	unsigned multiplier = 0;
+	const char* cursor = value;
+	while (*cursor >= '0' && *cursor <= '9') {
+		multiplier = multiplier * 10U + (unsigned) (*cursor - '0');
+		++cursor;
+	}
+	if (cursor == value || value[0] == '0' || cursor[0] != 'x' || cursor[1] != '\0' ||
+			multiplier < MULTI_DIALOGUE_MIN_TENTHS / MULTI_SPEED_MIN_TENTHS ||
+			multiplier > MULTI_DIALOGUE_MAX_TENTHS / MULTI_SPEED_MIN_TENTHS) {
+		return MULTI_DIALOGUE_DEFAULT_TENTHS;
+	}
+	return multiplier * MULTI_SPEED_MIN_TENTHS;
+}
+
+void multiDialogueToggleInit(struct MultiDialogueToggleState* state) {
+	if (!state) {
+		return;
+	}
+	state->enabled = false;
+	state->buttonDown = false;
+}
+
+enum MultiDialogueToggleResult multiDialogueHandleL2(
+		struct MultiDialogueToggleState* state, bool pressed, bool available) {
+	if (!state) {
+		return MULTI_DIALOGUE_TOGGLE_NONE;
+	}
+
+	bool rising = pressed && !state->buttonDown;
+	state->buttonDown = pressed;
+	if (!rising) {
+		return MULTI_DIALOGUE_TOGGLE_NONE;
+	}
+	if (!available) {
+		state->enabled = false;
+		return MULTI_DIALOGUE_TOGGLE_UNAVAILABLE;
+	}
+	state->enabled = !state->enabled;
+	return state->enabled ? MULTI_DIALOGUE_TOGGLE_ENABLED : MULTI_DIALOGUE_TOGGLE_DISABLED;
+}
+
+void multiDialogueInputGuardInit(struct MultiDialogueInputGuard* guard) {
+	if (!guard) {
+		return;
+	}
+	guard->releasePending = false;
+	guard->advanceLockout = false;
+}
+
+bool multiDialogueInputPrepare(struct MultiDialogueInputGuard* guard,
+		uint16_t rawKeys, uint16_t advanceMask, uint16_t* effectiveKeys) {
+	if (!effectiveKeys) {
+		return false;
+	}
+	*effectiveKeys = rawKeys;
+	if (!guard) {
+		return false;
+	}
+
+	bool physicalAdvance = (rawKeys & advanceMask) != 0;
+	if (guard->advanceLockout) {
+		if (physicalAdvance) {
+			*effectiveKeys &= (uint16_t) ~advanceMask;
+		} else {
+			guard->advanceLockout = false;
+		}
+	}
+
+	bool forceRelease = guard->releasePending;
+	if (forceRelease) {
+		guard->releasePending = false;
+		*effectiveKeys &= (uint16_t) ~advanceMask;
+	}
+	return forceRelease;
+}
+
+void multiDialogueInputAdvanced(struct MultiDialogueInputGuard* guard) {
+	if (!guard) {
+		return;
+	}
+	guard->releasePending = true;
+	guard->advanceLockout = true;
+}
+
+void multiIvCheckerInit(struct MultiIvCheckerState* state) {
+	if (!state) {
+		return;
+	}
+	state->visible = false;
+	state->buttonDown = false;
+	state->refreshCountdown = 0;
+}
+
+enum MultiIvCheckerToggleResult multiIvCheckerHandleX(
+		struct MultiIvCheckerState* state, bool pressed, bool supported) {
+	if (!state) {
+		return MULTI_IV_CHECKER_TOGGLE_NONE;
+	}
+
+	bool rising = pressed && !state->buttonDown;
+	state->buttonDown = pressed;
+	if (!supported) {
+		state->visible = false;
+		state->refreshCountdown = 0;
+		return rising ? MULTI_IV_CHECKER_TOGGLE_UNAVAILABLE :
+				MULTI_IV_CHECKER_TOGGLE_NONE;
+	}
+	if (!rising) {
+		return MULTI_IV_CHECKER_TOGGLE_NONE;
+	}
+
+	state->visible = !state->visible;
+	state->refreshCountdown = 0;
+	return state->visible ? MULTI_IV_CHECKER_TOGGLE_SHOWN :
+			MULTI_IV_CHECKER_TOGGLE_HIDDEN;
+}
+
+bool multiIvCheckerShouldRefresh(struct MultiIvCheckerState* state) {
+	if (!state || !state->visible) {
+		if (state) {
+			state->refreshCountdown = 0;
+		}
+		return false;
+	}
+
+	if (state->refreshCountdown > 1) {
+		--state->refreshCountdown;
+		return false;
+	}
+	state->refreshCountdown = MULTI_IV_CHECKER_REFRESH_FRAMES;
+	return true;
+}
+
+void multiIvCheckerRequestRefresh(struct MultiIvCheckerState* state) {
+	if (state) {
+		state->refreshCountdown = 0;
+	}
+}
+
+enum MultiAudioMode multiAudioParseMode(const char* value) {
+	if (!value || !strcmp(value, "Player 1") || !strcmp(value, "player 1")) {
+		return MULTI_AUDIO_PLAYER_1;
+	}
+	if (!strcmp(value, "Player 2") || !strcmp(value, "player 2")) {
+		return MULTI_AUDIO_PLAYER_2;
+	}
+	if (!strcmp(value, "Player 3") || !strcmp(value, "player 3")) {
+		return MULTI_AUDIO_PLAYER_3;
+	}
+	if (!strcmp(value, "Disabled") || !strcmp(value, "disabled")) {
+		return MULTI_AUDIO_DISABLED;
+	}
+	return MULTI_AUDIO_PLAYER_1;
+}
+
+int multiAudioSelectedIndex(enum MultiAudioMode mode, unsigned activeCount) {
+	unsigned index;
+	switch (mode) {
+	case MULTI_AUDIO_PLAYER_1:
+		index = 0;
+		break;
+	case MULTI_AUDIO_PLAYER_2:
+		index = 1;
+		break;
+	case MULTI_AUDIO_PLAYER_3:
+		index = 2;
+		break;
+	case MULTI_AUDIO_DISABLED:
+	default:
+		return -1;
+	}
+	return index < activeCount && index < MULTI_MAX_INSTANCES ? (int) index : -1;
+}
+
+void multiAudioClockReset(struct MultiAudioClock* clock) {
+	if (clock) {
+		clock->remainder = 0;
+	}
+}
+
+size_t multiAudioClockNext(struct MultiAudioClock* clock, unsigned sampleRate,
+		uint32_t frameCycles, uint32_t frequency) {
+	if (!clock || !sampleRate || !frameCycles || !frequency) {
+		return 0;
+	}
+	clock->remainder += (uint64_t) sampleRate * frameCycles;
+	size_t frames = (size_t) (clock->remainder / frequency);
+	clock->remainder %= frequency;
+	return frames;
+}
+
+void multiAudioFifoReset(struct MultiAudioFifo* fifo) {
+	if (!fifo) {
+		return;
+	}
+	fifo->read = 0;
+	fifo->size = 0;
+	fifo->dropped = 0;
+}
+
+void multiAudioFifoPush(struct MultiAudioFifo* fifo, const int16_t* samples, size_t frames) {
+	if (!fifo || !samples || !frames) {
+		return;
+	}
+
+	if (frames >= MULTI_AUDIO_FIFO_FRAMES) {
+		fifo->dropped += fifo->size + frames - MULTI_AUDIO_FIFO_FRAMES;
+		samples += (frames - MULTI_AUDIO_FIFO_FRAMES) * 2;
+		frames = MULTI_AUDIO_FIFO_FRAMES;
+		fifo->read = 0;
+		fifo->size = 0;
+	} else if (fifo->size + frames > MULTI_AUDIO_FIFO_FRAMES) {
+		size_t discard = fifo->size + frames - MULTI_AUDIO_FIFO_FRAMES;
+		fifo->read = (fifo->read + discard) % MULTI_AUDIO_FIFO_FRAMES;
+		fifo->size -= discard;
+		fifo->dropped += discard;
+	}
+
+	size_t write = (fifo->read + fifo->size) % MULTI_AUDIO_FIFO_FRAMES;
+	size_t first = MULTI_AUDIO_FIFO_FRAMES - write;
+	if (first > frames) {
+		first = frames;
+	}
+	memcpy(&fifo->samples[write * 2], samples, first * 2 * sizeof(*samples));
+	if (frames > first) {
+		memcpy(fifo->samples, &samples[first * 2], (frames - first) * 2 * sizeof(*samples));
+	}
+	fifo->size += frames;
+}
+
+bool multiAudioFifoPop(struct MultiAudioFifo* fifo, int16_t* left, int16_t* right) {
+	if (!fifo || !fifo->size || !left || !right) {
+		return false;
+	}
+	*left = fifo->samples[fifo->read * 2];
+	*right = fifo->samples[fifo->read * 2 + 1];
+	fifo->read = (fifo->read + 1) % MULTI_AUDIO_FIFO_FRAMES;
+	--fifo->size;
+	return true;
+}
+
+void multiAudioFifoTrim(struct MultiAudioFifo* fifo, size_t maximumFrames) {
+	if (!fifo || fifo->size <= maximumFrames) {
+		return;
+	}
+	size_t discard = fifo->size - maximumFrames;
+	fifo->read = (fifo->read + discard) % MULTI_AUDIO_FIFO_FRAMES;
+	fifo->size = maximumFrames;
+	fifo->dropped += discard;
+}
+
+static bool _allBytesAre(const uint8_t* data, size_t size, uint8_t value) {
+	for (size_t i = 0; i < size; ++i) {
+		if (data[i] != value) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool multiSaveRestoreRtc(uint8_t* slot, size_t slotSize, size_t actualOffset,
+		size_t canonicalOffset, size_t rtcSize) {
+	if (!slot || !rtcSize || actualOffset > slotSize || canonicalOffset > slotSize ||
+			rtcSize > slotSize - actualOffset || rtcSize > slotSize - canonicalOffset) {
+		return false;
+	}
+
+	uint8_t* actual = &slot[actualOffset];
+	uint8_t* canonical = &slot[canonicalOffset];
+	if (!_allBytesAre(canonical, rtcSize, 0xFF)) {
+		if (actual != canonical) {
+			memcpy(actual, canonical, rtcSize);
+		}
+		return true;
+	}
+	if (_allBytesAre(actual, rtcSize, 0xFF)) {
+		return false;
+	}
+	if (actual != canonical) {
+		memcpy(canonical, actual, rtcSize);
+	}
+	return true;
+}
+
+bool multiSaveMirrorRtc(uint8_t* slot, size_t slotSize, size_t actualOffset,
+		size_t canonicalOffset, size_t rtcSize) {
+	if (!slot || !rtcSize || actualOffset > slotSize || canonicalOffset > slotSize ||
+			rtcSize > slotSize - actualOffset || rtcSize > slotSize - canonicalOffset) {
+		return false;
+	}
+	if (actualOffset != canonicalOffset) {
+		memcpy(&slot[canonicalOffset], &slot[actualOffset], rtcSize);
+	}
+	return true;
+}
