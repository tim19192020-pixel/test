+static void _configureCore(struct mCore* core) {
+	struct mCoreOptions options;
+	memset(&options, 0, sizeof(options));
+	options.useBios = true;
+	options.volume = 0x100;
+	options.frameskip = 0;
+	options.audioBuffers = AUDIO_CORE_CAPACITY;
+
+	mCoreConfigSetDefaultValue(&core->config, "idleOptimization", "remove");
+	mCoreConfigSetDefaultIntValue(&core->config, "frameskip", 0);
+	mCoreConfigLoadDefaults(&core->config, &options);
+	/* Do not read the standalone mGBA configuration file. This frontend has a
+	 * sealed baseline, so unrelated desktop settings cannot enable frameskip,
+	 * mute audio, or change synchronization behind RetroArch's back. */
+	mCoreLoadForeignConfig(core, &core->config);
+	core->setSync(core, NULL);
+	core->setAudioBufferSize(core, AUDIO_CORE_CAPACITY);
+}
+
+static void _loadBios(struct mCore* core) {
+#ifdef ENABLE_VFS
+	if (!core->opts.useBios || !environCallback) {
+		core->opts.useBios = false;
+		return;
+	}
+	const char* systemDirectory = NULL;
+	if (!environCallback(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &systemDirectory) ||
+			!systemDirectory || !systemDirectory[0]) {
+		core->opts.useBios = false;
+		return;
+	}
+	char path[PATH_MAX];
+	int length = snprintf(path, sizeof(path), "%s%s%s", systemDirectory, PATH_SEP, "gba_bios.bin");
+	if (length < 0 || (size_t) length >= sizeof(path)) {
+		core->opts.useBios = false;
+		return;
+	}
+	struct VFile* bios = VFileOpen(path, O_RDONLY);
+	if (bios) {
+		core->loadBIOS(core, bios, 0);
+		if (((struct GBA*) core->board)->biosVf != bios) {
+			bios->close(bios);
+		}
+	}
+	/* Resets may run on worker lanes. Finalize BIOS discovery here on the
+	 * libretro caller so mGBA never retries VFS access from a worker. */
+	core->opts.useBios = ((struct GBA*) core->board)->biosVf != NULL;
+#else
+	core->opts.useBios = false;
+	UNUSED(core);
+#endif
+}
+
+static bool _copyRom(const struct retro_game_info* game) {
+	dialogueProfile = FIRERED_DIALOGUE_PROFILE_UNSUPPORTED;
+	if (!game) {
+		return false;
+	}
+	struct VFile* file = NULL;
+	const void* source = game->data;
+	size_t size = game->size;
+	if (!source || !size) {
+		/* Treat data and size as one validity pair. Some frontends provide a
+		 * non-NULL placeholder with size zero while also supplying a path. */
+		source = NULL;
+		if (!game->path || !game->path[0]) {
+			return false;
+		}
+		file = VFileOpen(game->path, O_RDONLY);
+		if (!file) {
+			return false;
+		}
+		off_t fileSize = file->size(file);
+		if (fileSize <= 0 || (uint64_t) fileSize > SIZE_MAX) {
+			file->close(file);
+			return false;
+		}
+		size = (size_t) fileSize;
+	}
+
+	romData = anonymousMemoryMap(size);
+	if (!romData) {
+		if (file) {
+			file->close(file);
+		}
+		return false;
+	}
+	romSize = size;
+	if (source) {
+		memcpy(romData, source, size);
+	} else {
+		file->seek(file, 0, SEEK_SET);
+		size_t offset = 0;
+		while (offset < size) {
+			ssize_t read = file->read(file, (uint8_t*) romData + offset, size - offset);
+			if (read <= 0) {
+				file->close(file);
+				mappedMemoryFree(romData, romSize);
+				romData = NULL;
+				romSize = 0;
+				return false;
+			}
+			offset += (size_t) read;
+		}
+		file->close(file);
+	}
+	uint8_t sha1[20];
+	sha1Buffer(romData, romSize, sha1);
+	dialogueProfile = fireRedDialogueProfileFromSha1(sha1);
+	return true;
+}
+
+static bool _initializeInstance(unsigned index) {
+	struct MultiInstance* instance = &instances[index];
+	memset(instance, 0, sizeof(*instance));
+	/* Each core needs an independent VFile cursor, but the pristine ROM bytes
+	 * are immutable and may be shared. mGBA's _pristineCow() creates private
+	 * storage before any GPIO, patch, or emulated cartridge-memory write. */
+	struct VFile* rom = VFileFromConstMemory(romData, romSize);
+	if (!rom) {
+		return false;
+	}
+	instance->core = mCoreFindVF(rom);
+	if (!instance->core) {
+		rom->close(rom);
+		return false;
+	}
+	mCoreInitConfig(instance->core, NULL);
+	if (!instance->core->init(instance->core)) {
+		mCoreConfigDeinit(&instance->core->config);
+		free(instance->core);
+		instance->core = NULL;
+		rom->close(rom);
+		return false;
+	}
+	instance->initialized = true;
+	_configureCore(instance->core);
+
+	memset(instance->video, 0, sizeof(instance->video));
+	instance->core->setVideoBuffer(instance->core, instance->video, VIDEO_STRIDE);
+	if (!instance->core->loadROM(instance->core, rom)) {
+		rom->close(rom);
+		return false;
+	}
+	size_t ewramSize = 0;
+	size_t iwramSize = 0;
+	const uint8_t* ewram = instance->core->getMemoryBlock(
+			instance->core, GBA_REGION_EWRAM, &ewramSize);
+	const uint8_t* iwram = instance->core->getMemoryBlock(
+			instance->core, GBA_REGION_IWRAM, &iwramSize);
+	fireRedDialogueInit(&instance->dialogueDetector, dialogueProfile,
+			ewram, ewramSize, iwram, iwramSize, romData, romSize);
+	instance->dialogueReleasePending = false;
+	instance->dialogueWasEnabled = false;
+	_loadBios(instance->core);
+	instance->captureAudio = false;
+	instance->audioSpeedTenths = MULTI_SPEED_ONE;
+	audioConverterResetScaled(&instance->converter,
+			instance->core->audioSampleRate(instance->core), instance->audioSpeedTenths);
+	multiAudioFifoReset(&instance->audio);
+	memset(&instance->stream, 0, sizeof(instance->stream));
+	instance->stream.audioRateChanged = _instanceAudioRateChanged;
+	instance->core->setAVStream(instance->core, &instance->stream);
+	return true;
+}
