+static void testDialogueAdvanceInputGuard(void) {
+	const uint16_t keyA = 1U << 0;
+	const uint16_t keyB = 1U << 1;
+	const uint16_t keyRight = 1U << 4;
+	const uint16_t advanceMask = keyA | keyB;
+	struct MultiDialogueInputGuard guard;
+	uint16_t keys = 0;
+
+	multiDialogueInputGuardInit(&guard);
+	assert(!guard.releasePending && !guard.advanceLockout);
+	assert(!multiDialogueInputPrepare(&guard, keyA | keyRight,
+			advanceMask, &keys));
+	assert(keys == (keyA | keyRight));
+
+	/* A physical or synthetic press earns exactly one forced released frame. */
+	multiDialogueInputAdvanced(&guard);
+	assert(guard.releasePending && guard.advanceLockout);
+	assert(multiDialogueInputPrepare(&guard, keyA | keyRight,
+			advanceMask, &keys));
+	assert(keys == keyRight);
+	assert(!guard.releasePending && guard.advanceLockout);
+
+	/* A held A, an A-to-B change, and A+B are masked without requesting more
+	 * 1x release frames. The non-dialogue buttons continue to pass through. */
+	for (unsigned tick = 0; tick < 32; ++tick) {
+		assert(!multiDialogueInputPrepare(&guard, keyA | keyRight,
+				advanceMask, &keys));
+		assert(keys == keyRight);
+	}
+	assert(!multiDialogueInputPrepare(&guard, keyB | keyRight,
+			advanceMask, &keys));
+	assert(keys == keyRight);
+	assert(!multiDialogueInputPrepare(&guard, keyA | keyB | keyRight,
+			advanceMask, &keys));
+	assert(keys == keyRight);
+
+	/* Both buttons up clears the lockout; a later press is a new edge. */
+	assert(!multiDialogueInputPrepare(&guard, keyRight,
+			advanceMask, &keys));
+	assert(keys == keyRight && !guard.advanceLockout);
+	assert(!multiDialogueInputPrepare(&guard, keyB | keyRight,
+			advanceMask, &keys));
+	assert(keys == (keyB | keyRight));
+
+	/* Defensive null handling never alters the caller's keys. */
+	keys = 0;
+	assert(!multiDialogueInputPrepare(NULL, keyA, advanceMask, &keys));
+	assert(keys == keyA);
+	assert(!multiDialogueInputPrepare(&guard, keyA, advanceMask, NULL));
+	multiDialogueInputGuardInit(NULL);
+	multiDialogueInputAdvanced(NULL);
+}
