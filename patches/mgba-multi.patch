+void retro_get_system_av_info(struct retro_system_av_info* info) {
+	memset(info, 0, sizeof(*info));
+	unsigned requestedCount = instanceCount ? instanceCount : _requestedInstanceCount();
+	unsigned width;
+	unsigned height;
+	struct MultiLayout layout;
+	if (instanceCount && _getCompositeLayout(&layout)) {
+		width = layout.width;
+		height = layout.height;
+	} else if (requestedCount == 1) {
+		width = 240;
+		height = 160;
+	} else if (requestedCount == 2) {
+		width = 480;
+		height = 270;
+	} else {
+		width = 568;
+		height = 320;
+	}
+	info->geometry.base_width = width;
+	info->geometry.base_height = height;
+	info->geometry.max_width = COMPOSITE_WIDTH_MAX;
+	info->geometry.max_height = COMPOSITE_HEIGHT_MAX;
+	info->geometry.aspect_ratio = height ? (float) width / (float) height : 0.0f;
+	if (instanceCount && instances[0].core) {
+		struct mCore* core = instances[0].core;
+		info->timing.fps = core->frequency(core) / (double) core->frameCycles(core);
+		info->timing.sample_rate = core->audioSampleRate(core);
+	} else {
+		info->timing.fps = 16777216.0 / 280896.0;
+		info->timing.sample_rate = 32768.0;
+	}
+}
+
+void retro_init(void) {
+	enum retro_pixel_format format = RETRO_PIXEL_FORMAT_RGB565;
+	environCallback(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &format);
+	useBitmasks = environCallback(RETRO_ENVIRONMENT_GET_INPUT_BITMASKS, NULL);
+
+	struct retro_input_descriptor descriptors[MULTI_MAX_INSTANCES * INPUT_DESCRIPTORS_PER_PORT + 1];
+	memset(descriptors, 0, sizeof(descriptors));
+	static const char* names[] = { "A", "B", "Select", "Start", "Right", "Left", "Up", "Down", "R", "L" };
+	unsigned port;
+	unsigned key;
+	for (port = 0; port < MULTI_MAX_INSTANCES; ++port) {
+		for (key = 0; key < sizeof(keymap) / sizeof(*keymap); ++key) {
+			struct retro_input_descriptor* descriptor = &descriptors[port * INPUT_DESCRIPTORS_PER_PORT + key];
+			descriptor->port = port;
+			descriptor->device = RETRO_DEVICE_JOYPAD;
+			descriptor->id = keymap[key];
+			descriptor->description = names[key];
+		}
+		struct retro_input_descriptor* descriptor = &descriptors[port * INPUT_DESCRIPTORS_PER_PORT + 10];
+		descriptor->port = port;
+		descriptor->device = RETRO_DEVICE_JOYPAD;
+		descriptor->id = RETRO_DEVICE_ID_JOYPAD_R2;
+		descriptor->description = "Toggle individual speed";
+	}
+	environCallback(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, descriptors);
+
+	struct retro_log_callback log;
+	if (environCallback(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log)) {
+		logCallback = log.log;
+	} else {
+		logCallback = NULL;
+	}
+	logger.log = _retroLog;
+	mLogSetDefaultLogger(&logger);
+	compositeBuffer = malloc(COMPOSITE_BUFFER_PIXELS * sizeof(*compositeBuffer));
+	compositeWidth = 0;
+	compositeHeight = 0;
+	previousLayoutValid = false;
+}
+
+void retro_deinit(void) {
+	_unloadAll();
+	free(compositeBuffer);
+	compositeBuffer = NULL;
+	free(mixedAudio);
+	mixedAudio = NULL;
+	mixedAudioCapacity = 0;
+	previousLayoutValid = false;
+	useBitmasks = false;
+}
