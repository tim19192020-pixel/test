+static const struct retro_subsystem_info subsystemInfo[] = {
+	{ "mGBA Multi (2 ROMs)", "mgba_multi_2", subsystem2Roms, 2, MULTI_SUBSYSTEM_2 },
+	{ "mGBA Multi (3 ROMs)", "mgba_multi_3", subsystem3Roms, 3, MULTI_SUBSYSTEM_3 },
+	{ NULL, NULL, NULL, 0, 0 },
+};
+
+static void _retroLog(struct mLogger* logger, int category, enum mLogLevel level, const char* format, va_list args) {
+	UNUSED(logger);
+	if (!logCallback) {
+		return;
+	}
+
+	char message[512];
+	vsnprintf(message, sizeof(message), format, args);
+	enum retro_log_level retroLevel = RETRO_LOG_INFO;
+	switch (level) {
+	case mLOG_FATAL:
+	case mLOG_ERROR:
+		retroLevel = RETRO_LOG_ERROR;
+		break;
+	case mLOG_WARN:
+		retroLevel = RETRO_LOG_WARN;
+		break;
+	case mLOG_DEBUG:
+	case mLOG_STUB:
+	case mLOG_GAME_ERROR:
+		retroLevel = RETRO_LOG_DEBUG;
+		break;
+	case mLOG_INFO:
+	default:
+		break;
+	}
+	logCallback(retroLevel, "%s: %s\n", mLogCategoryName(category), message);
+}
+
+static void _frontendLog(enum retro_log_level level, const char* format, ...) {
+	if (!logCallback) {
+		return;
+	}
+	va_list args;
+	va_start(args, format);
+	char message[512];
+	vsnprintf(message, sizeof(message), format, args);
+	va_end(args);
+	logCallback(level, "mGBA Multi: %s\n", message);
+}
+
+static const char* _getVariable(const char* key) {
+	struct retro_variable var = { key, NULL };
+	if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		return var.value;
+	}
+	return NULL;
+}
+
+static unsigned _requestedInstanceCount(void) {
+	const char* value = _getVariable("mgba_multi_instances");
+	long count = value ? strtol(value, NULL, 10) : 2;
+	if (count < 1) {
+		count = 1;
+	} else if (count > MULTI_MAX_INSTANCES) {
+		count = MULTI_MAX_INSTANCES;
+	}
+	return (unsigned) count;
+}
+
+static unsigned _requestedSpeedQuarters(unsigned player) {
+	static const char* keys[MULTI_MAX_INSTANCES] = {
+		"mgba_multi_speed_p1",
+		"mgba_multi_speed_p2",
+		"mgba_multi_speed_p3",
+	};
+	if (player >= MULTI_MAX_INSTANCES) {
+		return MULTI_SPEED_ONE;
+	}
+	const char* value = _getVariable(keys[player]);
+	if (!value) {
+		return MULTI_SPEED_ONE;
+	}
+	errno = 0;
+	char* end;
+	double speed = strtod(value, &end);
+	if (end == value || errno || speed != speed || speed <= 1.0) {
+		return MULTI_SPEED_ONE;
+	}
+	if (speed >= 3.0) {
+		return MULTI_SPEED_MAX;
+	}
+	return (unsigned) (speed * MULTI_SPEED_ONE + 0.5);
+}
+
+static void _initializeSpeedSettings(void) {
+	unsigned i;
+	for (i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		speedQuarters[i] = _requestedSpeedQuarters(i);
+		/* A configured target is armed by R2, never activated by loading content. */
+		speedEnabled[i] = false;
+		speedPhase[i] = 0;
+		speedTogglePressed[i] = false;
+	}
+}
+
+static void _updateSpeedSettings(void) {
+	unsigned i;
+	for (i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		unsigned requested = _requestedSpeedQuarters(i);
+		if (requested != speedQuarters[i]) {
+			speedQuarters[i] = requested;
+			/* Editing a target must not silently turn acceleration on. */
+			if (requested <= MULTI_SPEED_ONE) {
+				speedEnabled[i] = false;
+			}
+			speedPhase[i] = 0;
+		}
+	}
+}
+
+static unsigned _effectiveSpeedQuarters(unsigned player) {
+	if (player >= instanceCount) {
+		return MULTI_SPEED_ONE;
+	}
+	return speedEnabled[player] ? speedQuarters[player] : MULTI_SPEED_ONE;
+}
+
+static unsigned _scheduleSpeed(unsigned player) {
+	speedPhase[player] += _effectiveSpeedQuarters(player);
+	unsigned steps = speedPhase[player] / MULTI_SPEED_ONE;
+	speedPhase[player] %= MULTI_SPEED_ONE;
+	return steps;
+}
+
+static unsigned _requestedAudioSource(void) {
+	const char* value = _getVariable("mgba_multi_audio");
+	if (!value || strcmp(value, "mixed") == 0) {
+		return 0;
+	}
+	if (strcmp(value, "player 2") == 0) {
+		return 2;
+	}
+	if (strcmp(value, "player 3") == 0) {
+		return 3;
+	}
+	return 1;
+}
+
+static void _configureCore(struct mCore* core) {
+	struct mCoreOptions opts = {
+		.useBios = true,
+		.volume = 0x100,
+	};
+
+	const char* value = _getVariable("mgba_use_bios");
+	if (value) {
+		opts.useBios = strcmp(value, "ON") == 0;
+	}
+	value = _getVariable("mgba_skip_bios");
+	if (value) {
+		opts.skipBios = strcmp(value, "ON") == 0;
+	}
+	value = _getVariable("mgba_frameskip");
+	if (value) {
+		opts.frameskip = strtol(value, NULL, 10);
+	}
+
+#ifdef M_CORE_GB
+	value = _getVariable("mgba_gb_model");
+	if (value) {
+		enum GBModel model = GB_MODEL_AUTODETECT;
+		if (strcmp(value, "Game Boy") == 0) {
+			model = GB_MODEL_DMG;
+		} else if (strcmp(value, "Super Game Boy") == 0) {
+			model = GB_MODEL_SGB;
+		} else if (strcmp(value, "Game Boy Color") == 0) {
+			model = GB_MODEL_CGB;
+		} else if (strcmp(value, "Super Game Boy Color") == 0) {
+			model = GB_MODEL_SCGB;
+		} else if (strcmp(value, "Game Boy Advance") == 0) {
+			model = GB_MODEL_AGB;
+		}
+		const char* modelName = GBModelToName(model);
+		mCoreConfigSetDefaultValue(&core->config, "gb.model", modelName);
+		mCoreConfigSetDefaultValue(&core->config, "sgb.model", modelName);
+		mCoreConfigSetDefaultValue(&core->config, "cgb.model", modelName);
+		mCoreConfigSetDefaultValue(&core->config, "cgb.hybridModel", modelName);
+		mCoreConfigSetDefaultValue(&core->config, "cgb.sgbModel", modelName);
+	}
+#endif
+
+	value = _getVariable("mgba_allow_opposing_directions");
+	if (value) {
+		mCoreConfigSetDefaultIntValue(&core->config, "allowOpposingDirections", strcmp(value, "yes") == 0);
+	}
+	value = _getVariable("mgba_idle_optimization");
+	if (value) {
+		if (strcmp(value, "Don't Remove") == 0) {
+			mCoreConfigSetDefaultValue(&core->config, "idleOptimization", "ignore");
+		} else if (strcmp(value, "Detect and Remove") == 0) {
+			mCoreConfigSetDefaultValue(&core->config, "idleOptimization", "detect");
+		} else {
+			mCoreConfigSetDefaultValue(&core->config, "idleOptimization", "remove");
+		}
+	}
+
+	mCoreConfigLoadDefaults(&core->config, &opts);
+	mCoreLoadConfig(core);
+}
+
+static void _applyRuntimeSettings(void) {
+	const char* opposingDirections = _getVariable("mgba_allow_opposing_directions");
+	const char* frameskip = _getVariable("mgba_frameskip");
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		struct mCore* core = instances[i].core;
+		if (opposingDirections) {
+			mCoreConfigSetIntValue(&core->config, "allowOpposingDirections", strcmp(opposingDirections, "yes") == 0);
+			core->reloadConfigOption(core, "allowOpposingDirections", NULL);
+		}
+		if (frameskip) {
+			mCoreConfigSetIntValue(&core->config, "frameskip", strtol(frameskip, NULL, 10));
+			core->reloadConfigOption(core, "frameskip", NULL);
+		}
+	}
+	audioSource = _requestedAudioSource();
+	_updateSpeedSettings();
+
+	if (!warnedRestart && _requestedInstanceCount() != instanceCount) {
+		struct retro_message message = {
+			"Instance count change applies after content restart",
+			240,
+		};
+		environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+		_frontendLog(RETRO_LOG_INFO, "%s", message.msg);
+		warnedRestart = true;
+	}
+}
+
+static void _getPathParts(const char* path, char* directory, size_t directorySize, char* stem, size_t stemSize) {
+	const char* basename = path && path[0] ? path : "content";
+	const char* slash = strrchr(basename, '/');
+	const char* backslash = strrchr(basename, '\\');
+	if (backslash && (!slash || backslash > slash)) {
+		slash = backslash;
+	}
+	if (slash) {
+		size_t length = (size_t) (slash - basename);
+		if (length >= directorySize) {
+			length = directorySize - 1;
+		}
+		memcpy(directory, basename, length);
+		directory[length] = '\0';
+		basename = slash + 1;
+	} else {
+		directory[0] = '\0';
+	}
+
+	const char* dot = strrchr(basename, '.');
+	size_t length = dot && dot > basename ? (size_t) (dot - basename) : strlen(basename);
+	if (length >= stemSize) {
+		length = stemSize - 1;
+	}
+	memcpy(stem, basename, length);
+	stem[length] = '\0';
+	if (!stem[0]) {
+		strncpy(stem, "content", stemSize - 1);
+		stem[stemSize - 1] = '\0';
+	}
+}
+
+static void _buildSavePath(struct MultiInstance* instance, unsigned player) {
+	instance->savePath[0] = '\0';
+	if (player == 0) {
+		return;
+	}
+
+	char fallbackDir[PATH_MAX];
+	char stem[PATH_MAX];
+	_getPathParts(instance->contentPath, fallbackDir, sizeof(fallbackDir), stem, sizeof(stem));
+	const char* saveDir = NULL;
+	environCallback(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &saveDir);
+	if (!saveDir || !saveDir[0]) {
+		saveDir = fallbackDir;
+	}
+
+	char suffix[16];
+	int suffixLength = snprintf(suffix, sizeof(suffix), ".p%u.srm", player + 1);
+	if (suffixLength < 0 || (size_t) suffixLength >= sizeof(suffix)) {
+		return;
+	}
+
+	const char* separator = saveDir && saveDir[0] ? PATH_SEP : "";
+	size_t directoryLength = saveDir && saveDir[0] ? strlen(saveDir) : 0;
+	size_t separatorLength = strlen(separator);
+	size_t stemLength = strlen(stem);
+	size_t reserved = directoryLength + separatorLength + (size_t) suffixLength;
+	if (reserved >= sizeof(instance->savePath)) {
+		_frontendLog(RETRO_LOG_WARN, "save directory is too long for player %u", player + 1);
+		return;
+	}
+	if (stemLength >= sizeof(instance->savePath) - reserved) {
+		stemLength = sizeof(instance->savePath) - reserved - 1;
+	}
+
+	char* output = instance->savePath;
+	if (directoryLength) {
+		memcpy(output, saveDir, directoryLength);
+		output += directoryLength;
+	}
+	if (separatorLength) {
+		memcpy(output, separator, separatorLength);
+		output += separatorLength;
+	}
+	memcpy(output, stem, stemLength);
+	output += stemLength;
+	memcpy(output, suffix, (size_t) suffixLength + 1);
+}
+
+static void _readOwnedSave(struct MultiInstance* instance) {
+	if (!instance->savePath[0]) {
+		return;
+	}
+	struct VFile* save = VFileOpen(instance->savePath, O_RDONLY);
+	if (!save) {
+		return;
+	}
+	ssize_t size = save->read(save, instance->saveData, SAVE_BUFFER_SIZE);
+	save->close(save);
+	if (size > 0) {
+		_frontendLog(RETRO_LOG_INFO, "loaded player save %s", instance->savePath);
+	}
+}
+
+static size_t _saveRamSize(const struct MultiInstance* instance) {
+	if (!instance->core) {
+		return 0;
+	}
+	switch (instance->core->platform(instance->core)) {
+#ifdef M_CORE_GBA
+	case mPLATFORM_GBA: {
+		const struct GBA* gba = instance->core->board;
+		if (gba->memory.savedata.type == GBA_SAVEDATA_AUTODETECT) {
+			return GBA_SIZE_FLASH1M;
+		}
+		return GBASavedataSize(&gba->memory.savedata);
+	}
+#endif
+#ifdef M_CORE_GB
+	case mPLATFORM_GB:
+		return ((const struct GB*) instance->core->board)->sramSize;
+#endif
+	default:
+		return 0;
+	}
+}
+
+static size_t _rtcSize(const struct MultiInstance* instance) {
+#ifdef M_CORE_GB
+	if (instance->core && instance->core->platform(instance->core) == mPLATFORM_GB) {
+		const struct GB* gb = instance->core->board;
+		if (gb->memory.mbcType == GB_MBC3_RTC) {
+			return sizeof(struct GBMBCRTCSaveBuffer);
+		}
+	}
+#else
+	UNUSED(instance);
+#endif
+	return 0;
+}
+
+static size_t _ownedSaveSize(const struct MultiInstance* instance) {
+	size_t size = _saveRamSize(instance) + _rtcSize(instance);
+	return size < SAVE_BUFFER_SIZE ? size : SAVE_BUFFER_SIZE;
+}
+
+static bool _writeOwnedSave(struct MultiInstance* instance) {
+	if (!instance->savePath[0]) {
+		return true;
+	}
+	size_t size = _ownedSaveSize(instance);
+	if (!size) {
+		return true;
+	}
+	struct VFile* save = VFileOpen(instance->savePath, O_WRONLY | O_CREAT | O_TRUNC);
+	if (!save) {
+		_frontendLog(RETRO_LOG_ERROR, "could not create %s", instance->savePath);
+		return false;
+	}
+	bool success = save->write(save, instance->saveData, size) == (ssize_t) size;
+	save->close(save);
+	if (!success) {
+		_frontendLog(RETRO_LOG_ERROR, "could not write %s", instance->savePath);
+	}
+	return success;
+}
+
+static void _loadBios(struct MultiInstance* instance) {
+#ifdef ENABLE_VFS
+	struct mCore* core = instance->core;
+	if (!core->opts.useBios) {
+		return;
+	}
+	const char* systemDir = NULL;
+	const char* biosName = NULL;
+	environCallback(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &systemDir);
+	if (!systemDir || !systemDir[0]) {
+		return;
+	}
+
+#ifdef M_CORE_GBA
+	if (core->platform(core) == mPLATFORM_GBA) {
+		biosName = "gba_bios.bin";
+	}
+#endif
+#ifdef M_CORE_GB
+	if (core->platform(core) == mPLATFORM_GB) {
+		struct GB* gb = core->board;
+		const char* modelName = mCoreConfigGetValue(&core->config, "gb.model");
+		if (modelName) {
+			gb->model = GBNameToModel(modelName);
+		} else {
+			GBDetectModel(gb);
+		}
+		switch (gb->model) {
+		case GB_MODEL_AGB:
+		case GB_MODEL_CGB:
+		case GB_MODEL_SCGB:
+			biosName = "gbc_bios.bin";
+			break;
+		case GB_MODEL_SGB:
+			biosName = "sgb_bios.bin";
+			break;
+		case GB_MODEL_DMG:
+		default:
+			biosName = "gb_bios.bin";
+			break;
+		}
+	}
+#endif
+
+	if (biosName) {
+		char path[PATH_MAX];
+		snprintf(path, sizeof(path), "%s%s%s", systemDir, PATH_SEP, biosName);
+		struct VFile* bios = VFileOpen(path, O_RDONLY);
+		if (bios) {
+			core->loadBIOS(core, bios, 0);
+		}
+	}
+#else
+	UNUSED(instance);
+#endif
+}
+
+static bool _loadInstance(struct MultiInstance* instance, const struct retro_game_info* game, unsigned player) {
+	memset(instance, 0, sizeof(*instance));
+	struct VFile* rom = NULL;
+	if (game->path) {
+		strncpy(instance->contentPath, game->path, sizeof(instance->contentPath) - 1);
+	}
+
+	if (game->data && game->size) {
+		instance->romData = anonymousMemoryMap(game->size);
+		if (!instance->romData) {
+			return false;
+		}
+		instance->romSize = game->size;
+		memcpy(instance->romData, game->data, game->size);
+		rom = VFileFromMemory(instance->romData, game->size);
+#ifdef ENABLE_VFS
+	} else if (game->path) {
+		rom = VFileOpen(game->path, O_RDONLY);
+#endif
+	}
+	if (!rom) {
+		return false;
+	}
+
+	instance->core = mCoreFindVF(rom);
+	if (!instance->core) {
+		rom->close(rom);
+		return false;
+	}
+	mCoreInitConfig(instance->core, NULL);
+	if (!instance->core->init(instance->core)) {
+		rom->close(rom);
+		return false;
+	}
+	instance->coreInitialized = true;
+	_configureCore(instance->core);
+
+	instance->video = malloc(VIDEO_BUFFER_PIXELS * sizeof(*instance->video));
+	instance->saveData = anonymousMemoryMap(SAVE_BUFFER_SIZE);
+	if (!instance->video || !instance->saveData) {
+		return false;
+	}
+	memset(instance->video, 0, VIDEO_BUFFER_PIXELS * sizeof(*instance->video));
+	memset(instance->saveData, 0xFF, SAVE_BUFFER_SIZE);
+	instance->core->setVideoBuffer(instance->core, instance->video, VIDEO_WIDTH_MAX);
+
+	if (!instance->core->loadROM(instance->core, rom)) {
+		_frontendLog(RETRO_LOG_ERROR, "player %u ROM failed to load", player + 1);
+		return false;
+	}
+	double nominalAudioFrames = instance->core->audioSampleRate(instance->core) *
+	                            (double) instance->core->frameCycles(instance->core) /
+	                            instance->core->frequency(instance->core);
+	instance->nominalAudioFrames = (size_t) nominalAudioFrames;
+	if (!instance->nominalAudioFrames) {
+		instance->nominalAudioFrames = 1;
+	}
+	instance->audioFramesPerRunAvg = (float) instance->nominalAudioFrames;
+	/* A core can run up to three frames for one frontend frame. Four nominal
+	 * frames leave the same one-frame variation margin used by stock mGBA,
+	 * while the hard cap makes queue size and per-frame work strictly bounded. */
+	instance->audioCapacity = instance->nominalAudioFrames * (MULTI_SPEED_MAX / MULTI_SPEED_ONE + 1);
+	if (instance->audioCapacity > AUDIO_BUFFER_LIMIT) {
+		instance->audioCapacity = AUDIO_BUFFER_LIMIT;
+	}
+	instance->audio = malloc(instance->audioCapacity * 2 * sizeof(*instance->audio));
+	if (!instance->audio) {
+		return false;
+	}
+	instance->core->setAudioBufferSize(instance->core, instance->audioCapacity);
+	_loadBios(instance);
+	instance->core->reset(instance->core);
+
+	_buildSavePath(instance, player);
+	_readOwnedSave(instance);
+
+	return true;
+}
+
+static void _destroyInstance(struct MultiInstance* instance) {
+	if (instance->coreInitialized && instance->core) {
+		mCoreConfigDeinit(&instance->core->config);
+		instance->core->deinit(instance->core);
+	}
+	free(instance->video);
+	free(instance->audio);
+	if (instance->saveData) {
+		mappedMemoryFree(instance->saveData, SAVE_BUFFER_SIZE);
+	}
+	if (instance->romData) {
+		mappedMemoryFree(instance->romData, instance->romSize);
+	}
+	memset(instance, 0, sizeof(*instance));
+}
+
+static bool _finishDeferredSetup(void) {
+	if (!deferredSetup) {
+		return true;
+	}
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		struct VFile* save = VFileFromMemory(instances[i].saveData, SAVE_BUFFER_SIZE);
+		if (!save || !instances[i].core->loadSave(instances[i].core, save)) {
+			if (save) {
+				save->close(save);
+			}
+			_frontendLog(RETRO_LOG_ERROR, "player %u save memory failed to attach", i + 1);
+			return false;
+		}
+	}
+	deferredSetup = false;
+	char messageText[96];
+	snprintf(messageText, sizeof(messageText), "mGBA Multi 0.4.0: %u instance%s, direct single-thread mode",
+	         instanceCount, instanceCount == 1 ? "" : "s");
+	struct retro_message message = {
+		messageText,
+		240,
+	};
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", messageText);
+	return true;
+}
+
+static void _unloadAll(void) {
+	if (!instanceCount) {
+		return;
+	}
+
+	unsigned i;
+	for (i = 1; i < instanceCount; ++i) {
+		_writeOwnedSave(&instances[i]);
+	}
+	for (i = 0; i < instanceCount; ++i) {
+		_destroyInstance(&instances[i]);
+	}
+	instanceCount = 0;
+	deferredSetup = false;
+	warnedRestart = false;
+	autosaveCounter = 0;
+	compositeWidth = 0;
+	compositeHeight = 0;
+	previousLayoutValid = false;
+}
+
+static bool _loadGames(const struct retro_game_info* games, size_t count, bool cloneFirst) {
+	_unloadAll();
+	if (!compositeBuffer || !games || count < 1 || count > MULTI_MAX_INSTANCES) {
+		return false;
+	}
+	instanceCount = (unsigned) count;
+	audioSource = _requestedAudioSource();
+	_initializeSpeedSettings();
+
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		const struct retro_game_info* game = cloneFirst ? &games[0] : &games[i];
+		if (!_loadInstance(&instances[i], game, i)) {
+			_frontendLog(RETRO_LOG_ERROR, "failed to initialize player %u", i + 1);
+			instanceCount = i + 1;
+			_unloadAll();
+			return false;
+		}
+	}
+
+	deferredSetup = true;
+	warnedRestart = false;
+	autosaveCounter = 0;
+	return true;
+}
+
+static uint16_t _readKeys(unsigned port, bool* speedToggle) {
+	uint16_t keys = 0;
+	unsigned i;
+	if (useBitmasks) {
+		uint16_t mask = (uint16_t) inputCallback(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_MASK);
+		for (i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= ((mask >> keymap[i]) & 1) << i;
+		}
+		*speedToggle = (mask >> RETRO_DEVICE_ID_JOYPAD_R2) & 1;
+	} else {
+		for (i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= (!!inputCallback(port, RETRO_DEVICE_JOYPAD, 0, keymap[i])) << i;
+		}
+		*speedToggle = !!inputCallback(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_R2);
+	}
+	return keys;
+}
+
+static void _showSpeedMessage(unsigned player, const char* text) {
+	char messageText[96];
+	snprintf(messageText, sizeof(messageText), "Player %u speed: %s", player + 1, text);
+	struct retro_message message = {
+		messageText,
+		180,
+	};
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", messageText);
+}
+
+static void _handleSpeedToggle(unsigned player, bool pressed) {
+	if (pressed && !speedTogglePressed[player]) {
+		if (speedQuarters[player] <= MULTI_SPEED_ONE) {
+			_showSpeedMessage(player, "target is 1x; choose a faster target in Core Options");
+		} else {
+			speedEnabled[player] = !speedEnabled[player];
+			speedPhase[player] = 0;
+			if (speedEnabled[player]) {
+				char speedText[32];
+				snprintf(speedText, sizeof(speedText), "%u.%02ux enabled",
+				         speedQuarters[player] / MULTI_SPEED_ONE,
+				         (speedQuarters[player] % MULTI_SPEED_ONE) * 25);
+				_showSpeedMessage(player, speedText);
+			} else {
+				_showSpeedMessage(player, "1.00x");
+			}
+		}
+	}
+	speedTogglePressed[player] = pressed;
+}
+
+static void _setInputs(bool processHotkeys) {
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		bool speedToggle = false;
+		instances[i].core->setKeys(instances[i].core, _readKeys(i, &speedToggle));
+		if (processHotkeys) {
+			_handleSpeedToggle(i, speedToggle);
+		}
+	}
+}
+
+static bool _getCompositeLayout(struct MultiLayout* layout) {
+	memset(layout, 0, sizeof(*layout));
+	if (!instanceCount) {
+		return false;
+	}
+
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		instances[i].core->currentVideoSize(instances[i].core,
+		                                      &layout->placements[i].width,
+		                                      &layout->placements[i].height);
+		if (!layout->placements[i].width || !layout->placements[i].height ||
+		    layout->placements[i].width > VIDEO_WIDTH_MAX ||
+		    layout->placements[i].height > VIDEO_HEIGHT_MAX) {
+			return false;
+		}
+	}
+
+	if (instanceCount == 1) {
+		layout->width = layout->placements[0].width;
+		layout->height = layout->placements[0].height;
+		return true;
+	}
+
+	unsigned contentWidth;
+	unsigned contentHeight;
+	if (instanceCount == 2) {
+		contentWidth = layout->placements[0].width + layout->placements[1].width;
+		contentHeight = layout->placements[0].height > layout->placements[1].height
+			? layout->placements[0].height
+			: layout->placements[1].height;
+		layout->placements[0].x = 0;
+		layout->placements[0].y = (contentHeight - layout->placements[0].height) / 2;
+		layout->placements[1].x = layout->placements[0].width;
+		layout->placements[1].y = (contentHeight - layout->placements[1].height) / 2;
+	} else {
+		unsigned topWidth = layout->placements[0].width + layout->placements[1].width;
+		unsigned topHeight = layout->placements[0].height > layout->placements[1].height
+			? layout->placements[0].height
+			: layout->placements[1].height;
+		contentWidth = topWidth > layout->placements[2].width
+			? topWidth
+			: layout->placements[2].width;
+		contentHeight = topHeight + layout->placements[2].height;
+
+		unsigned topX = (contentWidth - topWidth) / 2;
+		layout->placements[0].x = topX;
+		layout->placements[0].y = (topHeight - layout->placements[0].height) / 2;
+		layout->placements[1].x = topX + layout->placements[0].width;
+		layout->placements[1].y = (topHeight - layout->placements[1].height) / 2;
+		layout->placements[2].x = (contentWidth - layout->placements[2].width) / 2;
+		layout->placements[2].y = topHeight;
+	}
+
+	/* Pad toward 16:9 without exceeding it. This lets RetroArch use the
+	 * largest possible uniform scale on a widescreen display, while every
+	 * instance remains at native aspect ratio. */
+	layout->width = contentWidth;
+	layout->height = contentHeight;
+	if (contentWidth * 9 < contentHeight * 16) {
+		unsigned widescreenWidth = contentHeight * 16 / 9;
+		if (widescreenWidth > layout->width) {
+			layout->width = widescreenWidth;
+		}
+	} else if (contentWidth * 9 > contentHeight * 16) {
+		unsigned widescreenHeight = contentWidth * 9 / 16;
+		if (widescreenHeight > layout->height) {
+			layout->height = widescreenHeight;
+		}
+	}
+	if (layout->width > COMPOSITE_WIDTH_MAX || layout->height > COMPOSITE_HEIGHT_MAX) {
+		return false;
+	}
+
+	unsigned xPadding = (layout->width - contentWidth) / 2;
+	unsigned yPadding = (layout->height - contentHeight) / 2;
+	for (i = 0; i < instanceCount; ++i) {
+		layout->placements[i].x += xPadding;
+		layout->placements[i].y += yPadding;
+	}
+	return true;
+}
+
+static void _updateGeometry(unsigned width, unsigned height) {
+	if (!width || !height || (width == compositeWidth && height == compositeHeight)) {
+		return;
+	}
+	compositeWidth = width;
+	compositeHeight = height;
+	struct retro_game_geometry geometry = {
+		.base_width = width,
+		.base_height = height,
+		.max_width = COMPOSITE_WIDTH_MAX,
+		.max_height = COMPOSITE_HEIGHT_MAX,
+		.aspect_ratio = (float) width / (float) height,
+	};
+	environCallback(RETRO_ENVIRONMENT_SET_GEOMETRY, &geometry);
+}
+
+static bool _prepareComposite(struct MultiLayout* layout) {
+	if (!_getCompositeLayout(layout)) {
+		return false;
+	}
+	_updateGeometry(layout->width, layout->height);
+	if (!previousLayoutValid || memcmp(&previousLayout, layout, sizeof(*layout)) != 0) {
+		memset(compositeBuffer, 0, layout->width * layout->height * sizeof(*compositeBuffer));
+		previousLayout = *layout;
+		previousLayoutValid = true;
+	}
+	return true;
+}
+
+static void _copyInstanceVideo(unsigned player, const struct MultiLayout* layout) {
+	const struct MultiPlacement* placement = &layout->placements[player];
+	unsigned y;
+	for (y = 0; y < placement->height; ++y) {
+		memcpy(&compositeBuffer[(y + placement->y) * layout->width + placement->x],
+		       &instances[player].video[y * VIDEO_WIDTH_MAX],
+		       placement->width * sizeof(*compositeBuffer));
+	}
+}
+
+static bool _ensureAudioCapacity(struct MultiInstance* instance, size_t frames) {
+	if (instance->audioCapacity >= frames) {
+		return true;
+	}
+	if (frames > AUDIO_BUFFER_LIMIT) {
+		return false;
+	}
+	int16_t* audio = realloc(instance->audio, frames * 2 * sizeof(*audio));
+	if (!audio) {
+		return false;
+	}
+	instance->audio = audio;
+	instance->audioCapacity = frames;
+	return true;
+}
+
+static void _mixAudio(const unsigned* frameSteps);
+static void _periodicSave(void);
+static bool _serializeCore(struct MultiInstance*, uint8_t*);
+static bool _unserializeCore(struct MultiInstance*, const uint8_t*);
+
+unsigned retro_api_version(void) {
