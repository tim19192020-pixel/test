+	/* 60 */  3,  3,  3,  7,  3,  4,  1,  5,  1,  1,  1,  1,  1,  1,  3,  5,
+	/* 70 */  6,  6,  1,  5,  1,  5,  1,  2,  5, 15,  3,  5,  3,  4,  2,  4,
+	/* 80 */  4,  4,  4,  4,  4,  6,  5,  5,  5,  3,  1,  1,  1,  1,  1,  3,
+	/* 90 */  6,  6,  6,  4,  1,  4,  1,  2,  3,  3,  2,  5,  3,  4,  3,  3,
+	/* A0 */  1,  5,  9,  1,  3,  1,  2,  3,  6,  5,  9,  3,  5,  5,  1,  5,
+	/* B0 */  5,  1,  1,  3,  3,  3,  6,  1,  5,  5,  5,  6,  6,  5,  5,  6,
+	/* C0 */  3,  3,  3,  2,  8,  1,  4,  2,  5,  1,  1,  1,  6,  3,  3,  1,
+	/* D0 */  3,  8,  4,  5,  6,
+};
+
+struct FireRedTailState {
+	uint32_t cursor;
+	uint32_t stack[FIRERED_CONTEXT_STACK_COUNT];
+	uint8_t stackDepth;
+};
+
+enum FireRedTailProofMark {
+	FIRERED_PROOF_VISITING = 1,
+	FIRERED_PROOF_SAFE,
+	FIRERED_PROOF_UNSAFE,
+};
+
+struct FireRedTailProofNode {
+	struct FireRedTailState state;
+	uint8_t mark;
+};
+
+struct FireRedTailProof {
+	const struct FireRedDialogueDetector* detector;
+	const struct FireRedDialogueProfileData* profile;
+	struct FireRedTailProofNode nodes[FIRERED_TAIL_PROOF_MAX_STATES];
+	unsigned nodeCount;
+};
+
+static bool _tailStateEquals(const struct FireRedTailState* left,
+		const struct FireRedTailState* right) {
+	return left->cursor == right->cursor &&
+			left->stackDepth == right->stackDepth &&
+			!memcmp(left->stack, right->stack,
+					left->stackDepth * sizeof(*left->stack));
+}
+
+static bool _advanceTailState(struct FireRedTailState* state, unsigned width) {
+	if (!width || state->cursor > UINT32_MAX - width) {
+		return false;
+	}
+	state->cursor += width;
+	return true;
+}
+
+static bool _isMessageStd(uint8_t standardScript) {
+	return standardScript == FIRERED_STD_MSGBOX_NPC ||
+			standardScript == FIRERED_STD_MSGBOX_SIGN ||
+			standardScript == FIRERED_STD_MSGBOX_DEFAULT ||
+			standardScript == FIRERED_STD_MSGBOX_AUTO_CLOSE;
+}
+
+static bool _isForbiddenTailOpcode(uint8_t opcode) {
+	if (opcode >= 0x23U && opcode <= 0x27U) { /* native/special/waitstate */
+		return true;
+	}
+	if (opcode >= 0x5CU && opcode <= 0x5FU) { /* trainer battle/control */
+		return true;
+	}
+	if (opcode >= 0x6EU && opcode <= 0x71U) { /* choices */
+		return true;
+	}
+	if ((opcode >= 0x86U && opcode <= 0x89U) ||
+			(opcode >= 0x8BU && opcode <= 0x8EU) ||
+			(opcode >= 0xB1U && opcode <= 0xB2U)) { /* menus/link modes */
+		return true;
+	}
+	if ((opcode >= 0xB6U && opcode <= 0xBFU) || opcode == 0xCFU ||
+			opcode == 0x0CU) { /* wild battle/dynamic or RAM scripts */
+		return true;
+	}
+	return false;
+}
+
+static bool _proveTailState(struct FireRedTailProof* proof,
+		const struct FireRedTailState* input) {
+	for (unsigned i = 0; i < proof->nodeCount; ++i) {
+		struct FireRedTailProofNode* existing = &proof->nodes[i];
+		if (!_tailStateEquals(&existing->state, input)) {
+			continue;
+		}
+		/* A back-edge is an unproved infinite path and therefore fails closed. */
+		return existing->mark == FIRERED_PROOF_SAFE;
+	}
+	if (proof->nodeCount >= FIRERED_TAIL_PROOF_MAX_STATES) {
+		return false;
+	}
+
+	struct FireRedTailProofNode* node = &proof->nodes[proof->nodeCount++];
+	node->state = *input;
+	node->mark = FIRERED_PROOF_VISITING;
+	struct FireRedTailState next = *input;
+	uint8_t opcode;
+	bool safe = false;
+	if (_isTrainerScript(proof->profile, input->cursor) ||
+			!_readRom8(proof->detector, input->cursor, &opcode)) {
+		goto done;
+	}
+
+	if (opcode == FIRERED_CMD_END || opcode == FIRERED_CMD_END_RAM) {
+		safe = true;
+		goto done;
+	}
+	if (opcode == FIRERED_CMD_RETURN) {
+		if (!next.stackDepth) {
+			safe = true;
+			goto done;
+		}
+		next.cursor = next.stack[--next.stackDepth];
+		safe = _proveTailState(proof, &next);
+		goto done;
+	}
+	/* These start a new, separately-guarded text/wait boundary. */
+	if (opcode == FIRERED_CMD_MESSAGE || opcode == 0x78U ||
+			opcode == FIRERED_CMD_WAIT_BUTTON_PRESS ||
+			opcode == FIRERED_CMD_MESSAGE_AUTO_SCROLL) {
+		unsigned width = sFireRedCommandWidths[opcode];
+		uint8_t unused;
+		safe = width && input->cursor <= UINT32_MAX - (width - 1U) &&
+				_readRom8(proof->detector, input->cursor + width - 1U, &unused);
+		goto done;
+	}
+	if (_isForbiddenTailOpcode(opcode)) {
+		goto done;
+	}
+
+	if (opcode >= FIRERED_CMD_CALL && opcode <= FIRERED_CMD_CALL_IF) {
+		bool conditional = opcode == FIRERED_CMD_GOTO_IF ||
+				opcode == FIRERED_CMD_CALL_IF;
+		bool call = opcode == FIRERED_CMD_CALL || opcode == FIRERED_CMD_CALL_IF;
+		unsigned width = conditional ? 6U : 5U;
+		uint32_t target;
+		if (!_readRom32(proof->detector,
+				input->cursor + (conditional ? 2U : 1U), &target)) {
+			goto done;
+		}
+		if (conditional) {
+			struct FireRedTailState fallthrough = *input;
+			if (!_advanceTailState(&fallthrough, width) ||
+					!_proveTailState(proof, &fallthrough)) {
+				goto done;
+			}
+		}
+		next.cursor = target;
+		if (call) {
+			if ((unsigned) next.stackDepth + 1U >=
+					FIRERED_CONTEXT_STACK_COUNT ||
+					input->cursor > UINT32_MAX - width) {
+				goto done;
+			}
+			next.stack[next.stackDepth++] = input->cursor + width;
+		}
+		safe = _proveTailState(proof, &next);
+		goto done;
+	}
+
+	if (opcode >= FIRERED_CMD_GOTO_STD && opcode <= FIRERED_CMD_CALL_STD_IF) {
+		bool conditional = opcode == FIRERED_CMD_GOTO_STD_IF ||
+				opcode == FIRERED_CMD_CALL_STD_IF;
+		bool call = opcode == FIRERED_CMD_CALL_STD ||
+				opcode == FIRERED_CMD_CALL_STD_IF;
+		unsigned width = conditional ? 3U : 2U;
+		uint8_t standardScript;
+		if (!_readRom8(proof->detector,
+				input->cursor + (conditional ? 2U : 1U), &standardScript) ||
+				standardScript >= 10U || standardScript == 5U) {
+			goto done;
+		}
+		if (conditional) {
+			struct FireRedTailState fallthrough = *input;
+			if (!_advanceTailState(&fallthrough, width) ||
+					!_proveTailState(proof, &fallthrough)) {
+				goto done;
+			}
+		}
+		if (_isMessageStd(standardScript)) {
+			safe = true;
+			goto done;
+		}
+		if (!_readRom32(proof->detector,
+				proof->profile->stdScriptsTable +
+				standardScript * sizeof(uint32_t), &next.cursor)) {
+			goto done;
+		}
+		if (call) {
+			if ((unsigned) next.stackDepth + 1U >=
+					FIRERED_CONTEXT_STACK_COUNT ||
+					input->cursor > UINT32_MAX - width) {
+				goto done;
+			}
+			next.stack[next.stackDepth++] = input->cursor + width;
+		}
+		safe = _proveTailState(proof, &next);
+		goto done;
+	}
+
+	if (opcode >= FIRERED_SCRIPT_COMMAND_COUNT ||
+			!sFireRedCommandWidths[opcode] ||
+			!_advanceTailState(&next, sFireRedCommandWidths[opcode])) {
+		goto done;
+	}
+	safe = _proveTailState(proof, &next);
+
+done:
+	node->mark = safe ? FIRERED_PROOF_SAFE : FIRERED_PROOF_UNSAFE;
+	return safe;
+}
+
+/* Preserve the original, deliberately tiny proof for terminal auto-A. The CFG
+ * below only expands speed-up eligibility and can never auto-execute its tail. */
+static bool _hasPureClosure(const struct FireRedDialogueDetector* detector,
+		const struct FireRedDialogueProfileData* profile,
+		uint32_t scriptPointer, uint8_t stackDepth) {
+	if (stackDepth + 1U >= FIRERED_CONTEXT_STACK_COUNT ||
+			scriptPointer == UINT32_MAX) {
+		return false;
+	}
+	uint32_t cursor = scriptPointer + 1U;
+	for (unsigned step = 0; step < FIRERED_CONTEXT_STACK_COUNT * 2U + 4U;
+			++step) {
+		uint8_t opcode;
+		if (_isTrainerScript(profile, cursor) ||
+				!_readRom8(detector, cursor, &opcode)) {
+			return false;
+		}
+		if (opcode == FIRERED_CMD_END) {
+			return true;
+		}
+		if (opcode == FIRERED_CMD_RETURN) {
+			if (!stackDepth) {
+				return true;
+			}
+			if (!_readIwram32(detector,
+					FIRERED_GLOBAL_CONTEXT + FIRERED_CONTEXT_STACK_OFFSET +
+					--stackDepth * sizeof(uint32_t), &cursor)) {
+				return false;
+			}
+			continue;
+		}
+		if (opcode != FIRERED_CMD_CLOSE_MESSAGE &&
+				opcode != FIRERED_CMD_RELEASE_ALL &&
+				opcode != FIRERED_CMD_RELEASE) {
+			return false;
+		}
+		if (cursor == UINT32_MAX) {
+			return false;
+		}
+		++cursor;
+	}
+	return false;
+}
+
+static enum FireRedTailSafety _classifyTail(
+		const struct FireRedDialogueDetector* detector,
+		const struct FireRedDialogueProfileData* profile,
+		uint32_t scriptPointer, uint8_t stackDepth) {
+	if (_hasPureClosure(detector, profile, scriptPointer, stackDepth)) {
+		return FIRERED_TAIL_SAFE_TERMINAL;
+	}
+	if (stackDepth + 1U >= FIRERED_CONTEXT_STACK_COUNT ||
+			scriptPointer == UINT32_MAX) {
+		return FIRERED_TAIL_FORBIDDEN;
+	}
+
+	struct FireRedTailProof proof;
+	memset(&proof, 0, sizeof(proof));
+	proof.detector = detector;
+	proof.profile = profile;
+	struct FireRedTailState initial;
+	memset(&initial, 0, sizeof(initial));
+	initial.cursor = scriptPointer + 1U;
+	initial.stackDepth = stackDepth;
+	for (uint8_t i = 0; i < stackDepth; ++i) {
+		if (!_readIwram32(detector,
+				FIRERED_GLOBAL_CONTEXT + FIRERED_CONTEXT_STACK_OFFSET +
+				i * sizeof(uint32_t), &initial.stack[i])) {
+			return FIRERED_TAIL_FORBIDDEN;
+		}
+	}
+	return _proveTailState(&proof, &initial) ?
+			FIRERED_TAIL_BENIGN_NO_TERMINAL : FIRERED_TAIL_FORBIDDEN;
+}
+
+static void _block(struct FireRedDialogueDetector* detector) {
+	detector->sessionArmed = false;
+	detector->terminalAutoAdvanceSafe = false;
+	detector->armedScriptPointer = 0;
+	memset(detector->armedStack, 0, sizeof(detector->armedStack));
+	detector->armedStackDepth = 0;
+	detector->terminalStage = FIRERED_TERMINAL_NONE;
+	detector->lastState = FIRERED_DIALOGUE_BLOCKED;
+}
+
+static bool _taskState(const struct FireRedDialogueDetector* detector,
+		const struct FireRedDialogueProfileData* profile, bool* drawTaskActive,
+		bool* forbiddenTaskActive) {
+	*drawTaskActive = false;
+	*forbiddenTaskActive = false;
+	for (unsigned i = 0; i < FIRERED_TASK_COUNT; ++i) {
+		uint32_t task = FIRERED_TASKS + i * FIRERED_TASK_STRIDE;
+		uint8_t active;
+		uint32_t function;
+		if (!_readIwram8(detector, task + FIRERED_TASK_ACTIVE_OFFSET, &active) ||
+				!_readIwram32(detector, task + FIRERED_TASK_FUNC_OFFSET, &function)) {
+			return false;
+		}
+		if (!active) {
+			continue;
+		}
+
+		function = _codeAddress(function);
+		if (function == profile->taskDrawFieldMessageBox) {
+			*drawTaskActive = true;
+		}
+		if (function == profile->taskBattleStart ||
+				function == profile->choiceTasks[0] ||
+				function == profile->choiceTasks[1] ||
+				function == profile->choiceTasks[2]) {
+			*forbiddenTaskActive = true;
+		}
+	}
+	return true;
+}
+
+enum FireRedDialogueProfile fireRedDialogueProfileFromSha1(
+		const uint8_t sha1[20]) {
+	if (!sha1) {
+		return FIRERED_DIALOGUE_PROFILE_UNSUPPORTED;
+	}
+	if (!memcmp(sha1, sFireRed10Sha1, sizeof(sFireRed10Sha1))) {
+		return FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0;
+	}
+	if (!memcmp(sha1, sFireRed11Sha1, sizeof(sFireRed11Sha1))) {
+		return FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1;
+	}
+	return FIRERED_DIALOGUE_PROFILE_UNSUPPORTED;
+}
+
+bool fireRedDialogueProfileSupported(enum FireRedDialogueProfile profile) {
+	return profile == FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0 ||
+			profile == FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1;
+}
+
+void fireRedDialogueInit(struct FireRedDialogueDetector* detector,
+		enum FireRedDialogueProfile profile,
+		const uint8_t* ewram, size_t ewramSize,
+		const uint8_t* iwram, size_t iwramSize,
+		const uint8_t* rom, size_t romSize) {
+	if (!detector) {
+		return;
+	}
+	memset(detector, 0, sizeof(*detector));
+	if (!fireRedDialogueProfileSupported(profile) ||
+			!ewram || !iwram || !rom) {
+		return;
+	}
+
+	detector->profile = profile;
+	detector->ewram = ewram;
+	detector->ewramSize = ewramSize;
+	detector->iwram = iwram;
+	detector->iwramSize = iwramSize;
+	detector->rom = rom;
+	detector->romSize = romSize;
+	detector->lastState = FIRERED_DIALOGUE_BLOCKED;
+
+	/* Validate every fixed span once. Dynamic script pointers are checked on
+	 * every classification before the ROM is dereferenced. */
+	size_t unused;
+	const struct FireRedDialogueProfileData* profileData = _profile(detector);
+	bool safeWaitsValid = true;
+	for (unsigned i = 0; i < FIRERED_SAFE_MSGBOX_COUNT; ++i) {
+		if (!_addressOffset(profileData->safeMsgboxWaits[i], FIRERED_ROM_BASE,
+				romSize, 1, &unused)) {
+			safeWaitsValid = false;
+			break;
+		}
+	}
+	if (!_addressOffset(FIRERED_TEXT_PRINTER_0 + FIRERED_TEXT_PRINTER_STATE_OFFSET,
+			FIRERED_EWRAM_BASE, ewramSize, 1, &unused) ||
+			!_addressOffset(FIRERED_MESSAGE_BOX_TYPE, FIRERED_EWRAM_BASE,
+				ewramSize, 1, &unused) ||
+			!_addressOffset(FIRERED_GLOBAL_CONTEXT + FIRERED_CONTEXT_SCRIPT_PTR_OFFSET,
+				FIRERED_IWRAM_BASE, iwramSize, 4, &unused) ||
+			!_addressOffset(FIRERED_MAIN + FIRERED_MAIN_IN_BATTLE_OFFSET,
+				FIRERED_IWRAM_BASE, iwramSize, 1, &unused) ||
+			!_addressOffset(FIRERED_TASKS +
+					(FIRERED_TASK_COUNT - 1) * FIRERED_TASK_STRIDE +
+					FIRERED_TASK_ACTIVE_OFFSET,
+				FIRERED_IWRAM_BASE, iwramSize, 1, &unused) ||
+			!_addressOffset(profileData->trainerScriptEnd - 1,
+				FIRERED_ROM_BASE, romSize, 1, &unused) || !safeWaitsValid) {
+		memset(detector, 0, sizeof(*detector));
+		return;
+	}
+}
+
+void fireRedDialogueReset(struct FireRedDialogueDetector* detector) {
+	if (detector) {
+		_block(detector);
+		detector->cachedTailValid = false;
+		detector->cachedScriptPointer = 0;
+		memset(detector->cachedStack, 0, sizeof(detector->cachedStack));
+		detector->cachedStackDepth = 0;
+		detector->cachedTailSafety = FIRERED_TAIL_FORBIDDEN;
+	}
+}
+
+enum FireRedDialogueState fireRedDialogueInspect(
+		struct FireRedDialogueDetector* detector) {
+	const struct FireRedDialogueProfileData* profile = _profile(detector);
+	if (!profile) {
+		return FIRERED_DIALOGUE_BLOCKED;
+	}
+
+	uint8_t inBattle;
+	uint8_t status;
+	uint8_t stackDepth;
+	uint8_t mode;
+	uint8_t messageBoxType;
+	uint8_t printerActive;
+	uint8_t printerState;
+	uint32_t callback2;
+	uint32_t nativePointer;
+	uint32_t scriptPointer;
+	uint32_t stackSnapshot[FIRERED_CONTEXT_STACK_COUNT] = { 0 };
+	bool drawTaskActive;
+	bool forbiddenTaskActive;
+	if (!_readIwram32(detector, FIRERED_MAIN + FIRERED_MAIN_CALLBACK2_OFFSET,
+			&callback2) ||
+			!_readIwram8(detector, FIRERED_MAIN + FIRERED_MAIN_IN_BATTLE_OFFSET,
+				&inBattle) ||
+			!_readIwram8(detector, FIRERED_GLOBAL_CONTEXT_STATUS, &status) ||
+			!_readIwram8(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_STACK_DEPTH_OFFSET, &stackDepth) ||
+			!_readIwram8(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_MODE_OFFSET, &mode) ||
+			!_readIwram32(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_NATIVE_PTR_OFFSET, &nativePointer) ||
+			!_readIwram32(detector, FIRERED_GLOBAL_CONTEXT +
+				FIRERED_CONTEXT_SCRIPT_PTR_OFFSET, &scriptPointer) ||
+			!_readEwram8(detector, FIRERED_MESSAGE_BOX_TYPE, &messageBoxType) ||
+			!_readEwram8(detector, FIRERED_TEXT_PRINTER_0 +
+				FIRERED_TEXT_PRINTER_ACTIVE_OFFSET, &printerActive) ||
+			!_readEwram8(detector, FIRERED_TEXT_PRINTER_0 +
+				FIRERED_TEXT_PRINTER_STATE_OFFSET, &printerState) ||
+			!_taskState(detector, profile, &drawTaskActive,
+				&forbiddenTaskActive)) {
+		_block(detector);
+		return detector->lastState;
+	}
+
+	callback2 = _codeAddress(callback2);
+	nativePointer = _codeAddress(nativePointer);
+	if (callback2 != profile->callback2Overworld ||
+			(inBattle & FIRERED_MAIN_IN_BATTLE_MASK) ||
+			status != FIRERED_CONTEXT_RUNNING || forbiddenTaskActive ||
+			!_safeStackContext(detector, profile, scriptPointer, stackDepth,
+				stackSnapshot)) {
+		_block(detector);
+		return detector->lastState;
+	}
+
+	uint8_t nextCommand = 0;
+	bool hasNextCommand = _readRom8(detector, scriptPointer, &nextCommand);
+	if (!hasNextCommand) {
+		_block(detector);
+		return detector->lastState;
+	}
+	bool scriptAtWaitButton = nextCommand == FIRERED_CMD_WAIT_BUTTON_PRESS;
+	bool scriptAtSafeMsgboxWait = scriptAtWaitButton &&
+			_isSafeMsgboxWait(profile, scriptPointer);
+	bool hiddenTerminal = messageBoxType == FIRERED_MESSAGE_BOX_HIDDEN &&
+			!printerActive && !drawTaskActive;
+	if (detector->sessionArmed &&
+			(detector->armedStackDepth != stackDepth ||
+			 !_stackEquals(detector->armedStack, stackSnapshot, stackDepth))) {
+		_block(detector);
+		return detector->lastState;
+	}
+
+	/* A session can only be armed by one of this exact ROM revision's four
+	 * non-choice standard msgbox waits. Classify the immutable script tail once
+	 * per active message, while retaining all live battle/task checks above for
+	 * every accelerated subframe. */
+	if (mode == FIRERED_SCRIPT_MODE_NATIVE &&
+			nativePointer == profile->isFieldMessageBoxHidden &&
+			scriptAtSafeMsgboxWait &&
+			messageBoxType == FIRERED_MESSAGE_BOX_NORMAL &&
+			printerActive && drawTaskActive) {
+		bool sameMessage = detector->sessionArmed &&
+				detector->terminalStage == FIRERED_TERMINAL_MESSAGE &&
+				detector->armedScriptPointer == scriptPointer &&
+				detector->armedStackDepth == stackDepth &&
+				_stackEquals(detector->armedStack, stackSnapshot, stackDepth);
+		if (!sameMessage) {
+			enum FireRedTailSafety tailSafety;
+			if (detector->cachedTailValid &&
+					detector->cachedScriptPointer == scriptPointer &&
+					detector->cachedStackDepth == stackDepth &&
+					_stackEquals(detector->cachedStack, stackSnapshot, stackDepth)) {
+				tailSafety = (enum FireRedTailSafety) detector->cachedTailSafety;
+			} else {
+				tailSafety = _classifyTail(detector, profile, scriptPointer,
+						stackDepth);
+				detector->cachedTailValid = true;
+				detector->cachedScriptPointer = scriptPointer;
+				memcpy(detector->cachedStack, stackSnapshot,
+						stackDepth * sizeof(*stackSnapshot));
+				detector->cachedStackDepth = stackDepth;
+				detector->cachedTailSafety = (unsigned) tailSafety;
+			}
+			if (tailSafety == FIRERED_TAIL_FORBIDDEN) {
+				_block(detector);
+				return detector->lastState;
+			}
+			detector->terminalAutoAdvanceSafe =
+					tailSafety == FIRERED_TAIL_SAFE_TERMINAL;
+			detector->armedScriptPointer = scriptPointer;
+			memcpy(detector->armedStack, stackSnapshot,
+					stackDepth * sizeof(*stackSnapshot));
+			detector->armedStackDepth = stackDepth;
+		}
+		detector->sessionArmed = true;
+		detector->terminalStage = FIRERED_TERMINAL_MESSAGE;
+		if (printerState == 0 || printerState == 4 ||
+				printerState == 5 || printerState == 6) {
+			detector->lastState = FIRERED_DIALOGUE_PRINTING;
+			return detector->lastState;
+		}
+		if (printerState == 1 || printerState == 2 || printerState == 3) {
+			detector->lastState = FIRERED_DIALOGUE_PAGE_WAIT;
+			return detector->lastState;
+		}
+		_block(detector);
+		return detector->lastState;
+	}
+
+	if (!detector->sessionArmed || !hiddenTerminal) {
+		_block(detector);
+		return detector->lastState;
+	}
+
+	if (mode == FIRERED_SCRIPT_MODE_NATIVE &&
+			nativePointer == profile->isFieldMessageBoxHidden &&
+			scriptPointer == detector->armedScriptPointer &&
+			scriptAtSafeMsgboxWait &&
+			(detector->terminalStage == FIRERED_TERMINAL_MESSAGE ||
+			 detector->terminalStage == FIRERED_TERMINAL_HIDDEN_NATIVE)) {
+		detector->terminalStage = FIRERED_TERMINAL_HIDDEN_NATIVE;
+		detector->lastState = FIRERED_DIALOGUE_TERMINAL_PENDING;
+		return detector->lastState;
+	}
+
+	if (mode == FIRERED_SCRIPT_MODE_BYTECODE &&
+			scriptPointer == detector->armedScriptPointer &&
+			scriptAtSafeMsgboxWait &&
+			(detector->terminalStage == FIRERED_TERMINAL_HIDDEN_NATIVE ||
+			 detector->terminalStage == FIRERED_TERMINAL_BYTECODE)) {
+		detector->terminalStage = FIRERED_TERMINAL_BYTECODE;
+		detector->lastState = FIRERED_DIALOGUE_TERMINAL_PENDING;
+		return detector->lastState;
+	}
+
+	if (mode == FIRERED_SCRIPT_MODE_NATIVE &&
+			nativePointer == profile->waitForAorBPress &&
+			detector->armedScriptPointer != UINT32_MAX &&
+			scriptPointer == detector->armedScriptPointer + 1U &&
+			(detector->terminalStage == FIRERED_TERMINAL_BYTECODE ||
+			 detector->terminalStage == FIRERED_TERMINAL_WAIT)) {
+		detector->terminalStage = FIRERED_TERMINAL_WAIT;
+		detector->lastState = FIRERED_DIALOGUE_TERMINAL_WAIT;
+		return detector->lastState;
+	}
+
+	_block(detector);
+	return detector->lastState;
+}
+
+bool fireRedDialogueCanAutoAdvanceTerminal(
+		const struct FireRedDialogueDetector* detector) {
+	return detector && detector->sessionArmed &&
+			detector->terminalAutoAdvanceSafe;
+}
+
+void fireRedDialogueConsumeTerminal(struct FireRedDialogueDetector* detector) {
+	if (!detector || !detector->sessionArmed ||
+			!detector->terminalAutoAdvanceSafe ||
+			detector->terminalStage != FIRERED_TERMINAL_WAIT ||
+			detector->lastState != FIRERED_DIALOGUE_TERMINAL_WAIT) {
+		return;
+	}
+	_block(detector);
+}
diff --git a/src/platform/libretro/libretro_firered_dialogue.h b/src/platform/libretro/libretro_firered_dialogue.h
new file mode 100644
index 0000000..6e2d7ce
--- /dev/null
+++ b/src/platform/libretro/libretro_firered_dialogue.h
@@ -0,0 +1,77 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef LIBRETRO_FIRERED_DIALOGUE_H
+#define LIBRETRO_FIRERED_DIALOGUE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define FIRERED_DIALOGUE_STACK_COUNT 20
+
+enum FireRedDialogueState {
+	FIRERED_DIALOGUE_BLOCKED,
+	FIRERED_DIALOGUE_PRINTING,
+	FIRERED_DIALOGUE_PAGE_WAIT,
+	FIRERED_DIALOGUE_TERMINAL_PENDING,
+	FIRERED_DIALOGUE_TERMINAL_WAIT,
+};
+
+enum FireRedDialogueProfile {
+	FIRERED_DIALOGUE_PROFILE_UNSUPPORTED,
+	FIRERED_DIALOGUE_PROFILE_ENGLISH_1_0,
+	FIRERED_DIALOGUE_PROFILE_ENGLISH_1_1,
+};
+
+/* The memory pointers are borrowed and must remain valid until the next init.
+ * The remaining fields include internal state so callers can allocate one
+ * independent detector per emulated instance without allocation. */
+struct FireRedDialogueDetector {
+	const uint8_t* ewram;
+	size_t ewramSize;
+	const uint8_t* iwram;
+	size_t iwramSize;
+	const uint8_t* rom;
+	size_t romSize;
+	enum FireRedDialogueProfile profile;
+	uint32_t armedScriptPointer;
+	uint32_t cachedScriptPointer;
+	uint32_t armedStack[FIRERED_DIALOGUE_STACK_COUNT];
+	uint32_t cachedStack[FIRERED_DIALOGUE_STACK_COUNT];
+	unsigned terminalStage;
+	unsigned cachedTailSafety;
+	enum FireRedDialogueState lastState;
+	uint8_t armedStackDepth;
+	uint8_t cachedStackDepth;
+	bool sessionArmed;
+	bool terminalAutoAdvanceSafe;
+	bool cachedTailValid;
+};
+
+enum FireRedDialogueProfile fireRedDialogueProfileFromSha1(
+		const uint8_t sha1[20]);
+bool fireRedDialogueProfileSupported(enum FireRedDialogueProfile profile);
+void fireRedDialogueInit(struct FireRedDialogueDetector* detector,
+		enum FireRedDialogueProfile profile,
+		const uint8_t* ewram, size_t ewramSize,
+		const uint8_t* iwram, size_t iwramSize,
+		const uint8_t* rom, size_t romSize);
+void fireRedDialogueReset(struct FireRedDialogueDetector* detector);
+enum FireRedDialogueState fireRedDialogueInspect(
+		struct FireRedDialogueDetector* detector);
+
+/* True only when the currently armed message has a fully proven cosmetic
+ * closure. A benign scripted continuation may still be accelerated while its
+ * final input is deliberately left to the player. */
+bool fireRedDialogueCanAutoAdvanceTerminal(
+		const struct FireRedDialogueDetector* detector);
+
+/* Consumes a verified terminal wait, if present, and disarms the session. This
+ * makes an injected button a one-shot and prevents it advancing the script
+ * state that follows the dialogue. */
+void fireRedDialogueConsumeTerminal(struct FireRedDialogueDetector* detector);
+
+#endif
diff --git a/src/platform/libretro/libretro_firered_iv.c b/src/platform/libretro/libretro_firered_iv.c
new file mode 100644
index 0000000..e016394
--- /dev/null
+++ b/src/platform/libretro/libretro_firered_iv.c
@@ -0,0 +1,241 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "libretro_firered_iv.h"
+
+#include <string.h>
+
+#define FIRERED_EWRAM_BASE 0x02000000U
+#define FIRERED_PARTY_COUNT_ADDRESS 0x02024029U
+#define FIRERED_PARTY_ADDRESS 0x02024284U
+#define FIRERED_PARTY_RECORD_SIZE 100U
+
+#define FIRERED_PERSONALITY_OFFSET 0U
+#define FIRERED_OT_ID_OFFSET 4U
+#define FIRERED_NICKNAME_OFFSET 8U
+#define FIRERED_NICKNAME_LENGTH 10U
+#define FIRERED_LANGUAGE_OFFSET 18U
+#define FIRERED_FLAGS_OFFSET 19U
+#define FIRERED_CHECKSUM_OFFSET 28U
+#define FIRERED_SECURE_OFFSET 32U
+#define FIRERED_SECURE_SIZE 48U
+#define FIRERED_LEVEL_OFFSET 84U
+
+#define FIRERED_FLAG_BAD_EGG 0x01U
+#define FIRERED_FLAG_HAS_SPECIES 0x02U
+#define FIRERED_FLAG_EGG 0x04U
+#define FIRERED_SUBSTRUCT_SIZE 12U
+#define FIRERED_GROWTH 0U
+#define FIRERED_MISC 3U
+
+/* Physical position of each logical substruct for personality % 24. */
+static const uint8_t sSubstructOffset[24][4] = {
+	{ 0, 1, 2, 3 }, { 0, 1, 3, 2 }, { 0, 2, 1, 3 },
+	{ 0, 3, 1, 2 }, { 0, 2, 3, 1 }, { 0, 3, 2, 1 },
+	{ 1, 0, 2, 3 }, { 1, 0, 3, 2 }, { 2, 0, 1, 3 },
+	{ 3, 0, 1, 2 }, { 2, 0, 3, 1 }, { 3, 0, 2, 1 },
+	{ 1, 2, 0, 3 }, { 1, 3, 0, 2 }, { 2, 1, 0, 3 },
+	{ 3, 1, 0, 2 }, { 2, 3, 0, 1 }, { 3, 2, 0, 1 },
+	{ 1, 2, 3, 0 }, { 1, 3, 2, 0 }, { 2, 1, 3, 0 },
+	{ 3, 1, 2, 0 }, { 2, 3, 1, 0 }, { 3, 2, 1, 0 },
+};
+
+static uint16_t _read16(const uint8_t* data) {
+	return (uint16_t) ((uint16_t) data[0] | (uint16_t) data[1] << 8);
+}
+
+static uint32_t _read32(const uint8_t* data) {
+	return (uint32_t) data[0] |
+			(uint32_t) data[1] << 8 |
+			(uint32_t) data[2] << 16 |
+			(uint32_t) data[3] << 24;
+}
+
+static void _write32(uint8_t* data, uint32_t value) {
+	data[0] = (uint8_t) value;
+	data[1] = (uint8_t) (value >> 8);
+	data[2] = (uint8_t) (value >> 16);
+	data[3] = (uint8_t) (value >> 24);
+}
+
+static bool _range(size_t size, size_t offset, size_t length) {
+	return offset <= size && length <= size - offset;
+}
+
+static unsigned _physicalSubstruct(unsigned permutation, unsigned logical) {
+	return sSubstructOffset[permutation][logical];
+}
+
+static char _nicknameCharacter(uint8_t character) {
+	if (character >= 0xA1U && character <= 0xAAU) {
+		return (char) ('0' + character - 0xA1U);
+	}
+	if (character >= 0xBBU && character <= 0xD4U) {
+		return (char) ('A' + character - 0xBBU);
+	}
+	if (character >= 0xD5U && character <= 0xEEU) {
+		return (char) ('a' + character - 0xD5U);
+	}
+
+	switch (character) {
+	case 0x00: return ' ';
+	case 0x01: case 0x02: case 0x03: return 'A';
+	case 0x04: return 'C';
+	case 0x05: case 0x06: case 0x07: case 0x08: return 'E';
+	case 0x09: case 0x0B: case 0x0C: case 0x5A: return 'I';
+	case 0x0D: case 0x0E: case 0x0F: case 0x10: return 'O';
+	case 0x11: case 0x12: case 0x13: return 'U';
+	case 0x14: return 'N';
+	case 0x15: return 's';
+	case 0x16: case 0x17: case 0x68: return 'a';
+	case 0x19: return 'c';
+	case 0x1A: case 0x1B: case 0x1C: case 0x1D: return 'e';
+	case 0x1E: case 0x20: case 0x21: case 0x6F: return 'i';
+	case 0x22: case 0x23: case 0x24: case 0x25: return 'o';
+	case 0x26: case 0x27: case 0x28: return 'u';
+	case 0x29: return 'n';
+	case 0x2D: return '&';
+	case 0x2E: return '+';
+	case 0x35: return '=';
+	case 0x36: return ';';
+	case 0x5B: return '%';
+	case 0x5C: return '(';
+	case 0x5D: return ')';
+	case 0x85: return '<';
+	case 0x86: return '>';
+	case 0xAB: return '!';
+	case 0xAC: return '?';
+	case 0xAD: return '.';
+	case 0xAE: return '-';
+	case 0xB4: return '\'';
+	case 0xB5: return 'M';
+	case 0xB6: return 'F';
+	case 0xB8: return ',';
+	case 0xBA: return '/';
+	case 0xF0: return ':';
+	case 0xF1: return 'A';
+	case 0xF2: return 'O';
+	case 0xF3: return 'U';
+	case 0xF4: return 'a';
+	case 0xF5: return 'o';
+	case 0xF6: return 'u';
+	default: return '?';
+	}
+}
+
+static bool _westernLanguage(uint8_t language) {
+	return language == 2U || language == 3U || language == 4U ||
+			language == 5U || language == 7U;
+}
+
+static void _readNickname(const uint8_t* record,
+		char nickname[FIRERED_IV_NICKNAME_CAPACITY]) {
+	unsigned output = 0;
+	bool western = _westernLanguage(record[FIRERED_LANGUAGE_OFFSET]);
+	for (unsigned i = 0; i < FIRERED_NICKNAME_LENGTH; ++i) {
+		uint8_t character = record[FIRERED_NICKNAME_OFFSET + i];
+		if (character == 0xFFU) {
+			break;
+		}
+		/* Japanese glyphs share byte values with unrelated Western glyphs. A
+		 * single-byte ASCII overlay cannot transliterate them faithfully. */
+		nickname[output++] = western ? _nicknameCharacter(character) : '?';
+	}
+	nickname[output] = '\0';
+}
+
+static bool _validSpecies(uint16_t species) {
+	return species >= 1U && species <= 411U &&
+			(species < 252U || species > 276U);
+}
+
+static void _setCorrupt(struct FireRedIvPokemon* pokemon) {
+	memset(pokemon, 0, sizeof(*pokemon));
+	pokemon->status = FIRERED_IV_CORRUPT;
+}
+
+static void _readPokemon(const uint8_t* record,
+		struct FireRedIvPokemon* pokemon) {
+	uint8_t decrypted[FIRERED_SECURE_SIZE];
+	uint32_t personality = _read32(record + FIRERED_PERSONALITY_OFFSET);
+	uint32_t key = personality ^ _read32(record + FIRERED_OT_ID_OFFSET);
+	uint16_t checksum = 0;
+
+	if (!(record[FIRERED_FLAGS_OFFSET] & FIRERED_FLAG_HAS_SPECIES)) {
+		return;
+	}
+	_readNickname(record, pokemon->nickname);
+	pokemon->level = record[FIRERED_LEVEL_OFFSET];
+	for (unsigned offset = 0; offset < FIRERED_SECURE_SIZE; offset += 4) {
+		_write32(decrypted + offset,
+				_read32(record + FIRERED_SECURE_OFFSET + offset) ^ key);
+	}
+	for (unsigned offset = 0; offset < FIRERED_SECURE_SIZE; offset += 2) {
+		checksum = (uint16_t) (checksum + _read16(decrypted + offset));
+	}
+	if (checksum != _read16(record + FIRERED_CHECKSUM_OFFSET)) {
+		_setCorrupt(pokemon);
+		return;
+	}
+
+	unsigned permutation = personality % 24U;
+	unsigned growth = _physicalSubstruct(permutation, FIRERED_GROWTH);
+	unsigned misc = _physicalSubstruct(permutation, FIRERED_MISC);
+	if (growth >= 4U || misc >= 4U) {
+		_setCorrupt(pokemon);
+		return;
+	}
+
+	pokemon->species = _read16(decrypted + growth * FIRERED_SUBSTRUCT_SIZE);
+	uint32_t ivWord = _read32(decrypted + misc * FIRERED_SUBSTRUCT_SIZE + 4U);
+	pokemon->ivs[FIRERED_IV_HP] = (uint8_t) (ivWord & 31U);
+	pokemon->ivs[FIRERED_IV_ATK] = (uint8_t) ((ivWord >> 5) & 31U);
+	pokemon->ivs[FIRERED_IV_DEF] = (uint8_t) ((ivWord >> 10) & 31U);
+	pokemon->ivs[FIRERED_IV_SPE] = (uint8_t) ((ivWord >> 15) & 31U);
+	pokemon->ivs[FIRERED_IV_SPA] = (uint8_t) ((ivWord >> 20) & 31U);
+	pokemon->ivs[FIRERED_IV_SPD] = (uint8_t) ((ivWord >> 25) & 31U);
+
+	bool outerEgg = (record[FIRERED_FLAGS_OFFSET] & FIRERED_FLAG_EGG) != 0;
+	bool innerEgg = (ivWord & (UINT32_C(1) << 30)) != 0;
+	if ((record[FIRERED_FLAGS_OFFSET] & FIRERED_FLAG_BAD_EGG) ||
+			outerEgg != innerEgg || !_validSpecies(pokemon->species) ||
+			(!outerEgg && (pokemon->level < 1U || pokemon->level > 100U))) {
+		_setCorrupt(pokemon);
+	} else if (outerEgg) {
+		pokemon->status = FIRERED_IV_EGG;
+	} else {
+		pokemon->status = FIRERED_IV_VALID;
+	}
+}
+
+bool fireRedIvReadParty(bool supported, const uint8_t* ewram, size_t ewramSize,
+		struct FireRedIvParty* party) {
+	if (!party) {
+		return false;
+	}
+	memset(party, 0, sizeof(*party));
+	if (!supported || !ewram) {
+		return false;
+	}
+
+	size_t countOffset = FIRERED_PARTY_COUNT_ADDRESS - FIRERED_EWRAM_BASE;
+	size_t partyOffset = FIRERED_PARTY_ADDRESS - FIRERED_EWRAM_BASE;
+	if (!_range(ewramSize, countOffset, 1U) ||
+			!_range(ewramSize, partyOffset,
+				FIRERED_IV_PARTY_CAPACITY * FIRERED_PARTY_RECORD_SIZE)) {
+		return false;
+	}
+
+	unsigned count = ewram[countOffset];
+	if (count > FIRERED_IV_PARTY_CAPACITY) {
+		return false;
+	}
+	party->partyCount = count;
+	for (unsigned i = 0; i < count; ++i) {
+		_readPokemon(ewram + partyOffset + i * FIRERED_PARTY_RECORD_SIZE,
+				&party->pokemon[i]);
+	}
+	return true;
+}
