+	return multiScreenOrderParse(_getVariable("mgba_multi_screen_order"));
+}
+
+static unsigned _requestedDialogueSpeedTenths(void) {
+	return multiDialogueParseTarget(_getVariable("mgba_multi_dialogue_speed"));
+}
+
+static bool _requestedDialogueAutoAdvance(void) {
+	const char* value = _getVariable("mgba_multi_dialogue_auto_advance");
+	return !value || strcmp(value, "Disabled") != 0;
+}
+
+static unsigned _effectiveAudioSpeed(unsigned player) {
+	return player < MULTI_MAX_INSTANCES ? multiSpeedEffectiveTenths(&speedState[player]) :
+			MULTI_SPEED_ONE;
+}
+
+static void _initializeRuntimeSettings(void) {
+	audioMode = _requestedAudioMode();
+	screenOrder = _requestedScreenOrder();
+	dialogueSpeedTenths = _requestedDialogueSpeedTenths();
+	dialogueAutoAdvance = _requestedDialogueAutoAdvance();
+	for (unsigned i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		multiSpeedInit(&speedState[i]);
+		multiSpeedSetTarget(&speedState[i], _requestedSpeedTenths(i));
+		multiDialogueToggleInit(&dialogueToggleState[i]);
+		multiIvCheckerInit(&ivCheckerState[i]);
+	}
+}
+
+static void _updateRuntimeSettings(void) {
+	audioMode = _requestedAudioMode();
+	screenOrder = _requestedScreenOrder();
+	dialogueSpeedTenths = _requestedDialogueSpeedTenths();
+	dialogueAutoAdvance = _requestedDialogueAutoAdvance();
+	for (unsigned i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		multiSpeedSetTarget(&speedState[i], _requestedSpeedTenths(i));
+	}
+}
+
+static void _configureCore(struct mCore* core) {
+	struct mCoreOptions options;
+	memset(&options, 0, sizeof(options));
+	options.useBios = true;
+	options.volume = 0x100;
+	options.frameskip = 0;
+	options.audioBuffers = AUDIO_CORE_CAPACITY;
+
+	mCoreConfigSetDefaultValue(&core->config, "idleOptimization", "remove");
+	mCoreConfigSetDefaultIntValue(&core->config, "frameskip", 0);
+	mCoreConfigLoadDefaults(&core->config, &options);
+	/* Do not read the standalone mGBA configuration file. This frontend has a
+	 * sealed baseline, so unrelated desktop settings cannot enable frameskip,
+	 * mute audio, or change synchronization behind RetroArch's back. */
+	mCoreLoadForeignConfig(core, &core->config);
+	core->setSync(core, NULL);
+	core->setAudioBufferSize(core, AUDIO_CORE_CAPACITY);
+}
+
+static void _loadBios(struct mCore* core) {
+#ifdef ENABLE_VFS
+	if (!core->opts.useBios || !environCallback) {
+		core->opts.useBios = false;
+		return;
+	}
+	const char* systemDirectory = NULL;
+	if (!environCallback(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &systemDirectory) ||
+			!systemDirectory || !systemDirectory[0]) {
+		core->opts.useBios = false;
+		return;
+	}
+	char path[PATH_MAX];
+	int length = snprintf(path, sizeof(path), "%s%s%s", systemDirectory, PATH_SEP, "gba_bios.bin");
+	if (length < 0 || (size_t) length >= sizeof(path)) {
+		core->opts.useBios = false;
+		return;
+	}
+	struct VFile* bios = VFileOpen(path, O_RDONLY);
+	if (bios) {
+		core->loadBIOS(core, bios, 0);
+		if (((struct GBA*) core->board)->biosVf != bios) {
+			bios->close(bios);
+		}
+	}
+	/* Resets may run on worker lanes. Finalize BIOS discovery here on the
+	 * libretro caller so mGBA never retries VFS access from a worker. */
+	core->opts.useBios = ((struct GBA*) core->board)->biosVf != NULL;
+#else
+	core->opts.useBios = false;
+	UNUSED(core);
+#endif
+}
+
+static bool _copyRom(const struct retro_game_info* game) {
+	dialogueProfile = FIRERED_DIALOGUE_PROFILE_UNSUPPORTED;
+	if (!game) {
+		return false;
+	}
+	struct VFile* file = NULL;
+	const void* source = game->data;
+	size_t size = game->size;
+	if (!source || !size) {
+		/* Treat data and size as one validity pair. Some frontends provide a
+		 * non-NULL placeholder with size zero while also supplying a path. */
+		source = NULL;
+		if (!game->path || !game->path[0]) {
+			return false;
+		}
+		file = VFileOpen(game->path, O_RDONLY);
+		if (!file) {
+			return false;
+		}
+		off_t fileSize = file->size(file);
+		if (fileSize <= 0 || (uint64_t) fileSize > SIZE_MAX) {
+			file->close(file);
+			return false;
+		}
+		size = (size_t) fileSize;
+	}
+
+	romData = anonymousMemoryMap(size);
+	if (!romData) {
+		if (file) {
+			file->close(file);
+		}
+		return false;
+	}
+	romSize = size;
+	if (source) {
+		memcpy(romData, source, size);
+	} else {
+		file->seek(file, 0, SEEK_SET);
+		size_t offset = 0;
+		while (offset < size) {
+			ssize_t read = file->read(file, (uint8_t*) romData + offset, size - offset);
+			if (read <= 0) {
+				file->close(file);
+				mappedMemoryFree(romData, romSize);
+				romData = NULL;
+				romSize = 0;
+				return false;
+			}
+			offset += (size_t) read;
+		}
+		file->close(file);
+	}
+	uint8_t sha1[20];
+	sha1Buffer(romData, romSize, sha1);
+	dialogueProfile = fireRedDialogueProfileFromSha1(sha1);
+	return true;
+}
+
+static bool _initializeInstance(unsigned index) {
+	struct MultiInstance* instance = &instances[index];
+	memset(instance, 0, sizeof(*instance));
+	/* Each core needs an independent VFile cursor, but the pristine ROM bytes
+	 * are immutable and may be shared. mGBA's _pristineCow() creates private
+	 * storage before any GPIO, patch, or emulated cartridge-memory write. */
+	struct VFile* rom = VFileFromConstMemory(romData, romSize);
+	if (!rom) {
+		return false;
+	}
+	instance->core = mCoreFindVF(rom);
+	if (!instance->core) {
+		rom->close(rom);
+		return false;
+	}
+	mCoreInitConfig(instance->core, NULL);
+	if (!instance->core->init(instance->core)) {
+		mCoreConfigDeinit(&instance->core->config);
+		free(instance->core);
+		instance->core = NULL;
+		rom->close(rom);
+		return false;
+	}
+	instance->initialized = true;
+	_configureCore(instance->core);
+
+	memset(instance->video, 0, sizeof(instance->video));
+	instance->core->setVideoBuffer(instance->core, instance->video, VIDEO_STRIDE);
+	if (!instance->core->loadROM(instance->core, rom)) {
+		rom->close(rom);
+		return false;
+	}
+	size_t ewramSize = 0;
+	size_t iwramSize = 0;
+	const uint8_t* ewram = instance->core->getMemoryBlock(
+			instance->core, GBA_REGION_EWRAM, &ewramSize);
+	const uint8_t* iwram = instance->core->getMemoryBlock(
+			instance->core, GBA_REGION_IWRAM, &iwramSize);
+	fireRedDialogueInit(&instance->dialogueDetector, dialogueProfile,
+			ewram, ewramSize, iwram, iwramSize, romData, romSize);
+	instance->ewram = ewram;
+	instance->ewramSize = ewramSize;
+	memset(&instance->ivParty, 0, sizeof(instance->ivParty));
+	multiDialogueInputGuardInit(&instance->dialogueInput);
+	instance->dialogueWasEnabled = false;
+	_loadBios(instance->core);
+	instance->captureAudio = false;
+	instance->audioSpeedTenths = MULTI_SPEED_ONE;
+	audioConverterResetScaled(&instance->converter,
+			instance->core->audioSampleRate(instance->core), instance->audioSpeedTenths);
+	multiAudioFifoReset(&instance->audio);
+	memset(&instance->stream, 0, sizeof(instance->stream));
+	instance->stream.audioRateChanged = _instanceAudioRateChanged;
+	instance->core->setAVStream(instance->core, &instance->stream);
+	return true;
+}
+
+static void _stopWorkers(void);
+
+static void _destroyContent(void) {
+	_stopWorkers();
+	for (unsigned i = 0; i < MULTI_MAX_INSTANCES; ++i) {
+		struct MultiInstance* instance = &instances[i];
+		if (instance->initialized && instance->core) {
+			struct GBA* gba = instance->core->board;
+			if (gba->memory.hw.devices & HW_RTC) {
+				GBASavedataRTCWrite(&gba->memory.savedata);
+				size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+				multiSaveMirrorRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+						SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer));
+			}
+			instance->core->setAVStream(instance->core, NULL);
+			mCoreConfigDeinit(&instance->core->config);
+			instance->core->deinit(instance->core);
+		}
+		memset(instance, 0, sizeof(*instance));
+	}
+	if (romData) {
+		mappedMemoryFree(romData, romSize);
+		romData = NULL;
+	}
+	romSize = 0;
+	dialogueProfile = FIRERED_DIALOGUE_PROFILE_UNSUPPORTED;
+	instanceCount = 0;
+	deferredSetup = false;
+	fatalLoadError = false;
+	multiAudioClockReset(&audioClock);
+}
+
+static void _setInstanceAudioSpeed(unsigned index, unsigned speedTenths) {
+	struct MultiInstance* instance = &instances[index];
+	if (instance->audioSpeedTenths == speedTenths) {
+		return;
+	}
+	/* Finish or discard samples produced at the old emulation ratio before
+	 * resetting the scaled converter. The FIFO is intentionally cleared: an
+	 * old-ratio lead must never turn into delayed audio after a mode change. */
+	_captureOrDiscardInstanceAudio(instance);
+	instance->audioSpeedTenths = speedTenths;
+	audioConverterResetScaled(&instance->converter,
+			instance->core->audioSampleRate(instance->core), speedTenths);
+	multiAudioFifoReset(&instance->audio);
+}
+
+static void _runCoreFrames(unsigned index, uint16_t keys, unsigned frameSteps,
+		unsigned maximumFrames) {
+	struct MultiInstance* instance = &instances[index];
+	struct GBA* gba = instance->core->board;
+	if (frameSteps < 1) {
+		frameSteps = 1;
+	} else if (frameSteps > maximumFrames) {
+		frameSteps = maximumFrames;
+	}
+	instance->core->setKeys(instance->core, keys);
+	for (unsigned step = 0; step < frameSteps; ++step) {
+		/* Emulation, DMA, timers, and audio always run. Only software rendering
+		 * is skipped for intermediate accelerated frames. */
+		if (frameSteps > 1) {
+			gba->video.frameskipCounter = step + 1 < frameSteps ? 1 : 0;
+		}
+		instance->core->runFrame(instance->core);
+		if (step + 1 < frameSteps) {
+			/* At 262144 Hz one frame can contain about 4389 samples. Drain or
+			 * discard between subframes so the fixed raw ring can never backlog. */
+			_captureOrDiscardInstanceAudio(instance);
+		}
+	}
+	if (frameSteps > 1) {
+		gba->video.frameskipCounter = 0;
+	}
+}
+
+static void _resetDialogueRuntime(struct MultiInstance* instance) {
+	fireRedDialogueReset(&instance->dialogueDetector);
+	multiDialogueInputGuardInit(&instance->dialogueInput);
+	instance->dialogueWasEnabled = false;
+}
+
+static void _disableDialogueRuntime(struct MultiInstance* instance) {
+	fireRedDialogueReset(&instance->dialogueDetector);
+	instance->dialogueWasEnabled = false;
+}
+
+static void _runInstanceEmulation(unsigned index,
+		const struct MultiFrameCommand* command) {
+	struct MultiInstance* instance = &instances[index];
+	const uint16_t advanceMask = (uint16_t) ((1U << GBA_KEY_A) | (1U << GBA_KEY_B));
+	uint16_t guardedKeys;
+	bool forceReleaseFrame = multiDialogueInputPrepare(&instance->dialogueInput,
+			command->keys, advanceMask, &guardedKeys);
+	bool physicalAdvance = (guardedKeys & advanceMask) != 0;
+
+	/* This is the steady-state fast path. With dialogue assist off there are no
+	 * emulated-memory reads and the proven manual scheduler remains unchanged. */
+	if (!command->dialogueEnabled && !forceReleaseFrame) {
+		if (instance->dialogueWasEnabled) {
+			_disableDialogueRuntime(instance);
+		}
+		_setInstanceAudioSpeed(index, command->manualSpeedTenths);
+		_runCoreFrames(index, guardedKeys, command->manualFrames,
+				MULTI_SPEED_MAX_FRAMES);
+		return;
+	}
+
+	/* Every automatic or physical advance observed during an assisted dialogue
+	 * is followed by exactly one emulated frame with A/B released. This is done
+	 * before any new classification so the press cannot leak into a menu or
+	 * battle created by the preceding script command. A held physical button is
+	 * masked afterward, but it no longer stalls accelerated printing at 1x. */
+	if (forceReleaseFrame) {
+		_setInstanceAudioSpeed(index, MULTI_SPEED_ONE);
+		_runCoreFrames(index, guardedKeys & ~advanceMask, 1, 1);
+		if (!command->dialogueEnabled) {
+			_disableDialogueRuntime(instance);
+		}
+		return;
+	}
+
+	if (!command->dialogueEnabled) {
+		_disableDialogueRuntime(instance);
+		_setInstanceAudioSpeed(index, command->manualSpeedTenths);
+		_runCoreFrames(index, guardedKeys, command->manualFrames,
+				MULTI_SPEED_MAX_FRAMES);
+		return;
+	}
+	if (!instance->dialogueWasEnabled) {
+		fireRedDialogueReset(&instance->dialogueDetector);
+		instance->dialogueWasEnabled = true;
+	}
+
+	enum FireRedDialogueState state =
+			fireRedDialogueInspect(&instance->dialogueDetector);
+	if (state == FIRERED_DIALOGUE_BLOCKED) {
+		_setInstanceAudioSpeed(index, command->manualSpeedTenths);
+		_runCoreFrames(index, guardedKeys, command->manualFrames,
+				MULTI_SPEED_MAX_FRAMES);
+		return;
+	}
+
+	/* Do not repeat a physically held A/B across an accelerated batch. Waiting
+	 * for a clean release also guarantees that a later synthetic A has an edge. */
+	if (physicalAdvance) {
+		_setInstanceAudioSpeed(index, MULTI_SPEED_ONE);
+		_runCoreFrames(index, guardedKeys, 1, 1);
+		multiDialogueInputAdvanced(&instance->dialogueInput);
+		return;
+	}
+
+	uint16_t releasedKeys = guardedKeys & ~advanceMask;
+	if (state == FIRERED_DIALOGUE_PRINTING) {
+		unsigned frameBudget = command->dialogueSpeedTenths / MULTI_SPEED_ONE;
+		if (frameBudget < MULTI_DIALOGUE_MIN_TENTHS / MULTI_SPEED_ONE) {
+			frameBudget = MULTI_DIALOGUE_MIN_TENTHS / MULTI_SPEED_ONE;
+		} else if (frameBudget > MULTI_DIALOGUE_MAX_FRAMES) {
+			frameBudget = MULTI_DIALOGUE_MAX_FRAMES;
+		}
+		_setInstanceAudioSpeed(index, command->dialogueSpeedTenths);
+		struct GBA* gba = instance->core->board;
+		instance->core->setKeys(instance->core, releasedKeys);
+		bool needsBoundaryFrame = false;
+		for (unsigned step = 0; step < frameBudget; ++step) {
+			if (step && fireRedDialogueInspect(&instance->dialogueDetector) !=
+					FIRERED_DIALOGUE_PRINTING) {
+				needsBoundaryFrame = true;
+				break;
+			}
+			gba->video.frameskipCounter = step + 1 < frameBudget ? 1 : 0;
+			instance->core->runFrame(instance->core);
+			if (step + 1 < frameBudget) {
+				_captureOrDiscardInstanceAudio(instance);
+			}
+		}
+		gba->video.frameskipCounter = 0;
+		if (needsBoundaryFrame) {
+			/* The preceding subframe was intentionally not rendered because more
+			 * printing frames were expected. Render one released frame at 1x so a
+			 * completed page cannot disappear before auto-advance. This remains
+			 * within the original frame budget because at least one planned
+			 * accelerated subframe was not executed. */
+			_setInstanceAudioSpeed(index, MULTI_SPEED_ONE);
+			_runCoreFrames(index, releasedKeys, 1, 1);
+		}
+		return;
+	}
+
+	_setInstanceAudioSpeed(index, MULTI_SPEED_ONE);
+	if (state == FIRERED_DIALOGUE_PAGE_WAIT && command->dialogueAutoAdvance) {
+		_runCoreFrames(index, releasedKeys | (1U << GBA_KEY_A), 1, 1);
+		multiDialogueInputAdvanced(&instance->dialogueInput);
+		return;
+	}
+	if (state == FIRERED_DIALOGUE_TERMINAL_WAIT && command->dialogueAutoAdvance &&
+			fireRedDialogueCanAutoAdvanceTerminal(&instance->dialogueDetector)) {
+		_runCoreFrames(index, releasedKeys | (1U << GBA_KEY_A), 1, 1);
+		fireRedDialogueConsumeTerminal(&instance->dialogueDetector);
+		multiDialogueInputAdvanced(&instance->dialogueInput);
+		return;
+	}
+
+	/* Page waits with auto-advance disabled, and the verified transition into a
+	 * terminal wait, always advance by one real emulated frame at 1x. */
+	_runCoreFrames(index, releasedKeys, 1, 1);
+}
+
+static void _runInstanceFrames(unsigned index,
+		const struct MultiFrameCommand* command) {
+	struct MultiInstance* instance = &instances[index];
+	_runInstanceEmulation(index, command);
+	if (command->ivRefreshRequested) {
+		fireRedIvReadParty(
+				fireRedDialogueProfileSupported(instance->dialogueDetector.profile),
+				instance->ewram, instance->ewramSize, &instance->ivParty);
+	}
+}
+
+static void* _workerMain(void* context) {
+	struct MultiWorker* worker = context;
+	uint64_t observedGeneration = 0;
+	pthread_mutex_lock(&workerMutex);
+	while (!workerStop) {
+		while (!workerStop && workerGeneration == observedGeneration) {
+			pthread_cond_wait(&workerWake, &workerMutex);
+		}
+		if (workerStop) {
+			break;
+		}
+
+		uint64_t generation = workerGeneration;
+		enum MultiWorkerCommand command = workerCommand;
+		struct MultiFrameCommand frame = workerFrames[worker->instance];
+		pthread_mutex_unlock(&workerMutex);
+
+		struct mCore* core = instances[worker->instance].core;
+		if (command == WORKER_COMMAND_FRAME) {
+			_runInstanceFrames(worker->instance, &frame);
+		} else if (command == WORKER_COMMAND_RESET) {
+			core->reset(core);
+			_resetDialogueRuntime(&instances[worker->instance]);
+		}
+
+		pthread_mutex_lock(&workerMutex);
+		observedGeneration = generation;
+		worker->completedGeneration = generation;
+		if (workerPending) {
+			--workerPending;
+			if (!workerPending) {
+				pthread_cond_signal(&workerDone);
+			}
+		}
+	}
+	pthread_mutex_unlock(&workerMutex);
+	return NULL;
+}
+
+static bool _startWorkers(void) {
+	if (instanceCount < 2 || !_parallelRequested()) {
+		parallelActive = false;
+		return true;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerStop = false;
+	workerPending = 0;
+	workerCommand = WORKER_COMMAND_NONE;
+	workerGeneration = 0;
+	pthread_mutex_unlock(&workerMutex);
+
+	for (unsigned i = 1; i < instanceCount; ++i) {
+		workers[i].instance = i;
+		workers[i].completedGeneration = 0;
+		int error = pthread_create(&workers[i].thread, NULL, _workerMain, &workers[i]);
+		if (error) {
+			_frontendLog(RETRO_LOG_WARN,
+					"could not create Player %u worker (%d); using sequential execution", i + 1, error);
+			pthread_mutex_lock(&workerMutex);
+			workerStop = true;
+			pthread_cond_broadcast(&workerWake);
+			pthread_mutex_unlock(&workerMutex);
+			for (unsigned j = 1; j < i; ++j) {
+				if (workers[j].started) {
+					pthread_join(workers[j].thread, NULL);
+					workers[j].started = false;
+				}
+			}
+			pthread_mutex_lock(&workerMutex);
+			workerStop = false;
+			pthread_mutex_unlock(&workerMutex);
+			parallelActive = false;
+			return true;
+		}
+		workers[i].started = true;
+	}
+	parallelActive = true;
+	return true;
+}
+
+static void _stopWorkers(void) {
+	bool anyStarted = false;
+	for (unsigned i = 1; i < MULTI_MAX_INSTANCES; ++i) {
+		anyStarted |= workers[i].started;
+	}
+	if (!anyStarted) {
+		parallelActive = false;
+		return;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerStop = true;
+	pthread_cond_broadcast(&workerWake);
+	pthread_mutex_unlock(&workerMutex);
+	for (unsigned i = 1; i < MULTI_MAX_INSTANCES; ++i) {
+		if (workers[i].started) {
+			pthread_join(workers[i].thread, NULL);
+			workers[i].started = false;
+		}
+	}
+	pthread_mutex_lock(&workerMutex);
+	workerPending = 0;
+	workerCommand = WORKER_COMMAND_NONE;
+	workerStop = false;
+	pthread_mutex_unlock(&workerMutex);
+	parallelActive = false;
+}
+
+static void _executeBatch(enum MultiWorkerCommand command,
+		const struct MultiFrameCommand* frames) {
+	if (!parallelActive) {
+		for (unsigned i = 0; i < instanceCount; ++i) {
+			if (command == WORKER_COMMAND_FRAME) {
+				_runInstanceFrames(i, &frames[i]);
+			} else if (command == WORKER_COMMAND_RESET) {
+				instances[i].core->reset(instances[i].core);
+				_resetDialogueRuntime(&instances[i]);
+			}
+		}
+		return;
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	workerCommand = command;
+	if (frames) {
+		memcpy(workerFrames, frames, instanceCount * sizeof(*frames));
+	}
+	workerPending = instanceCount - 1;
+	++workerGeneration;
+	pthread_cond_broadcast(&workerWake);
+	pthread_mutex_unlock(&workerMutex);
+
+	if (command == WORKER_COMMAND_FRAME) {
+		_runInstanceFrames(0, &frames[0]);
+	} else if (command == WORKER_COMMAND_RESET) {
+		instances[0].core->reset(instances[0].core);
+		_resetDialogueRuntime(&instances[0]);
+	}
+
+	pthread_mutex_lock(&workerMutex);
+	while (workerPending) {
+		pthread_cond_wait(&workerDone, &workerMutex);
+	}
+	pthread_mutex_unlock(&workerMutex);
+}
+
+static void _resetInstanceAudioPipeline(unsigned index, bool capture, unsigned speedTenths) {
+	struct MultiInstance* instance = &instances[index];
+	instance->captureAudio = capture;
+	instance->audioSpeedTenths = speedTenths;
+	mAudioBufferClear(instance->core->getAudioBuffer(instance->core));
+	audioConverterResetScaled(&instance->converter,
+			instance->core->audioSampleRate(instance->core), speedTenths);
+	multiAudioFifoReset(&instance->audio);
+}
+
+static void _prepareAudioPipelines(void) {
+	int selected = multiAudioSelectedIndex(audioMode, instanceCount);
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		bool capture = selected >= 0 && i == (unsigned) selected;
+		if (instances[i].captureAudio != capture) {
+			/* Speed changes belong to the instance's owner lane. A frontend audio
+			 * routing change happens between worker generations and preserves the
+			 * currently active conversion ratio. */
+			_resetInstanceAudioPipeline(i, capture,
+					instances[i].audioSpeedTenths);
+		}
+	}
+}
+
+static void _resetAudioPipeline(bool resetClock) {
+	if (resetClock) {
+		multiAudioClockReset(&audioClock);
+	}
+	int selected = multiAudioSelectedIndex(audioMode, instanceCount);
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		_resetInstanceAudioPipeline(i, selected >= 0 && i == (unsigned) selected,
+				_effectiveAudioSpeed(i));
+	}
+}
+
+static bool _finishDeferredSetup(void) {
+	if (!deferredSetup) {
+		return !fatalLoadError;
+	}
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct mCore* core = instances[i].core;
+		core->reset(core);
+		_resetDialogueRuntime(&instances[i]);
+		struct VFile* save = VFileFromMemory(saveData[i], SAVE_SLOT_SIZE);
+		if (!save || !core->loadSave(core, save)) {
+			if (save) {
+				save->close(save);
+			}
+			_frontendLog(RETRO_LOG_ERROR, "could not attach Player %u save slice", i + 1);
+			fatalLoadError = true;
+			deferredSetup = false;
+			return false;
+		}
+		struct GBA* gba = core->board;
+		if (gba->memory.hw.devices & HW_RTC) {
+			size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+			if (multiSaveRestoreRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+						SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer))) {
+				GBASavedataRTCRead(&gba->memory.savedata);
+			}
+		}
+	}
+	_resetAudioPipeline(true);
+	_startWorkers();
+	deferredSetup = false;
+
+	char text[128];
+	snprintf(text, sizeof(text), "mGBA Multi %s: %u instance%s, %s execution",
+			MULTI_FRONTEND_VERSION, instanceCount, instanceCount == 1 ? "" : "s",
+			parallelActive ? "parallel" : "direct");
+	struct retro_message message = { text, 240 };
+	if (environCallback) {
+		environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	}
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+	return true;
+}
+
+static uint16_t _readKeys(unsigned port, bool* speedToggle, bool* dialogueToggle,
+		bool* ivToggle) {
+	if (speedToggle) {
+		*speedToggle = false;
+	}
+	if (dialogueToggle) {
+		*dialogueToggle = false;
+	}
+	if (ivToggle) {
+		*ivToggle = false;
+	}
+	if (!inputCallback) {
+		return 0;
+	}
+	uint16_t keys = 0;
+	if (useBitmasks) {
+		uint16_t mask = (uint16_t) inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+				RETRO_DEVICE_ID_JOYPAD_MASK);
+		for (unsigned i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= ((mask >> keymap[i]) & 1U) << i;
+		}
+		if (speedToggle) {
+			*speedToggle = (mask >> RETRO_DEVICE_ID_JOYPAD_R2) & 1U;
+		}
+		if (dialogueToggle) {
+			*dialogueToggle = (mask >> RETRO_DEVICE_ID_JOYPAD_L2) & 1U;
+		}
+		if (ivToggle) {
+			*ivToggle = (mask >> RETRO_DEVICE_ID_JOYPAD_X) & 1U;
+		}
+	} else {
+		for (unsigned i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= (!!inputCallback(port, RETRO_DEVICE_JOYPAD, 0, keymap[i])) << i;
+		}
+		if (speedToggle) {
+			*speedToggle = !!inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+					RETRO_DEVICE_ID_JOYPAD_R2);
+		}
+		if (dialogueToggle) {
+			*dialogueToggle = !!inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+					RETRO_DEVICE_ID_JOYPAD_L2);
+		}
+		if (ivToggle) {
+			*ivToggle = !!inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+					RETRO_DEVICE_ID_JOYPAD_X);
+		}
+	}
+	return keys;
+}
+
+static void _showSpeedMessage(unsigned player) {
+	if (!environCallback) {
+		return;
+	}
+	char text[96];
+	if (!speedState[player].enabled) {
+		snprintf(text, sizeof(text), "Player %u speed: 1.0x", player + 1);
+	} else {
+		unsigned speed = speedState[player].targetTenths;
+		snprintf(text, sizeof(text), "Player %u speed: %u.%ux", player + 1,
+				speed / 10, speed % 10);
+	}
+	struct retro_message message = { text, 180 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _showInactiveSpeedMessage(unsigned player) {
+	if (!environCallback) {
+		return;
+	}
+	char text[112];
+	snprintf(text, sizeof(text),
+			"Player %u speed target is 1.0x; select a faster target in Core Options",
+			player + 1);
+	struct retro_message message = { text, 180 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _showDialogueMessage(unsigned player,
+		enum MultiDialogueToggleResult result) {
+	if (!environCallback || result == MULTI_DIALOGUE_TOGGLE_NONE) {
+		return;
+	}
+	char text[144];
+	switch (result) {
+	case MULTI_DIALOGUE_TOGGLE_ENABLED:
+		snprintf(text, sizeof(text),
+				"Player %u FireRed dialogue assist: %ux, auto-next %s",
+				player + 1, dialogueSpeedTenths / MULTI_SPEED_ONE,
+				dialogueAutoAdvance ? "on" : "off");
+		break;
+	case MULTI_DIALOGUE_TOGGLE_DISABLED:
+		snprintf(text, sizeof(text),
+				"Player %u FireRed dialogue assist: off", player + 1);
+		break;
+	case MULTI_DIALOGUE_TOGGLE_UNAVAILABLE:
+		snprintf(text, sizeof(text),
+				"Player %u dialogue assist unavailable: clean FireRed USA 1.0/1.1 required",
+				player + 1);
+		break;
+	case MULTI_DIALOGUE_TOGGLE_NONE:
+	default:
+		return;
+	}
+	struct retro_message message = { text, 240 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _showIvCheckerMessage(unsigned player,
+		enum MultiIvCheckerToggleResult result) {
+	if (!environCallback || result == MULTI_IV_CHECKER_TOGGLE_NONE) {
+		return;
+	}
+	char text[144];
+	switch (result) {
+	case MULTI_IV_CHECKER_TOGGLE_SHOWN:
+		snprintf(text, sizeof(text),
+				"Player %u FireRed party IV checker: on", player + 1);
+		break;
+	case MULTI_IV_CHECKER_TOGGLE_HIDDEN:
+		snprintf(text, sizeof(text),
+				"Player %u FireRed party IV checker: off", player + 1);
+		break;
+	case MULTI_IV_CHECKER_TOGGLE_UNAVAILABLE:
+		snprintf(text, sizeof(text),
+				"Player %u IV checker unavailable: clean FireRed USA 1.0/1.1 required",
+				player + 1);
+		break;
+	case MULTI_IV_CHECKER_TOGGLE_NONE:
+	default:
+		return;
+	}
+	struct retro_message message = { text, 240 };
+	environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	_frontendLog(RETRO_LOG_INFO, "%s", text);
+}
+
+static void _drainInstanceAudio(struct MultiInstance* instance) {
+	struct mAudioBuffer* buffer = instance->core->getAudioBuffer(instance->core);
+	for (;;) {
+		size_t read = mAudioBufferRead(buffer, instance->rawAudio, AUDIO_RAW_CHUNK_FRAMES);
+		if (!read) {
+			break;
+		}
+		size_t produced = audioConverterProcess(&instance->converter, instance->rawAudio, read,
+				instance->convertedAudio);
+		if (produced) {
+			multiAudioFifoPush(&instance->audio, instance->convertedAudio, produced);
+		}
+	}
+}
+
+static void _captureOrDiscardInstanceAudio(struct MultiInstance* instance) {
+	if (instance->captureAudio) {
+		_drainInstanceAudio(instance);
+	} else {
+		/* Clearing advances no queue and is constant-time. Emulated audio remains
+		 * enabled because games can depend on its timing and registers. */
+		mAudioBufferClear(instance->core->getAudioBuffer(instance->core));
+	}
+}
+
+static void _submitAudio(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		unsigned rate = instances[i].core->audioSampleRate(instances[i].core);
+		if (rate != instances[i].converter.inputRate) {
+			_instanceAudioRateChanged(&instances[i].stream, rate);
+		}
+		_captureOrDiscardInstanceAudio(&instances[i]);
+	}
+	if (!instanceCount) {
+		return;
+	}
+
+	uint32_t frameCycles = instances[0].core->frameCycles(instances[0].core);
+	uint32_t frequency = instances[0].core->frequency(instances[0].core);
+	size_t frames = multiAudioClockNext(&audioClock, GBA_OUTPUT_RATE, frameCycles, frequency);
+	if (frames > AUDIO_OUTPUT_MAX_FRAMES) {
+		frames = AUDIO_OUTPUT_MAX_FRAMES;
+	}
+	memset(mixedAudio, 0, frames * 2 * sizeof(*mixedAudio));
+	int selected = multiAudioSelectedIndex(audioMode, instanceCount);
+	if (selected >= 0) {
+		struct MultiAudioFifo* fifo = &instances[selected].audio;
+		multiAudioFifoTrim(fifo, frames + AUDIO_FIFO_MAX_LEAD);
+		for (size_t frame = 0; frame < frames; ++frame) {
+			multiAudioFifoPop(fifo, &mixedAudio[frame * 2], &mixedAudio[frame * 2 + 1]);
+		}
+	}
+	if (audioCallback) {
+		size_t accepted = audioCallback(mixedAudio, frames);
+		if (accepted < frames) {
+			rejectedAudioFrames += frames - accepted;
+		}
+	}
+}
+
+static void _syncRtcTrailers(void) {
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		struct GBA* gba = instances[i].core->board;
+		if (!(gba->memory.hw.devices & HW_RTC)) {
+			continue;
+		}
+		GBASavedataRTCWrite(&gba->memory.savedata);
+		size_t actualOffset = GBASavedataSize(&gba->memory.savedata) & ~(size_t) 0xFF;
+		multiSaveMirrorRtc(saveData[i], SAVE_SLOT_SIZE, actualOffset,
+				SAVE_CANONICAL_RTC_OFFSET, sizeof(struct GBASavedataRTCBuffer));
+	}
+}
