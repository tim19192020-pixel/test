diff --git a/tests/libretro_audio_test.c b/tests/libretro_audio_test.c
new file mode 100644
index 0000000..0e359ba
--- /dev/null
+++ b/tests/libretro_audio_test.c
@@ -0,0 +1,250 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "libretro-audio.h"
+#include "libretro_multi_support.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+
+#define TEST_CHUNK 128
+#define SCALED_LONG_RUN_PERIODS 1024
+
+static const unsigned rates[] = { 32768, 65536, 131072, 262144 };
+
+static size_t convertFrames(struct LibretroAudioConverter* converter,
+		size_t inputFrames, struct MultiAudioFifo* fifo) {
+	int16_t input[TEST_CHUNK * 2];
+	int16_t output[TEST_CHUNK * 4];
+	memset(input, 0, sizeof(input));
+	size_t total = 0;
+	while (inputFrames) {
+		size_t chunk = inputFrames < TEST_CHUNK ? inputFrames : TEST_CHUNK;
+		size_t produced = audioConverterProcess(converter, input, chunk, output);
+		if (fifo) {
+			multiAudioFifoPush(fifo, output, produced);
+		}
+		total += produced;
+		inputFrames -= chunk;
+	}
+	return total;
+}
+
+static size_t nativeFramesPerEvent(unsigned rate) {
+	return rate / 16384;
+}
+
+static void testAllRatesAndChunkSplits(void) {
+	for (size_t r = 0; r < sizeof(rates) / sizeof(*rates); ++r) {
+		struct LibretroAudioConverter converter;
+		audioConverterReset(&converter, rates[r]);
+		size_t events = 257;
+		size_t produced = convertFrames(&converter,
+				events * nativeFramesPerEvent(rates[r]), NULL);
+		assert(produced == events * 4);
+	}
+}
+
+static void testEveryOrderedRateTransition(void) {
+	for (size_t from = 0; from < sizeof(rates) / sizeof(*rates); ++from) {
+		for (size_t to = 0; to < sizeof(rates) / sizeof(*rates); ++to) {
+			if (from == to) {
+				continue;
+			}
+			struct LibretroAudioConverter converter;
+			audioConverterReset(&converter, rates[from]);
+			size_t produced = convertFrames(&converter,
+					7 * nativeFramesPerEvent(rates[from]), NULL);
+			/* A real mAVStream callback drains before making this reset. */
+			audioConverterReset(&converter, rates[to]);
+			produced += convertFrames(&converter,
+					11 * nativeFramesPerEvent(rates[to]), NULL);
+			assert(produced == (7 + 11) * 4);
+		}
+	}
+}
+
+static void testScaledConverterResetBounds(void) {
+	for (size_t r = 0; r < sizeof(rates) / sizeof(*rates); ++r) {
+		struct LibretroAudioConverter converter;
+		audioConverterResetScaled(&converter, rates[r], 0);
+		assert(converter.inputRate == rates[r]);
+		assert(convertFrames(&converter, 10 * nativeFramesPerEvent(rates[r]), NULL) == 40);
+
+		audioConverterResetScaled(&converter, rates[r], 201);
+		assert(converter.inputRate == rates[r]);
+		assert(convertFrames(&converter, 200 * nativeFramesPerEvent(rates[r]), NULL) == 40);
+	}
+
+	struct LibretroAudioConverter converter;
+	audioConverterResetScaled(&converter, 0, 30);
+	assert(converter.mode == CONV_PASSTHROUGH);
+	assert(convertFrames(&converter, 37, NULL) == 37);
+}
+
+static void testDialogueScaledRatesLongRun(void) {
+	for (unsigned speedTenths = MULTI_DIALOGUE_MIN_TENTHS;
+			speedTenths <= MULTI_DIALOGUE_MAX_TENTHS; speedTenths += 10) {
+		for (size_t r = 0; r < sizeof(rates) / sizeof(*rates); ++r) {
+			struct LibretroAudioConverter converter;
+			struct MultiAudioFifo fifo;
+			audioConverterResetScaled(&converter, rates[r], speedTenths);
+			multiAudioFifoReset(&fifo);
+			for (unsigned period = 0; period < SCALED_LONG_RUN_PERIODS; ++period) {
+				assert(convertFrames(&converter,
+						speedTenths * nativeFramesPerEvent(rates[r]), &fifo) == 40);
+				assert(fifo.size == 40);
+				for (unsigned frame = 0; frame < 40; ++frame) {
+					int16_t left;
+					int16_t right;
+					assert(multiAudioFifoPop(&fifo, &left, &right));
+				}
+			}
+			assert(fifo.size == 0);
+			assert(fifo.dropped == 0);
+		}
+	}
+}
+
+static void testEveryScaledRateLongRun(void) {
+	/* One period contains `speedTenths` hardware events. At that boundary the
+	 * exact scaled ratio must always yield 40 frontend frames, regardless of
+	 * hardware rate or selected tenth. Repeating the period exercises phase
+	 * preservation, chunk splits, and FIFO wraparound without allowing debt. */
+	for (unsigned speedTenths = 10; speedTenths <= 40; ++speedTenths) {
+		for (size_t r = 0; r < sizeof(rates) / sizeof(*rates); ++r) {
+			struct LibretroAudioConverter converter;
+			struct MultiAudioFifo fifo;
+			audioConverterResetScaled(&converter, rates[r], speedTenths);
+			multiAudioFifoReset(&fifo);
+
+			size_t totalProduced = 0;
+			for (unsigned period = 0; period < SCALED_LONG_RUN_PERIODS; ++period) {
+				size_t produced = convertFrames(&converter,
+						speedTenths * nativeFramesPerEvent(rates[r]), &fifo);
+				assert(produced == 40);
+				totalProduced += produced;
+				assert(fifo.size == 40);
+				for (unsigned frame = 0; frame < 40; ++frame) {
+					int16_t left;
+					int16_t right;
+					assert(multiAudioFifoPop(&fifo, &left, &right));
+					assert(left == 0 && right == 0);
+				}
+				assert(fifo.size == 0);
+			}
+			assert(totalProduced == (size_t) SCALED_LONG_RUN_PERIODS * 40);
+			assert(fifo.dropped == 0);
+		}
+	}
+}
+
+static void testScaledSchedulePacing(void) {
+	/* The scheduler starts each accelerated interval with the larger step.
+	 * That one-frame prebuffer prevents fractional targets from repeatedly
+	 * underrunning while fixed-cadence frontend audio is consumed. */
+	for (unsigned speedTenths = 10; speedTenths <= 40; ++speedTenths) {
+		for (size_t r = 0; r < sizeof(rates) / sizeof(*rates); ++r) {
+			struct LibretroAudioConverter converter;
+			struct MultiAudioFifo fifo;
+			struct MultiAudioClock clock;
+			struct MultiSpeedState speed;
+			audioConverterResetScaled(&converter, rates[r], speedTenths);
+			multiAudioFifoReset(&fifo);
+			multiAudioClockReset(&clock);
+			multiSpeedInit(&speed);
+			multiSpeedSetTarget(&speed, speedTenths);
+			if (speedTenths > 10) {
+				assert(multiSpeedHandleR2(&speed, true));
+				assert(!multiSpeedHandleR2(&speed, false));
+			}
+
+			uint32_t cycleRemainder = 0;
+			size_t zeroFilled = 0;
+			size_t maximumLead = 0;
+			for (unsigned hostFrame = 0; hostFrame < 1000; ++hostFrame) {
+				unsigned steps = multiSpeedNextFrames(&speed);
+				for (unsigned step = 0; step < steps; ++step) {
+					uint32_t cycles = cycleRemainder + 280896;
+					size_t events = cycles / 1024;
+					cycleRemainder = cycles % 1024;
+					convertFrames(&converter,
+							events * nativeFramesPerEvent(rates[r]), &fifo);
+				}
+
+				size_t needed = multiAudioClockNext(&clock,
+						GBA_OUTPUT_RATE, 280896, 16777216);
+				for (size_t frame = 0; frame < needed; ++frame) {
+					int16_t left;
+					int16_t right;
+					if (!multiAudioFifoPop(&fifo, &left, &right)) {
+						++zeroFilled;
+					}
+				}
+				if (fifo.size > maximumLead) {
+					maximumLead = fifo.size;
+				}
+			}
+
+			assert(zeroFilled <= 4);
+			assert(maximumLead <= 1100);
+			assert(fifo.dropped == 0);
+		}
+	}
+}
+
+static void testTenMinuteNoDebtPacing(void) {
+	struct MultiAudioClock clock;
+	struct MultiAudioFifo fifo;
+	struct LibretroAudioConverter converter;
+	multiAudioClockReset(&clock);
+	multiAudioFifoReset(&fifo);
+	audioConverterReset(&converter, rates[0]);
+	uint32_t cycleRemainder = 0;
+	size_t maximumLead = 0;
+	size_t zeroFilled = 0;
+
+	/* Just over ten minutes at the exact GBA frame rate. */
+	for (unsigned frame = 0; frame < 35837; ++frame) {
+		unsigned rate = rates[frame % (sizeof(rates) / sizeof(*rates))];
+		if (converter.inputRate != rate) {
+			audioConverterReset(&converter, rate);
+		}
+		uint32_t cycles = cycleRemainder + 280896;
+		size_t events = cycles / 1024;
+		cycleRemainder = cycles % 1024;
+		assert(convertFrames(&converter, events * nativeFramesPerEvent(rate), &fifo) ==
+				events * 4);
+
+		size_t needed = multiAudioClockNext(&clock, 65536, 280896, 16777216);
+		multiAudioFifoTrim(&fifo, needed + 32);
+		for (size_t i = 0; i < needed; ++i) {
+			int16_t left;
+			int16_t right;
+			if (!multiAudioFifoPop(&fifo, &left, &right)) {
+				++zeroFilled;
+			}
+		}
+		if (fifo.size > maximumLead) {
+			maximumLead = fifo.size;
+		}
+	}
+	assert(maximumLead <= 4);
+	assert(zeroFilled <= 4);
+	assert(fifo.dropped == 0);
+}
+
+int main(void) {
+	testAllRatesAndChunkSplits();
+	testEveryOrderedRateTransition();
+	testScaledConverterResetBounds();
+	testEveryScaledRateLongRun();
+	testDialogueScaledRatesLongRun();
+	testScaledSchedulePacing();
+	testTenMinuteNoDebtPacing();
+	return 0;
+}
