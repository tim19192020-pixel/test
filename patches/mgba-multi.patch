+void retro_get_system_av_info(struct retro_system_av_info* info) {
+	memset(info, 0, sizeof(*info));
+	struct MultiLayout layout = { 0 };
+	unsigned count = instanceCount ? instanceCount : _requestedInstanceCount();
+	if (!multiLayoutForCount(count, &layout)) {
+		multiLayoutForCount(1, &layout);
+	}
+	info->geometry.base_width = layout.width;
+	info->geometry.base_height = layout.height;
+	info->geometry.max_width = MULTI_COMPOSITE_WIDTH;
+	info->geometry.max_height = MULTI_COMPOSITE_HEIGHT;
+	info->geometry.aspect_ratio = (float) layout.width / (float) layout.height;
+	if (instanceCount && instances[0].core) {
+		info->timing.fps = instances[0].core->frequency(instances[0].core) /
+				(double) instances[0].core->frameCycles(instances[0].core);
+	} else {
+		info->timing.fps = 16777216.0 / 280896.0;
+	}
+	info->timing.sample_rate = GBA_OUTPUT_RATE;
+}
