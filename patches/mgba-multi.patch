+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef LIBRETRO_FIRERED_IV_H
+#define LIBRETRO_FIRERED_IV_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define FIRERED_IV_PARTY_CAPACITY 6
+#define FIRERED_IV_NICKNAME_CAPACITY 11
+
+enum FireRedIvStatus {
+	FIRERED_IV_EMPTY,
+	FIRERED_IV_VALID,
+	FIRERED_IV_EGG,
+	FIRERED_IV_CORRUPT,
+};
+
+enum FireRedIvStat {
+	FIRERED_IV_HP,
+	FIRERED_IV_ATK,
+	FIRERED_IV_DEF,
+	FIRERED_IV_SPA,
+	FIRERED_IV_SPD,
+	FIRERED_IV_SPE,
+	FIRERED_IV_STAT_COUNT,
+};
+
+struct FireRedIvPokemon {
+	enum FireRedIvStatus status;
+	uint16_t species;
+	uint8_t level;
+	uint8_t ivs[FIRERED_IV_STAT_COUNT];
+	char nickname[FIRERED_IV_NICKNAME_CAPACITY];
+};
+
+struct FireRedIvParty {
+	unsigned partyCount;
+	struct FireRedIvPokemon pokemon[FIRERED_IV_PARTY_CAPACITY];
+};
+
+/* Reads a point-in-time party snapshot from borrowed FireRed EWRAM. The
+ * caller owns the exact-ROM gate: no data is inspected unless supported is
+ * true. The function never changes EWRAM and does not retain either pointer.
+ * A false result leaves every output slot empty. */
+bool fireRedIvReadParty(bool supported, const uint8_t* ewram, size_t ewramSize,
+		struct FireRedIvParty* party);
+
+#endif
