+static void testBenignTerminalIsManual(struct Fixture* fixture) {
+	setOrdinary(fixture, 0);
+	write8(fixture->rom, ROM_BASE, fixture->script + 1U, 0x29);
+	write8(fixture->rom, ROM_BASE, fixture->script + 4U, 0x02);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	assert(!fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+
+	setHiddenTerminal(fixture);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, fixture->script + 1U);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_WAIT);
+	assert(!fireRedDialogueCanAutoAdvanceTerminal(&fixture->detector));
+
+	/* The public consume operation is hardened against an accidental scheduler
+	 * call: only a fully safe terminal can be consumed synthetically. */
+	fireRedDialogueConsumeTerminal(&fixture->detector);
+	assert(fixture->detector.sessionArmed);
+	assert(fixture->detector.lastState == FIRERED_DIALOGUE_TERMINAL_WAIT);
+	fireRedDialogueReset(&fixture->detector);
+	assert(!fixture->detector.sessionArmed);
+}
+
+static void testTerminalFailClosed(struct Fixture* fixture) {
+	/* None of the three terminal shapes are accepted without an armed message. */
+	setOrdinary(fixture, 0);
+	setHiddenTerminal(fixture);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	setHiddenTerminal(fixture);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	setHiddenTerminal(fixture);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	assertBlocked(fixture);
+
+	/* A different allowlisted message cannot inherit the armed message's tail
+	 * verdict at either the hidden or final terminal stage. */
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setHiddenTerminal(fixture);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->safeWaits[0]);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setHiddenTerminal(fixture);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			fixture->profile->safeWaits[0] + 1U);
+	assertBlocked(fixture);
+
+	/* Skipping a required progression stage disarms the detector. */
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setHiddenTerminal(fixture);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT, fixture->script + 1U);
+	assertBlocked(fixture);
+
+	/* Even an otherwise verified terminal wait needs a bounded ROM pointer. */
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setHiddenTerminal(fixture);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 1);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_TERMINAL_PENDING);
+	write8(fixture->iwram, IWRAM_BASE, CONTEXT_MODE, 2);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_NATIVE,
+			fixture->profile->waitAorB | 1U);
+	write32(fixture->iwram, IWRAM_BASE, CONTEXT_SCRIPT,
+			ROM_BASE + ROM_SIZE);
+	assertBlocked(fixture);
+
+	/* A choice or battle transition appearing after arming also disarms it. */
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setTask(fixture, 1, fixture->profile->choices[1] | 1U, true);
+	assertBlocked(fixture);
+
+	setOrdinary(fixture, 0);
+	assert(fireRedDialogueInspect(&fixture->detector) ==
+			FIRERED_DIALOGUE_PRINTING);
+	setTask(fixture, 1, fixture->profile->taskBattle | 1U, true);
+	assertBlocked(fixture);
+}
+
+int main(void) {
+	testHashesAndBounds();
+	for (size_t revision = 0;
+			revision < sizeof(profiles) / sizeof(*profiles); ++revision) {
+		struct Fixture fixture;
+		initFixture(&fixture, &profiles[revision]);
+		testAllPrinterStates(&fixture);
+		testExactMsgboxWaits(&fixture);
+		testBenignContinuations(&fixture);
+		testControlFlowProof(&fixture);
+		testTailClassificationCache(&fixture);
+		testEveryOrdinaryGuard(&fixture);
+		testTerminalSequence(&fixture);
+		testBenignTerminalIsManual(&fixture);
+		testTerminalFailClosed(&fixture);
+		deinitFixture(&fixture);
+	}
+	return 0;
+}
diff --git a/tests/libretro_firered_iv_test.c b/tests/libretro_firered_iv_test.c
new file mode 100644
index 0000000..6e8f107
--- /dev/null
+++ b/tests/libretro_firered_iv_test.c
@@ -0,0 +1,305 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "libretro_firered_iv.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define EWRAM_SIZE 0x00040000U
+#define PARTY_COUNT_OFFSET 0x00024029U
+#define PARTY_OFFSET 0x00024284U
+#define PARTY_RECORD_SIZE 100U
+#define PARTY_END (PARTY_OFFSET + FIRERED_IV_PARTY_CAPACITY * PARTY_RECORD_SIZE)
+
+enum TestSubstruct {
+	TEST_GROWTH,
+	TEST_ATTACKS,
+	TEST_EVS,
+	TEST_MISC,
+};
+
+/* Physical order, deliberately represented differently from the production
+ * logical-to-physical lookup table. */
+static const uint8_t sPhysicalOrder[24][4] = {
+	{ TEST_GROWTH, TEST_ATTACKS, TEST_EVS, TEST_MISC },
+	{ TEST_GROWTH, TEST_ATTACKS, TEST_MISC, TEST_EVS },
+	{ TEST_GROWTH, TEST_EVS, TEST_ATTACKS, TEST_MISC },
+	{ TEST_GROWTH, TEST_EVS, TEST_MISC, TEST_ATTACKS },
+	{ TEST_GROWTH, TEST_MISC, TEST_ATTACKS, TEST_EVS },
+	{ TEST_GROWTH, TEST_MISC, TEST_EVS, TEST_ATTACKS },
+	{ TEST_ATTACKS, TEST_GROWTH, TEST_EVS, TEST_MISC },
+	{ TEST_ATTACKS, TEST_GROWTH, TEST_MISC, TEST_EVS },
+	{ TEST_ATTACKS, TEST_EVS, TEST_GROWTH, TEST_MISC },
+	{ TEST_ATTACKS, TEST_EVS, TEST_MISC, TEST_GROWTH },
+	{ TEST_ATTACKS, TEST_MISC, TEST_GROWTH, TEST_EVS },
+	{ TEST_ATTACKS, TEST_MISC, TEST_EVS, TEST_GROWTH },
+	{ TEST_EVS, TEST_GROWTH, TEST_ATTACKS, TEST_MISC },
+	{ TEST_EVS, TEST_GROWTH, TEST_MISC, TEST_ATTACKS },
+	{ TEST_EVS, TEST_ATTACKS, TEST_GROWTH, TEST_MISC },
+	{ TEST_EVS, TEST_ATTACKS, TEST_MISC, TEST_GROWTH },
+	{ TEST_EVS, TEST_MISC, TEST_GROWTH, TEST_ATTACKS },
+	{ TEST_EVS, TEST_MISC, TEST_ATTACKS, TEST_GROWTH },
+	{ TEST_MISC, TEST_GROWTH, TEST_ATTACKS, TEST_EVS },
+	{ TEST_MISC, TEST_GROWTH, TEST_EVS, TEST_ATTACKS },
+	{ TEST_MISC, TEST_ATTACKS, TEST_GROWTH, TEST_EVS },
+	{ TEST_MISC, TEST_ATTACKS, TEST_EVS, TEST_GROWTH },
+	{ TEST_MISC, TEST_EVS, TEST_GROWTH, TEST_ATTACKS },
+	{ TEST_MISC, TEST_EVS, TEST_ATTACKS, TEST_GROWTH },
+};
+
+static void write16(uint8_t* destination, uint16_t value) {
+	destination[0] = (uint8_t) value;
+	destination[1] = (uint8_t) (value >> 8);
+}
+
+static void write32(uint8_t* destination, uint32_t value) {
+	destination[0] = (uint8_t) value;
+	destination[1] = (uint8_t) (value >> 8);
+	destination[2] = (uint8_t) (value >> 16);
+	destination[3] = (uint8_t) (value >> 24);
+}
+
+static unsigned physicalSubstruct(unsigned permutation,
+		enum TestSubstruct logical) {
+	for (unsigned physical = 0; physical < 4; ++physical) {
+		if (sPhysicalOrder[permutation][physical] == (uint8_t) logical) {
+			return physical;
+		}
+	}
+	abort();
+}
+
+static uint32_t ivWord(bool egg) {
+	uint32_t value = UINT32_C(31) | UINT32_C(30) << 5 |
+			UINT32_C(29) << 10 | UINT32_C(28) << 15 |
+			UINT32_C(27) << 20 | UINT32_C(26) << 25;
+	if (egg) {
+		value |= UINT32_C(1) << 30;
+	}
+	return value;
+}
+
+static void makePokemon(uint8_t* record, unsigned permutation,
+		uint16_t species, uint8_t level, bool outerEgg, bool innerEgg) {
+	uint8_t plain[48] = { 0 };
+	uint32_t personality = permutation;
+	uint32_t otId = UINT32_C(0x89ABCDEF);
+	uint32_t key = personality ^ otId;
+	unsigned growth = physicalSubstruct(permutation, TEST_GROWTH);
+	unsigned misc = physicalSubstruct(permutation, TEST_MISC);
+
+	memset(record, 0, PARTY_RECORD_SIZE);
+	write32(record, personality);
+	write32(record + 4, otId);
+	/* "Ae?9" exercises accent folding, fallback, and the digit range. */
+	record[8] = 0x01;
+	record[9] = 0x1B;
+	record[10] = 0x80;
+	record[11] = 0xAA;
+	record[12] = 0xFF;
+	record[18] = 2;
+	record[19] = (uint8_t) (0x02U | (outerEgg ? 0x04U : 0U));
+	record[84] = level;
+
+	write16(plain + growth * 12U, species);
+	write32(plain + misc * 12U + 4U, ivWord(innerEgg));
+	uint16_t checksum = 0;
+	for (unsigned offset = 0; offset < sizeof(plain); offset += 2) {
+		checksum = (uint16_t) (checksum +
+				((uint16_t) plain[offset] | (uint16_t) plain[offset + 1] << 8));
+	}
+	write16(record + 28, checksum);
+	for (unsigned offset = 0; offset < sizeof(plain); offset += 4) {
+		uint32_t value = (uint32_t) plain[offset] |
+				(uint32_t) plain[offset + 1] << 8 |
+				(uint32_t) plain[offset + 2] << 16 |
+				(uint32_t) plain[offset + 3] << 24;
+		write32(record + 32 + offset, value ^ key);
+	}
+}
+
+static void assertValid(const struct FireRedIvPokemon* pokemon,
+		uint16_t species) {
+	static const uint8_t expected[] = { 31, 30, 29, 27, 26, 28 };
+	assert(pokemon->status == FIRERED_IV_VALID);
+	assert(pokemon->species == species);
+	assert(pokemon->level == 50);
+	assert(memcmp(pokemon->ivs, expected, sizeof(expected)) == 0);
+	assert(strcmp(pokemon->nickname, "Ae?9") == 0);
+}
+
+static void assertCorruptAndClear(const struct FireRedIvPokemon* pokemon) {
+	assert(pokemon->status == FIRERED_IV_CORRUPT);
+	assert(pokemon->species == 0);
+	assert(pokemon->level == 0);
+	for (unsigned i = 0; i < FIRERED_IV_STAT_COUNT; ++i) {
+		assert(pokemon->ivs[i] == 0);
+	}
+	assert(pokemon->nickname[0] == '\0');
+}
+
+static void poisonParty(struct FireRedIvParty* party) {
+	memset(party, 0xA5, sizeof(*party));
+}
+
+static void assertEmptyParty(const struct FireRedIvParty* party) {
+	assert(party->partyCount == 0);
+	for (unsigned slot = 0; slot < FIRERED_IV_PARTY_CAPACITY; ++slot) {
+		const struct FireRedIvPokemon* pokemon = &party->pokemon[slot];
+		assert(pokemon->status == FIRERED_IV_EMPTY);
+		assert(pokemon->species == 0);
+		assert(pokemon->level == 0);
+		for (unsigned stat = 0; stat < FIRERED_IV_STAT_COUNT; ++stat) {
+			assert(pokemon->ivs[stat] == 0);
+		}
+		assert(pokemon->nickname[0] == '\0');
+	}
+}
+
+static void testAllPermutations(void) {
+	uint8_t* ewram = calloc(1, EWRAM_SIZE);
+	assert(ewram);
+	struct FireRedIvParty party;
+	ewram[PARTY_COUNT_OFFSET] = 1;
+	for (unsigned permutation = 0; permutation < 24; ++permutation) {
+		makePokemon(ewram + PARTY_OFFSET, permutation, 25, 50, false, false);
+		assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+		assert(party.partyCount == 1);
+		assertValid(&party.pokemon[0], 25);
+		for (unsigned i = 1; i < FIRERED_IV_PARTY_CAPACITY; ++i) {
+			assert(party.pokemon[i].status == FIRERED_IV_EMPTY);
+		}
+	}
+	free(ewram);
+}
+
+static void testGateBoundsAndCount(void) {
+	uint8_t* allocation = calloc(1, EWRAM_SIZE + 1U);
+	assert(allocation);
+	uint8_t* ewram = allocation + 1;
+	struct FireRedIvParty party;
+
+	poisonParty(&party);
+	assert(!fireRedIvReadParty(false, ewram, EWRAM_SIZE, &party));
+	assertEmptyParty(&party);
+	poisonParty(&party);
+	assert(!fireRedIvReadParty(true, NULL, EWRAM_SIZE, &party));
+	assertEmptyParty(&party);
+	poisonParty(&party);
+	assert(!fireRedIvReadParty(true, ewram, PARTY_COUNT_OFFSET, &party));
+	assertEmptyParty(&party);
+	poisonParty(&party);
+	assert(!fireRedIvReadParty(true, ewram, PARTY_END - 1U, &party));
+	assertEmptyParty(&party);
+	assert(!fireRedIvReadParty(true, ewram, EWRAM_SIZE, NULL));
+
+	ewram[PARTY_COUNT_OFFSET] = FIRERED_IV_PARTY_CAPACITY + 1U;
+	poisonParty(&party);
+	assert(!fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assertEmptyParty(&party);
+	ewram[PARTY_COUNT_OFFSET] = 0;
+	assert(fireRedIvReadParty(true, ewram, PARTY_END, &party));
+	assert(party.partyCount == 0);
+	for (unsigned i = 0; i < FIRERED_IV_PARTY_CAPACITY; ++i) {
+		assert(party.pokemon[i].status == FIRERED_IV_EMPTY);
+	}
+	/* The deliberately one-byte-offset EWRAM base exercises all record reads,
+	 * not just the byte-sized count access. */
+	for (unsigned i = 0; i < FIRERED_IV_PARTY_CAPACITY; ++i) {
+		makePokemon(ewram + PARTY_OFFSET + i * PARTY_RECORD_SIZE,
+				i, (uint16_t) (1U + i), 50, false, false);
+	}
+	ewram[PARTY_COUNT_OFFSET] = FIRERED_IV_PARTY_CAPACITY;
+	assert(fireRedIvReadParty(true, ewram, PARTY_END, &party));
+	assert(party.partyCount == FIRERED_IV_PARTY_CAPACITY);
+	for (unsigned i = 0; i < FIRERED_IV_PARTY_CAPACITY; ++i) {
+		assertValid(&party.pokemon[i], (uint16_t) (1U + i));
+	}
+	free(allocation);
+}
+
+static void testStatusesAndNoMutation(void) {
+	uint8_t* ewram = calloc(1, EWRAM_SIZE);
+	assert(ewram);
+	struct FireRedIvParty party;
+	uint8_t before[FIRERED_IV_PARTY_CAPACITY * PARTY_RECORD_SIZE];
+	ewram[PARTY_COUNT_OFFSET] = 3;
+	makePokemon(ewram + PARTY_OFFSET, 3, 251, 50, false, false);
+	makePokemon(ewram + PARTY_OFFSET + PARTY_RECORD_SIZE,
+			10, 25, 0, true, true);
+	makePokemon(ewram + PARTY_OFFSET + PARTY_RECORD_SIZE * 2U,
+			23, 25, 50, false, false);
+	ewram[PARTY_OFFSET + PARTY_RECORD_SIZE * 2U + 32U] ^= 1U;
+	memcpy(before, ewram + PARTY_OFFSET, sizeof(before));
+
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assert(party.partyCount == 3);
+	assertValid(&party.pokemon[0], 251);
+	assert(party.pokemon[1].status == FIRERED_IV_EGG);
+	assertCorruptAndClear(&party.pokemon[2]);
+	assert(party.pokemon[3].status == FIRERED_IV_EMPTY);
+	assert(memcmp(before, ewram + PARTY_OFFSET, sizeof(before)) == 0);
+	makePokemon(ewram + PARTY_OFFSET, 0, 25, 50, false, false);
+	ewram[PARTY_OFFSET + 18U] = 1;
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assert(party.pokemon[0].status == FIRERED_IV_VALID);
+	assert(strcmp(party.pokemon[0].nickname, "????") == 0);
+	makePokemon(ewram + PARTY_OFFSET, 0, 25, 50, false, false);
+	memset(ewram + PARTY_OFFSET + 8U, 0xBB, 10U);
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assert(strcmp(party.pokemon[0].nickname, "AAAAAAAAAA") == 0);
+
+	makePokemon(ewram + PARTY_OFFSET, 4, 25, 50, true, false);
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assertCorruptAndClear(&party.pokemon[0]);
+	makePokemon(ewram + PARTY_OFFSET, 4, 25, 50, false, true);
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assertCorruptAndClear(&party.pokemon[0]);
+	makePokemon(ewram + PARTY_OFFSET, 4, 25, 50, false, false);
+	ewram[PARTY_OFFSET + 19U] |= 1U;
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assertCorruptAndClear(&party.pokemon[0]);
+	makePokemon(ewram + PARTY_OFFSET, 4, 25, 50, false, false);
+	ewram[PARTY_OFFSET + 19U] &= (uint8_t) ~0x02U;
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assert(party.pokemon[0].status == FIRERED_IV_EMPTY);
+	assert(party.pokemon[0].species == 0);
+
+	static const uint16_t invalidSpecies[] = { 0, 252, 276, 412 };
+	for (unsigned i = 0; i < sizeof(invalidSpecies) / sizeof(*invalidSpecies); ++i) {
+		makePokemon(ewram + PARTY_OFFSET, i, invalidSpecies[i], 50,
+				false, false);
+		assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+		assertCorruptAndClear(&party.pokemon[0]);
+	}
+	static const uint16_t validSpecies[] = { 1, 251, 277, 411 };
+	for (unsigned i = 0; i < sizeof(validSpecies) / sizeof(*validSpecies); ++i) {
+		makePokemon(ewram + PARTY_OFFSET, i, validSpecies[i], 50,
+				false, false);
+		assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+		assert(party.pokemon[0].status == FIRERED_IV_VALID);
+	}
+	makePokemon(ewram + PARTY_OFFSET, 0, 25, 0, false, false);
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assertCorruptAndClear(&party.pokemon[0]);
+	makePokemon(ewram + PARTY_OFFSET, 0, 25, 101, false, false);
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assertCorruptAndClear(&party.pokemon[0]);
+	makePokemon(ewram + PARTY_OFFSET, 0, 252, 0, true, true);
+	assert(fireRedIvReadParty(true, ewram, EWRAM_SIZE, &party));
+	assertCorruptAndClear(&party.pokemon[0]);
+	free(ewram);
+}
+
+int main(void) {
+	testAllPermutations();
+	testGateBoundsAndCount();
+	testStatusesAndNoMutation();
+	return 0;
+}
diff --git a/tests/libretro_iv_overlay_test.c b/tests/libretro_iv_overlay_test.c
new file mode 100644
index 0000000..55d1f2d
--- /dev/null
+++ b/tests/libretro_iv_overlay_test.c
@@ -0,0 +1,263 @@
+/* Copyright (c) 2026 mGBA contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "libretro_iv_overlay.h"
+
+#include <assert.h>
+#include <limits.h>
+#include <stdint.h>
+#include <string.h>
+
+#define TEST_WIDTH 512U
+#define TEST_HEIGHT 400U
+#define TEST_STRIDE 527U
+#define TEST_GUARD 37U
+#define TEST_PIXELS ((size_t) TEST_STRIDE * TEST_HEIGHT)
+#define TEST_STORAGE_PIXELS (TEST_GUARD + TEST_PIXELS + TEST_GUARD)
+#define SENTINEL 0x6B4DU
+
+static uint16_t storage[TEST_STORAGE_PIXELS];
+static uint16_t reference[TEST_STORAGE_PIXELS];
+
+static void fillSentinel(uint16_t* values, size_t count) {
+	for (size_t i = 0; i < count; ++i) {
+		values[i] = SENTINEL;
+	}
+}
+
+static void assertGuardsUntouched(void) {
+	for (size_t i = 0; i < TEST_GUARD; ++i) {
+		assert(storage[i] == SENTINEL);
+		assert(storage[TEST_GUARD + TEST_PIXELS + i] == SENTINEL);
+	}
+}
+
+static struct FireRedIvParty exampleParty(void) {
+	struct FireRedIvParty party;
+	memset(&party, 0, sizeof(party));
+	party.partyCount = FIRERED_IV_PARTY_CAPACITY;
+
+	party.pokemon[0].status = FIRERED_IV_VALID;
+	party.pokemon[0].species = 1;
+	party.pokemon[0].level = 5;
+	memcpy(party.pokemon[0].nickname, "BULBASAUR", sizeof("BULBASAUR"));
+	for (unsigned stat = 0; stat < FIRERED_IV_STAT_COUNT; ++stat) {
+		party.pokemon[0].ivs[stat] = (uint8_t) (31U - stat);
+	}
+
+	party.pokemon[1].status = FIRERED_IV_EMPTY;
+	party.pokemon[2].status = FIRERED_IV_EGG;
+	party.pokemon[2].level = 1;
+	for (unsigned stat = 0; stat < FIRERED_IV_STAT_COUNT; ++stat) {
+		party.pokemon[2].ivs[stat] = (uint8_t) (stat + 1U);
+	}
+	party.pokemon[3].status = FIRERED_IV_CORRUPT;
+
+	party.pokemon[4].status = FIRERED_IV_VALID;
+	party.pokemon[4].species = 386;
+	party.pokemon[4].level = 100;
+	/* An unterminated/non-ASCII nickname must remain bounded and printable. */
+	memset(party.pokemon[4].nickname, 'Z',
+			sizeof(party.pokemon[4].nickname));
+	party.pokemon[4].nickname[3] = '\1';
+	for (unsigned stat = 0; stat < FIRERED_IV_STAT_COUNT; ++stat) {
+		party.pokemon[4].ivs[stat] = (uint8_t) stat;
+	}
+
+	/* Unknown states are deliberately rendered as corrupt. */
+	party.pokemon[5].status = (enum FireRedIvStatus) 99;
+	return party;
+}
+
+static void assertOnlyPanelChanged(unsigned width, unsigned height,
+		unsigned stride, unsigned slotX, unsigned slotY) {
+	const unsigned panelLeft = slotX + 2U;
+	const unsigned panelTop = slotY + 2U;
+	const unsigned panelRight = panelLeft + 236U;
+	const unsigned panelBottom = panelTop + 156U;
+	const uint16_t* pixels = storage + TEST_GUARD;
+	for (unsigned y = 0; y < height; ++y) {
+		for (unsigned x = 0; x < stride; ++x) {
+			bool inPanel = x < width && x >= panelLeft && x < panelRight &&
+					y >= panelTop && y < panelBottom;
+			if (inPanel) {
+				assert(pixels[(size_t) y * stride + x] != SENTINEL);
+			} else {
+				assert(pixels[(size_t) y * stride + x] == SENTINEL);
+			}
+		}
+	}
+	for (size_t i = (size_t) height * stride; i < TEST_PIXELS; ++i) {
+		assert(pixels[i] == SENTINEL);
+	}
+}
+
+static void testEveryPlacement(void) {
+	static const struct {
+		unsigned width;
+		unsigned height;
+		unsigned stride;
+		unsigned x;
+		unsigned y;
+	} placements[] = {
+		{ 240U, 160U, 240U, 0U, 0U },
+		{ 480U, 160U, 480U, 0U, 0U },
+		{ 480U, 160U, 480U, 240U, 0U },
+		{ 480U, 320U, 480U, 0U, 0U },
+		{ 480U, 320U, 480U, 240U, 0U },
+		{ 480U, 320U, 480U, 120U, 160U },
+		{ TEST_WIDTH, TEST_HEIGHT, TEST_STRIDE, 37U, 29U },
+	};
+	struct FireRedIvParty party = exampleParty();
+
+	for (size_t i = 0; i < sizeof(placements) / sizeof(*placements); ++i) {
+		fillSentinel(storage, TEST_STORAGE_PIXELS);
+		assert(fireRedIvOverlayDraw(storage + TEST_GUARD,
+				(size_t) placements[i].stride * placements[i].height,
+				placements[i].stride, placements[i].width,
+				placements[i].height, placements[i].x, placements[i].y,
+				(unsigned) (i % 3U), &party));
+		assertGuardsUntouched();
+		assertOnlyPanelChanged(placements[i].width, placements[i].height,
+				placements[i].stride, placements[i].x, placements[i].y);
+	}
+}
+
+static bool rowContains(unsigned rowY, uint16_t color) {
+	const uint16_t* pixels = storage + TEST_GUARD;
+	for (unsigned y = rowY - 3U; y < rowY + 10U; ++y) {
+		for (unsigned x = 2U; x < 238U; ++x) {
+			if (pixels[(size_t) y * 240U + x] == color) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+static void testStatusesAndPlayerTitle(void) {
+	struct FireRedIvParty party = exampleParty();
+	fillSentinel(storage, TEST_STORAGE_PIXELS);
+	assert(fireRedIvOverlayDraw(storage + TEST_GUARD, 240U * 160U, 240U,
+			240U, 160U, 0U, 0U, 0U, &party));
+	assert(rowContains(39U, 0xFFFFU)); /* valid */
+	assert(rowContains(57U, 0xAD55U)); /* empty */
+	assert(rowContains(75U, 0xFFE0U)); /* egg */
+	assert(rowContains(93U, 0xF800U)); /* corrupt */
+	assert(rowContains(129U, 0xF800U)); /* unknown is corrupt */
+
+	memcpy(reference, storage, sizeof(storage));
+	party.pokemon[2].ivs[FIRERED_IV_HP] = 31U;
+	fillSentinel(storage, TEST_STORAGE_PIXELS);
+	assert(fireRedIvOverlayDraw(storage + TEST_GUARD, 240U * 160U, 240U,
+			240U, 160U, 0U, 0U, 0U, &party));
+	bool eggRowChanged = false;
+	for (unsigned y = 72U; y < 85U; ++y) {
+		for (unsigned x = 2U; x < 238U; ++x) {
+			size_t pixel = TEST_GUARD + (size_t) y * 240U + x;
+			if (storage[pixel] != reference[pixel]) {
+				eggRowChanged = true;
+			}
+		}
+	}
+	assert(eggRowChanged);
+
+	/* The logical player label is independent from physical placement. */
+	party.pokemon[2].ivs[FIRERED_IV_HP] = 1U;
+	fillSentinel(storage, TEST_STORAGE_PIXELS);
+	assert(fireRedIvOverlayDraw(storage + TEST_GUARD, 240U * 160U, 240U,
+			240U, 160U, 0U, 0U, 2U, &party));
+	bool playerGlyphChanged = false;
+	for (size_t i = 0; i < TEST_STORAGE_PIXELS; ++i) {
+		if (storage[i] == reference[i]) {
+			continue;
+		}
+		assert(i >= TEST_GUARD);
+		size_t pixel = i - TEST_GUARD;
+		unsigned y = (unsigned) (pixel / 240U);
+		unsigned x = (unsigned) (pixel % 240U);
+		assert(x >= 13U && x < 18U && y >= 7U && y < 14U);
+		playerGlyphChanged = true;
+	}
+	assert(playerGlyphChanged);
+	assertGuardsUntouched();
+}
+
+static void testPartyCountIsAuthoritative(void) {
+	struct FireRedIvParty party = exampleParty();
+	party.partyCount = 1U;
+	fillSentinel(storage, TEST_STORAGE_PIXELS);
+	assert(fireRedIvOverlayDraw(storage + TEST_GUARD, 240U * 160U, 240U,
+			240U, 160U, 0U, 0U, 0U, &party));
+	assert(rowContains(39U, 0xFFFFU));
+	for (unsigned slot = 1U; slot < FIRERED_IV_PARTY_CAPACITY; ++slot) {
+		assert(rowContains(39U + slot * 18U, 0xAD55U));
+	}
+
+	party.partyCount = FIRERED_IV_PARTY_CAPACITY + 1U;
+	fillSentinel(storage, TEST_STORAGE_PIXELS);
+	assert(fireRedIvOverlayDraw(storage + TEST_GUARD, 240U * 160U, 240U,
+			240U, 160U, 0U, 0U, 0U, &party));
+	for (unsigned slot = 0U; slot < FIRERED_IV_PARTY_CAPACITY; ++slot) {
+		assert(rowContains(39U + slot * 18U, 0xF800U));
+	}
+}
+
+static void assertRejectedWithoutWrite(uint16_t* pixels, size_t pixelCount,
+		size_t stride, unsigned width, unsigned height,
+		unsigned slotX, unsigned slotY, unsigned player,
+		const struct FireRedIvParty* party) {
+	memcpy(reference, storage, sizeof(storage));
+	assert(!fireRedIvOverlayDraw(pixels, pixelCount, stride, width, height,
+			slotX, slotY, player, party));
+	assert(memcmp(storage, reference, sizeof(storage)) == 0);
+}
+
+static void testInvalidParameters(void) {
+	struct FireRedIvParty party = exampleParty();
+	uint16_t* pixels = storage + TEST_GUARD;
+	fillSentinel(storage, TEST_STORAGE_PIXELS);
+
+	assertRejectedWithoutWrite(NULL, 240U * 160U, 240U, 240U, 160U,
+			0U, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 160U, 240U, 240U, 160U,
+			0U, 0U, 0U, NULL);
+	assertRejectedWithoutWrite(pixels, 240U * 160U, 240U, 240U, 160U,
+			0U, 0U, 3U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 160U, 240U, 240U, 160U,
+			0U, 0U, UINT_MAX, &party);
+	assertRejectedWithoutWrite(pixels, 0U, 0U, 0U, 0U,
+			0U, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 239U * 160U, 239U, 239U, 160U,
+			0U, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 159U, 240U, 240U, 159U,
+			0U, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 160U, 240U, 240U, 160U,
+			1U, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 160U, 240U, 240U, 160U,
+			0U, 1U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 160U, 240U, 240U, 160U,
+			UINT_MAX, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 160U, 240U, 240U, 160U,
+			0U, UINT_MAX, 0U, &party);
+	assertRejectedWithoutWrite(pixels, 240U * 160U - 1U, 240U,
+			240U, 160U, 0U, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, SIZE_MAX, SIZE_MAX, 240U, 160U,
+			0U, 0U, 0U, &party);
+	/* Multiplication fits, but adding the visible final-row width does not. */
+	assertRejectedWithoutWrite(pixels, SIZE_MAX, SIZE_MAX / 159U,
+			240U, 160U, 0U, 0U, 0U, &party);
+	assertRejectedWithoutWrite(pixels, TEST_PIXELS, TEST_WIDTH - 1U,
+			TEST_WIDTH, TEST_HEIGHT, 0U, 0U, 0U, &party);
+}
+
+int main(void) {
+	testEveryPlacement();
+	testStatusesAndPlayerTitle();
+	testPartyCountIsAuthoritative();
+	testInvalidParameters();
+	return 0;
+}
