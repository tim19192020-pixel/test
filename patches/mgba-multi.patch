+static void testIndependentIvCheckerStates(void) {
+	struct MultiIvCheckerState states[MULTI_MAX_INSTANCES];
+	for (unsigned player = 0; player < MULTI_MAX_INSTANCES; ++player) {
+		multiIvCheckerInit(&states[player]);
+	}
+
+	assert(multiIvCheckerHandleX(&states[0], true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_SHOWN);
+	assert(multiIvCheckerHandleX(&states[2], true, true) ==
+			MULTI_IV_CHECKER_TOGGLE_SHOWN);
+	assert(states[0].visible && !states[1].visible && states[2].visible);
+	assert(multiIvCheckerShouldRefresh(&states[0]));
+	assert(!multiIvCheckerShouldRefresh(&states[1]));
+	assert(multiIvCheckerShouldRefresh(&states[2]));
+
+	for (unsigned frame = 1; frame <= MULTI_IV_CHECKER_REFRESH_FRAMES; ++frame) {
+		bool expected = frame == MULTI_IV_CHECKER_REFRESH_FRAMES;
+		assert(multiIvCheckerShouldRefresh(&states[0]) == expected);
+		assert(!multiIvCheckerShouldRefresh(&states[1]));
+		assert(multiIvCheckerShouldRefresh(&states[2]) == expected);
+	}
+	assert(states[0].refreshCountdown == MULTI_IV_CHECKER_REFRESH_FRAMES);
+	assert(states[1].refreshCountdown == 0);
+	assert(states[2].refreshCountdown == MULTI_IV_CHECKER_REFRESH_FRAMES);
+}
