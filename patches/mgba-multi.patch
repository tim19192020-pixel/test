+	{ "mgba_multi_speed_p2", "Player 2 speed target (R2 toggle); 2.0x|1.0x|1.1x|1.2x|1.3x|1.4x|1.5x|1.6x|1.7x|1.8x|1.9x|2.1x|2.2x|2.3x|2.4x|2.5x|2.6x|2.7x|2.8x|2.9x|3.0x|3.1x|3.2x|3.3x|3.4x|3.5x|3.6x|3.7x|3.8x|3.9x|4.0x" },
