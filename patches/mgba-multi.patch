+void retro_deinit(void) {
+	_destroyContent();
+	useBitmasks = false;
+	logCallback = NULL;
+}
+
+bool retro_load_game(const struct retro_game_info* game) {
+	_destroyContent();
+	memset(saveData, 0xFF, sizeof(saveData));
+	memset(compositeBuffer, 0, sizeof(compositeBuffer));
+	_initializeRuntimeSettings();
+	if (!_copyRom(game)) {
+		_frontendLog(RETRO_LOG_ERROR, "could not copy content into immutable ROM memory");
+		return false;
+	}
+
+	instanceCount = _requestedInstanceCount();
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		if (!_initializeInstance(i)) {
+			_frontendLog(RETRO_LOG_ERROR, "could not initialize Player %u", i + 1);
+			_destroyContent();
+			return false;
+		}
+	}
+	deferredSetup = true;
+	fatalLoadError = false;
+	return true;
+}
+
+bool retro_load_game_special(unsigned gameType, const struct retro_game_info* games, size_t count) {
+	UNUSED(gameType);
+	UNUSED(games);
+	UNUSED(count);
+	return false;
+}
+
+void retro_unload_game(void) {
+	_destroyContent();
+}
+
+void retro_run(void) {
+	if (!instanceCount || fatalLoadError || !_finishDeferredSetup()) {
+		if (videoCallback) {
+			videoCallback(NULL, 0, 0, 0);
+		}
+		return;
+	}
+	bool variablesUpdated = false;
+	if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE,
+			&variablesUpdated) && variablesUpdated) {
+		_updateRuntimeSettings();
+	}
+
+	if (inputPollCallback) {
+		inputPollCallback();
+	}
+	struct MultiFrameCommand frames[MULTI_MAX_INSTANCES] = { 0 };
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		bool speedToggle = false;
+		bool dialogueToggle = false;
+		bool ivToggle = false;
+		frames[i].keys = _readKeys(i, &speedToggle, &dialogueToggle, &ivToggle);
+		bool wasDown = speedState[i].buttonDown;
+		if (multiSpeedHandleR2(&speedState[i], speedToggle)) {
+			_showSpeedMessage(i);
+		} else if (speedToggle && !wasDown &&
+					speedState[i].targetTenths == MULTI_SPEED_ONE) {
+			_showInactiveSpeedMessage(i);
+		}
+		enum MultiDialogueToggleResult dialogueResult = multiDialogueHandleL2(
+				&dialogueToggleState[i], dialogueToggle,
+				fireRedDialogueProfileSupported(
+						instances[i].dialogueDetector.profile));
+		_showDialogueMessage(i, dialogueResult);
+		enum MultiIvCheckerToggleResult ivResult = multiIvCheckerHandleX(
+				&ivCheckerState[i], ivToggle,
+				fireRedDialogueProfileSupported(
+						instances[i].dialogueDetector.profile));
+		_showIvCheckerMessage(i, ivResult);
+		frames[i].manualFrames = multiSpeedNextFrames(&speedState[i]);
+		frames[i].manualSpeedTenths = _effectiveAudioSpeed(i);
+		frames[i].dialogueSpeedTenths = dialogueSpeedTenths;
+		frames[i].dialogueEnabled = dialogueToggleState[i].enabled;
+		frames[i].dialogueAutoAdvance = dialogueAutoAdvance;
+		frames[i].ivRefreshRequested =
+				multiIvCheckerShouldRefresh(&ivCheckerState[i]);
+	}
+	_prepareAudioPipelines();
+	_executeBatch(WORKER_COMMAND_FRAME, frames);
+	_syncRtcTrailers();
+
+	struct MultiLayout layout;
+	unsigned playerAtSlot[MULTI_MAX_INSTANCES];
+	const void* sourceVideo[MULTI_MAX_INSTANCES] = {
+		instances[0].video, instances[1].video, instances[2].video,
+	};
+	if (videoCallback && multiLayoutForCount(instanceCount, &layout) &&
+			multiScreenOrderResolve(screenOrder, instanceCount, playerAtSlot) &&
+			multiComposeFrames(compositeBuffer, COMPOSITE_BUFFER_PIXELS,
+				sizeof(*compositeBuffer), sourceVideo, VIDEO_STRIDE,
+				instanceCount, &layout, playerAtSlot)) {
+		for (unsigned slot = 0; slot < instanceCount; ++slot) {
+			unsigned player = playerAtSlot[slot];
+			if (ivCheckerState[player].visible) {
+				fireRedIvOverlayDraw(compositeBuffer, COMPOSITE_BUFFER_PIXELS,
+						layout.width, layout.width, layout.height,
+						layout.placement[slot].x, layout.placement[slot].y,
+						player, &instances[player].ivParty);
+			}
+		}
+		videoCallback(compositeBuffer, layout.width, layout.height,
+				layout.width * sizeof(*compositeBuffer));
+	}
+	_submitAudio();
+}
+
+void retro_reset(void) {
+	if (!instanceCount || !_finishDeferredSetup()) {
+		return;
+	}
+	_executeBatch(WORKER_COMMAND_RESET, NULL);
+	for (unsigned i = 0; i < instanceCount; ++i) {
+		multiSpeedResetPhase(&speedState[i]);
+		memset(&instances[i].ivParty, 0, sizeof(instances[i].ivParty));
+		multiIvCheckerRequestRefresh(&ivCheckerState[i]);
+	}
+	_resetAudioPipeline(true);
+}
