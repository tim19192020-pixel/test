+void retro_init(void) {
+	enum retro_pixel_format format = RETRO_PIXEL_FORMAT_RGB565;
+	environCallback(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &format);
+	useBitmasks = environCallback(RETRO_ENVIRONMENT_GET_INPUT_BITMASKS, NULL);
+
+	static struct retro_input_descriptor descriptors[
+			MULTI_MAX_INSTANCES * ((sizeof(keymap) / sizeof(*keymap)) + 3) + 1];
+	static const char* names[] = {
+		"A", "B", "Select", "Start", "Right", "Left", "Up", "Down", "R", "L",
+	};
+	memset(descriptors, 0, sizeof(descriptors));
+	for (unsigned port = 0; port < MULTI_MAX_INSTANCES; ++port) {
+		size_t base = port * ((sizeof(keymap) / sizeof(*keymap)) + 3);
+		for (unsigned key = 0; key < sizeof(keymap) / sizeof(*keymap); ++key) {
+			struct retro_input_descriptor* descriptor = &descriptors[base + key];
+			descriptor->port = port;
+			descriptor->device = RETRO_DEVICE_JOYPAD;
+			descriptor->id = keymap[key];
+			descriptor->description = names[key];
+		}
+		struct retro_input_descriptor* speed =
+				&descriptors[base + sizeof(keymap) / sizeof(*keymap)];
+		speed->port = port;
+		speed->device = RETRO_DEVICE_JOYPAD;
+		speed->id = RETRO_DEVICE_ID_JOYPAD_R2;
+		speed->description = "Toggle Speed";
+		struct retro_input_descriptor* dialogue =
+				&descriptors[base + sizeof(keymap) / sizeof(*keymap) + 1];
+		dialogue->port = port;
+		dialogue->device = RETRO_DEVICE_JOYPAD;
+		dialogue->id = RETRO_DEVICE_ID_JOYPAD_L2;
+		dialogue->description = "Toggle FireRed Dialogue Assist";
+		struct retro_input_descriptor* ivChecker =
+				&descriptors[base + sizeof(keymap) / sizeof(*keymap) + 2];
+		ivChecker->port = port;
+		ivChecker->device = RETRO_DEVICE_JOYPAD;
+		ivChecker->id = RETRO_DEVICE_ID_JOYPAD_X;
+		ivChecker->description = "Toggle FireRed Party IV Checker";
+	}
+	environCallback(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, descriptors);
+
+	struct retro_log_callback log;
+	if (environCallback(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log)) {
+		logCallback = log.log;
+	} else {
+		logCallback = NULL;
+	}
+	silentLogger.log = _silentLog;
+	silentLogger.filter = NULL;
+	mLogSetDefaultLogger(&silentLogger);
+	memset(compositeBuffer, 0, sizeof(compositeBuffer));
+	multiAudioClockReset(&audioClock);
+	rejectedAudioFrames = 0;
+}
