+static bool _isTrainerScript(const struct FireRedDialogueProfileData* profile,
+		uint32_t scriptPointer) {
+	return scriptPointer >= profile->trainerScriptStart &&
+			scriptPointer < profile->trainerScriptEnd;
+}
+
+static bool _isSafeMsgboxWait(const struct FireRedDialogueProfileData* profile,
+		uint32_t scriptPointer) {
+	for (unsigned i = 0; i < FIRERED_SAFE_MSGBOX_COUNT; ++i) {
+		if (scriptPointer == profile->safeMsgboxWaits[i]) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool _safeStackContext(const struct FireRedDialogueDetector* detector,
+		const struct FireRedDialogueProfileData* profile,
+		uint32_t scriptPointer, uint8_t stackDepth,
+		uint32_t stack[FIRERED_CONTEXT_STACK_COUNT]) {
+	/* Depth 19 is ambiguous: FireRed's ScriptPush refuses another call but its
+	 * caller still jumps, which would make the eventual return consume a stale
+	 * stack entry. Stock scripts never approach this limit, so fail closed. */
+	if (!stack || stackDepth + 1U >= FIRERED_CONTEXT_STACK_COUNT ||
+			_isTrainerScript(profile, scriptPointer)) {
+		return false;
+	}
+	for (uint8_t i = 0; i < stackDepth; ++i) {
+		if (!_readIwram32(detector,
+				FIRERED_GLOBAL_CONTEXT + FIRERED_CONTEXT_STACK_OFFSET +
+				i * sizeof(uint32_t), &stack[i]) ||
+				_isTrainerScript(profile, stack[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool _stackEquals(const uint32_t left[FIRERED_CONTEXT_STACK_COUNT],
+		const uint32_t right[FIRERED_CONTEXT_STACK_COUNT], uint8_t stackDepth) {
+	return !memcmp(left, right, stackDepth * sizeof(*left));
+}
+
+/* Runtime byte widths from pokefirered's FRLG command handlers. A few legacy
+ * or dummied handlers do not consume the operands emitted by their assembler
+ * macros, so their runtime width is one. Trainerbattle (0x5C) is the sole
+ * variable-width command and is intentionally zero/forbidden. Control, native,
+ * menu, choice, and battle opcodes are handled before this table. */
