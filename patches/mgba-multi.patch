+	{ 0x3C, 0x40, 0x40, 0x20, 0x7C }, /* u */
+	{ 0x1C, 0x20, 0x40, 0x20, 0x1C }, /* v */
+	{ 0x3C, 0x40, 0x30, 0x40, 0x3C }, /* w */
+	{ 0x44, 0x28, 0x10, 0x28, 0x44 }, /* x */
+	{ 0x0C, 0x50, 0x50, 0x50, 0x3C }, /* y */
+	{ 0x44, 0x64, 0x54, 0x4C, 0x44 }, /* z */
+	{ 0x00, 0x08, 0x36, 0x41, 0x00 }, /* { */
+	{ 0x00, 0x00, 0x7F, 0x00, 0x00 }, /* | */
+	{ 0x00, 0x41, 0x36, 0x08, 0x00 }, /* } */
+	{ 0x08, 0x04, 0x08, 0x10, 0x08 }, /* ~ */
+	{ 0x00, 0x06, 0x09, 0x09, 0x06 }, /* DEL */
+};
+
+static void fillRect(uint16_t* pixels, size_t stride, unsigned x, unsigned y,
+		unsigned width, unsigned height, uint16_t color) {
+	for (unsigned row = 0; row < height; ++row) {
+		uint16_t* destination = pixels + ((size_t) y + row) * stride + x;
+		for (unsigned column = 0; column < width; ++column) {
+			destination[column] = color;
+		}
+	}
+}
+
+static void drawGlyph(uint16_t* pixels, size_t stride, unsigned x, unsigned y,
+		char character, uint16_t color) {
+	unsigned code = (unsigned char) character;
+	if (code < 0x20U || code > 0x7FU) {
+		code = (unsigned) '?';
+	}
+	const uint8_t* glyph = font5x7[code - 0x20U];
+	for (unsigned column = 0; column < 5; ++column) {
+		uint8_t bits = glyph[column];
+		for (unsigned row = 0; row < 7; ++row) {
+			if (bits & (1U << row)) {
+				pixels[((size_t) y + row) * stride + x + column] = color;
+			}
+		}
+	}
+}
+
+static void drawText(uint16_t* pixels, size_t stride, unsigned x, unsigned y,
+		const char* text, uint16_t color) {
+	for (unsigned i = 0; text[i] && i < LINE_CHARACTERS; ++i) {
+		drawGlyph(pixels, stride, x + i * 6U, y, text[i], color);
+	}
+}
+
+static void clearLine(char line[LINE_CHARACTERS + 1U]) {
+	memset(line, ' ', LINE_CHARACTERS);
+	line[LINE_CHARACTERS] = '\0';
+}
+
+static void putLiteral(char line[LINE_CHARACTERS + 1U], unsigned column,
+		const char* text) {
+	while (*text && column < LINE_CHARACTERS) {
+		line[column++] = *text++;
+	}
+}
+
+static void putUnsignedRight(char line[LINE_CHARACTERS + 1U], unsigned last,
+		unsigned width, unsigned value) {
+	for (unsigned digit = 0; digit < width; ++digit) {
+		line[last - digit] = (char) ('0' + value % 10U);
+		value /= 10U;
+		if (!value) {
+			break;
+		}
+	}
+}
+
+static void putNickname(char line[LINE_CHARACTERS + 1U],
+		const struct FireRedIvPokemon* pokemon) {
+	unsigned copied = 0;
+	for (; copied < 10U && copied < FIRERED_IV_NICKNAME_CAPACITY; ++copied) {
+		unsigned code = (unsigned char) pokemon->nickname[copied];
+		if (!code) {
+			break;
+		}
+		line[6U + copied] = code >= 0x20U && code <= 0x7EU
+				? (char) code : '?';
+	}
+	if (!copied) {
+		putLiteral(line, 6U, "SPECIES");
+		putUnsignedRight(line, 15U, 3U, pokemon->species);
+	}
+}
+
+static uint16_t makePartyLine(char line[LINE_CHARACTERS + 1U], unsigned slot,
+		const struct FireRedIvPokemon* pokemon) {
+	static const unsigned statColumns[FIRERED_IV_STAT_COUNT] = {
+		18U, 21U, 24U, 27U, 30U, 33U,
+	};
+	clearLine(line);
+	line[0] = (char) ('1' + slot);
+
+	switch (pokemon->status) {
+	case FIRERED_IV_EMPTY:
+		putLiteral(line, 6U, "EMPTY");
+		return RGB565_GREY;
+	case FIRERED_IV_EGG:
+		putLiteral(line, 6U, "EGG");
+		for (unsigned stat = 0; stat < FIRERED_IV_STAT_COUNT; ++stat) {
+			putUnsignedRight(line, statColumns[stat], 2U,
+					pokemon->ivs[stat]);
+		}
+		return RGB565_YELLOW;
+	case FIRERED_IV_VALID:
+		putUnsignedRight(line, 4U, 3U, pokemon->level);
+		putNickname(line, pokemon);
+		for (unsigned stat = 0; stat < FIRERED_IV_STAT_COUNT; ++stat) {
+			putUnsignedRight(line, statColumns[stat], 2U, pokemon->ivs[stat]);
+		}
+		return RGB565_WHITE;
+	case FIRERED_IV_CORRUPT:
+	default:
+		putLiteral(line, 6U, "CORRUPT");
+		return RGB565_RED;
+	}
+}
+
+static bool canvasIsValid(size_t pixelCount, size_t stride,
+		unsigned canvasWidth, unsigned canvasHeight,
+		unsigned slotX, unsigned slotY) {
+	if (!canvasWidth || !canvasHeight || stride < canvasWidth) {
+		return false;
+	}
+	if (slotX > canvasWidth ||
+			FIRERED_IV_OVERLAY_SLOT_WIDTH > canvasWidth - slotX ||
+			slotY > canvasHeight ||
+			FIRERED_IV_OVERLAY_SLOT_HEIGHT > canvasHeight - slotY) {
+		return false;
+	}
+	if ((size_t) (canvasHeight - 1U) > SIZE_MAX / stride) {
+		return false;
+	}
+	size_t lastRow = (size_t) (canvasHeight - 1U) * stride;
+	if ((size_t) canvasWidth > SIZE_MAX - lastRow) {
+		return false;
+	}
+	return lastRow + canvasWidth <= pixelCount;
+}
+
+bool fireRedIvOverlayDraw(uint16_t* pixels, size_t pixelCount, size_t stride,
+		unsigned canvasWidth, unsigned canvasHeight,
+		unsigned slotX, unsigned slotY, unsigned logicalPlayer,
+		const struct FireRedIvParty* party) {
+	if (!pixels || !party || logicalPlayer >= 3U ||
+			!canvasIsValid(pixelCount, stride, canvasWidth, canvasHeight,
+				slotX, slotY)) {
+		return false;
+	}
+
+	const unsigned panelX = slotX + PANEL_X;
+	const unsigned panelY = slotY + PANEL_Y;
+	fillRect(pixels, stride, panelX, panelY, PANEL_WIDTH, PANEL_HEIGHT,
+			RGB565_CYAN);
+	fillRect(pixels, stride, panelX + 1U, panelY + 1U,
+			PANEL_WIDTH - 2U, PANEL_HEIGHT - 2U, RGB565_PANEL);
+	fillRect(pixels, stride, panelX + 1U, panelY + 1U,
+			PANEL_WIDTH - 2U, 13U, RGB565_TITLE);
+
+	char line[LINE_CHARACTERS + 1U];
+	clearLine(line);
+	putLiteral(line, 0U, "P1 IV CHECKER        [X] CLOSE");
+	line[1] = (char) ('1' + logicalPlayer);
+	drawText(pixels, stride, slotX + TEXT_X, slotY + TITLE_Y, line,
+			RGB565_CYAN);
+
+	clearLine(line);
+	putLiteral(line, 0U, "S LVL NAME       HP AT DF SA SD SP");
+	drawText(pixels, stride, slotX + TEXT_X, slotY + HEADING_Y, line,
+			RGB565_CYAN);
+
+	static const struct FireRedIvPokemon emptyPokemon = {
+		.status = FIRERED_IV_EMPTY,
+	};
+	static const struct FireRedIvPokemon corruptPokemon = {
+		.status = FIRERED_IV_CORRUPT,
+	};
+	for (unsigned slot = 0; slot < FIRERED_IV_PARTY_CAPACITY; ++slot) {
+		unsigned rowY = slotY + FIRST_ROW_Y + slot * ROW_HEIGHT;
+		fillRect(pixels, stride, panelX + 1U, rowY - 3U,
+				PANEL_WIDTH - 2U, 13U,
+				slot & 1U ? RGB565_ROW_B : RGB565_ROW_A);
+		const struct FireRedIvPokemon* pokemon;
+		if (party->partyCount > FIRERED_IV_PARTY_CAPACITY) {
+			pokemon = &corruptPokemon;
+		} else if (slot >= party->partyCount) {
+			pokemon = &emptyPokemon;
+		} else {
+			pokemon = &party->pokemon[slot];
+		}
+		uint16_t color = makePartyLine(line, slot, pokemon);
+		drawText(pixels, stride, slotX + TEXT_X, rowY, line, color);
+	}
+
+	drawText(pixels, stride, slotX + TEXT_X, slotY + FOOTER_Y,
+			"IV RANGE 0-31", RGB565_GREY);
+	return true;
+}
