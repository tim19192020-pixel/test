+void retro_unload_game(void) {
+	_unloadAll();
+}
+
+void retro_run(void) {
+	if (!instanceCount || !inputPollCallback || !inputCallback || !videoCallback) {
+		return;
+	}
+	inputPollCallback();
+	if (deferredSetup) {
+		_setInputs(false);
+		if (!_finishDeferredSetup()) {
+			videoCallback(NULL, 0, 0, 0);
+			return;
+		}
+	}
+
+	bool updated = false;
+	if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated) && updated) {
+		_applyRuntimeSettings();
+	}
+	_setInputs(true);
+
+	struct MultiLayout layout;
+	bool validLayout = _prepareComposite(&layout);
+	unsigned frameSteps[MULTI_MAX_INSTANCES] = { 1, 1, 1 };
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		frameSteps[i] = _scheduleSpeed(i);
+	}
+
+	unsigned maxSteps = 1;
+	for (i = 0; i < instanceCount; ++i) {
+		if (frameSteps[i] > maxSteps) {
+			maxSteps = frameSteps[i];
+		}
+	}
+	unsigned step;
+	for (step = 0; step < maxSteps; ++step) {
+		for (i = 0; i < instanceCount; ++i) {
+			if (frameSteps[i] > step) {
+				instances[i].core->runFrame(instances[i].core);
+				if (validLayout && step + 1 == frameSteps[i]) {
+					_copyInstanceVideo(i, &layout);
+				}
+			}
+		}
+	}
+	if (validLayout) {
+		videoCallback(compositeBuffer, layout.width, layout.height, layout.width * sizeof(*compositeBuffer));
+	} else {
+		videoCallback(NULL, 0, 0, 0);
+	}
+	_mixAudio(frameSteps);
+	_periodicSave();
+}
+
+void retro_reset(void) {
+	if (!instanceCount) {
+		return;
+	}
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		speedPhase[i] = 0;
+		instances[i].core->reset(instances[i].core);
+	}
+}
+
+size_t retro_serialize_size(void) {
+	return instanceCount ? STATE_HEADER_SIZE + instanceCount * STATE_SLOT_SIZE : 0;
+}
+
+bool retro_serialize(void* data, size_t size) {
+	if (!instanceCount || !data || size < retro_serialize_size() || !_finishDeferredSetup()) {
+		return false;
+	}
+	uint8_t* output = data;
+	memset(output, 0, retro_serialize_size());
+	memcpy(output, "MGBAMUL1", 8);
+	STORE_32LE(MULTI_STATE_VERSION, 8, output);
+	STORE_32LE(instanceCount, 12, output);
+	STORE_32LE(0, 16, output);
+	STORE_32LE(STATE_SLOT_SIZE, 20, output);
+	bool success = true;
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		if (!_serializeCore(&instances[i], output + STATE_HEADER_SIZE + i * STATE_SLOT_SIZE)) {
+			success = false;
+			break;
+		}
+	}
+	return success;
+}
+
+bool retro_unserialize(const void* data, size_t size) {
+	if (!instanceCount || !data || size < STATE_HEADER_SIZE || !_finishDeferredSetup()) {
+		return false;
+	}
+	const uint8_t* input = data;
+	uint32_t version;
+	uint32_t count;
+	uint32_t slotSize;
+	LOAD_32LE(version, 8, input);
+	LOAD_32LE(count, 12, input);
+	LOAD_32LE(slotSize, 20, input);
+	if (memcmp(input, "MGBAMUL1", 8) != 0 || version != MULTI_STATE_VERSION || count != instanceCount || slotSize != STATE_SLOT_SIZE ||
+	    size < STATE_HEADER_SIZE + instanceCount * STATE_SLOT_SIZE) {
+		return false;
+	}
+	bool success = true;
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		if (!_unserializeCore(&instances[i], input + STATE_HEADER_SIZE + i * STATE_SLOT_SIZE)) {
+			success = false;
+			break;
+		}
+	}
+	if (success) {
+		for (i = 0; i < instanceCount; ++i) {
+			speedPhase[i] = 0;
+		}
+	}
+	return success;
+}
+
+void retro_cheat_reset(void) {
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		struct mCheatDevice* device = instances[i].core->cheatDevice(instances[i].core);
+		if (device) {
+			mCheatDeviceClear(device);
+		}
+	}
+}
+
+static void _setCheat(struct mCore* core, const char* code) {
+	struct mCheatDevice* device = core->cheatDevice(core);
+	if (!device || !code) {
+		return;
+	}
+	struct mCheatSet* cheatSet;
+	if (mCheatSetsSize(&device->cheats)) {
+		cheatSet = *mCheatSetsGetPointer(&device->cheats, 0);
+	} else {
+		cheatSet = device->createSet(device, NULL);
+		mCheatAddSet(device, cheatSet);
+	}
+	/* mGBA's parsers accept the common libretro separators after '+' is
+	 * normalized to whitespace. */
+	char* normalized = strdup(code);
+	if (normalized) {
+		char* cursor;
+		for (cursor = normalized; *cursor; ++cursor) {
+			if (*cursor == '+') {
+				*cursor = ' ';
+			}
+		}
+		mCheatAddLine(cheatSet, normalized, 0);
+		free(normalized);
+	}
+	if (cheatSet->refresh) {
+		cheatSet->refresh(cheatSet, device);
+	}
+}
+
+void retro_cheat_set(unsigned index, bool enabled, const char* code) {
+	UNUSED(index);
+	if (!enabled) {
+		return;
+	}
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		_setCheat(instances[i].core, code);
+	}
+}
+
+unsigned retro_get_region(void) {
