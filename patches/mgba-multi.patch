+	}
+	if (id == RETRO_MEMORY_RTC) {
+		return _rtcSize(&instances[0]);
+	}
+	return 0;
+}
+
+static void _mixAudio(const unsigned* frameSteps) {
+	if (!audioCallback || !instanceCount) {
+		return;
+	}
+
+	size_t available[MULTI_MAX_INSTANCES] = { 0 };
+	size_t framesToRead[MULTI_MAX_INSTANCES] = { 0 };
+	size_t outputFrames = SIZE_MAX;
+	unsigned i;
+	for (i = 0; i < instanceCount; ++i) {
+		struct MultiInstance* instance = &instances[i];
+		struct mAudioBuffer* buffer = instance->core->getAudioBuffer(instance->core);
+		available[i] = mAudioBufferAvailable(buffer);
+		size_t normalizedFrames = available[i] / frameSteps[i];
+		size_t targetFrames = normalizedFrames;
+#ifdef M_CORE_GBA
+		if (instance->core->platform(instance->core) == mPLATFORM_GBA) {
+			/* This is the same leaky average used by stock mGBA's libretro
+			 * frontend. It prevents alternating GBA sample counts from turning
+			 * into frontend frame-pacing jitter. */
+			instance->audioFramesPerRunAvg = AUDIO_MOVING_AVG_ALPHA * (float) normalizedFrames +
+			        (1.0f - AUDIO_MOVING_AVG_ALPHA) * instance->audioFramesPerRunAvg;
+			targetFrames = (size_t) instance->audioFramesPerRunAvg;
+			if (targetFrames > normalizedFrames) {
+				targetFrames = normalizedFrames;
+			}
+		}
+#endif
+		if (targetFrames < outputFrames) {
+			outputFrames = targetFrames;
+		}
+	}
+
+	if (outputFrames == SIZE_MAX || !outputFrames) {
+		/* A silent/starting instance must not let another instance accumulate
+		 * an ever-growing latency queue. Each core buffer is fixed-size, and
+		 * this tighter trim retains at most one scheduled frame of carry. */
+		for (i = 0; i < instanceCount; ++i) {
+			size_t carryLimit = instances[i].nominalAudioFrames * frameSteps[i];
+			if (available[i] > carryLimit) {
+				mAudioBufferRead(instances[i].core->getAudioBuffer(instances[i].core), NULL,
+				                 available[i] - carryLimit);
+			}
+		}
+		return;
+	}
+
+	bool allocationFailed = false;
+	for (i = 0; i < instanceCount; ++i) {
+		framesToRead[i] = outputFrames * frameSteps[i];
+		if (!_ensureAudioCapacity(&instances[i], framesToRead[i])) {
+			allocationFailed = true;
+			break;
+		}
+	}
+	if (mixedAudioCapacity < outputFrames) {
+		int16_t* audio = realloc(mixedAudio, outputFrames * 2 * sizeof(*audio));
+		if (!audio) {
+			allocationFailed = true;
+		} else {
+			mixedAudio = audio;
+			mixedAudioCapacity = outputFrames;
+		}
+	}
+	if (allocationFailed) {
+		for (i = 0; i < instanceCount; ++i) {
+			mAudioBufferClear(instances[i].core->getAudioBuffer(instances[i].core));
+		}
+		return;
+	}
+
+	for (i = 0; i < instanceCount; ++i) {
+		struct mAudioBuffer* buffer = instances[i].core->getAudioBuffer(instances[i].core);
+		size_t carryLimit = instances[i].nominalAudioFrames * frameSteps[i];
+		size_t maxBuffered = framesToRead[i] + carryLimit;
+		if (available[i] > maxBuffered) {
+			mAudioBufferRead(buffer, NULL, available[i] - maxBuffered);
+		}
+		mAudioBufferRead(buffer, instances[i].audio, framesToRead[i]);
+	}
+
+	bool needsResampling = false;
+	for (i = 0; i < instanceCount; ++i) {
+		if (frameSteps[i] != 1) {
+			needsResampling = true;
+			break;
+		}
+	}
+	if (!needsResampling) {
+		if (audioSource > 0 && audioSource <= instanceCount) {
+			memcpy(mixedAudio, instances[audioSource - 1].audio,
+			       outputFrames * 2 * sizeof(*mixedAudio));
+		} else {
+			size_t sample;
+			for (sample = 0; sample < outputFrames * 2; ++sample) {
+				int32_t value = 0;
+				for (i = 0; i < instanceCount; ++i) {
+					value += instances[i].audio[sample];
+				}
+				mixedAudio[sample] = (int16_t) (value / (int32_t) instanceCount);
+			}
+		}
+		audioCallback(mixedAudio, outputFrames);
+		return;
+	}
+
+	size_t frame;
+	if (audioSource > 0 && audioSource <= instanceCount) {
+		unsigned player = audioSource - 1;
+		size_t sourceFrame = 0;
+		for (frame = 0; frame < outputFrames; ++frame) {
+			mixedAudio[frame * 2] = instances[player].audio[sourceFrame * 2];
+			mixedAudio[frame * 2 + 1] = instances[player].audio[sourceFrame * 2 + 1];
+			sourceFrame += frameSteps[player];
+		}
+	} else {
+		size_t sourceFrame[MULTI_MAX_INSTANCES] = { 0 };
+		for (frame = 0; frame < outputFrames; ++frame) {
+			int32_t left = 0;
+			int32_t right = 0;
+			for (i = 0; i < instanceCount; ++i) {
+				left += instances[i].audio[sourceFrame[i] * 2];
+				right += instances[i].audio[sourceFrame[i] * 2 + 1];
+				sourceFrame[i] += frameSteps[i];
+			}
+			mixedAudio[frame * 2] = (int16_t) (left / (int32_t) instanceCount);
+			mixedAudio[frame * 2 + 1] = (int16_t) (right / (int32_t) instanceCount);
+		}
+	}
+	audioCallback(mixedAudio, outputFrames);
+}
+
+static void _periodicSave(void) {
+	if (++autosaveCounter < AUTOSAVE_INTERVAL_FRAMES) {
+		return;
+	}
+	autosaveCounter = 0;
+	unsigned i;
+	for (i = 1; i < instanceCount; ++i) {
+		_writeOwnedSave(&instances[i]);
+	}
+}
+
+static bool _serializeCore(struct MultiInstance* instance, uint8_t* slot) {
+	struct VFile* state = VFileMemChunk(NULL, 0);
+	if (!state) {
+		return false;
+	}
+	bool success = mCoreSaveStateNamed(instance->core, state, SAVESTATE_SAVEDATA | SAVESTATE_RTC);
+	ssize_t stateSize = state->size(state);
+	if (!success || stateSize < 0 || (uint64_t) stateSize > STATE_SLOT_PAYLOAD) {
+		state->close(state);
+		return false;
+	}
+	memset(slot, 0, STATE_SLOT_SIZE);
+	STORE_64LE((uint64_t) stateSize, 0, slot);
+	state->seek(state, 0, SEEK_SET);
+	success = state->read(state, slot + sizeof(uint64_t), stateSize) == stateSize;
+	state->close(state);
+	return success;
+}
+
+static bool _unserializeCore(struct MultiInstance* instance, const uint8_t* slot) {
+	uint64_t stateSize;
+	LOAD_64LE(stateSize, 0, slot);
+	if (!stateSize || stateSize > STATE_SLOT_PAYLOAD) {
+		return false;
+	}
+	struct VFile* state = VFileFromConstMemory(slot + sizeof(uint64_t), (size_t) stateSize);
+	if (!state) {
+		return false;
+	}
+	bool success = mCoreLoadStateNamed(instance->core, state, SAVESTATE_RTC);
+	state->close(state);
+	return success;
+}
